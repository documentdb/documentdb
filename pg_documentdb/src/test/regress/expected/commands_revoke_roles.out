WHERE role_name = 'revokeTargetRole';
    role_name     |                                          role_bson                                          
------------------+---------------------------------------------------------------------------------------------
 revokeTargetRole | { "createRole" : "revokeTargetRole", "roles" : [  ], "privileges" : [  ], "$db" : "admin" }
