------------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 revokeTargetRole | { "createRole" : "revokeTargetRole", "roles" : [ { "role" : "clusterAdmin", "db" : "admin" }, { "role" : "readWriteAnyDatabase", "db" : "admin" } ], "privileges" : [  ], "$db" : "admin" }
(1 row)

