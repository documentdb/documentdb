 revokeLegacyNoDbRole     | { "createRole" : "revokeLegacyNoDbRole", "roles" : [  ], "privileges" : [  ] }
 revokeLegacyNonAdminRole | { "createRole" : "revokeLegacyNonAdminRole", "roles" : [  ], "privileges" : [  ], "$db" : "nonAdminDatabase" }
