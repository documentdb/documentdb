-- multi:false selects a single locked candidate; the collation reaches the
-- candidate filter.
SELECT documentdb_test_helpers.run_explain_and_trim($cmd$
EXPLAIN (COSTS OFF, VERBOSE ON)
SELECT document FROM bson_aggregation_update(
  'coll_q_runtime_explain_db',
  '{ "update": "coll_update_explain", "updates": [ { "q": { "a": "CaT" }, "u": { "$set": { "b": 1 } }, "multi": false, "collation": { "locale": "en", "strength": 1 } } ] }')
$cmd$);
                                                                run_explain_and_trim                                                                
----------------------------------------------------------------------------------------------------------------------------------------------------
 Aggregate
   Output: bson_build_document('n'::text, count(*), 'nModified'::text, '0'::bigint, 'ok'::text, '1'::double precision)
   CTE base
     ->  Limit
           Output: documents_8904.ctid, documents_8904.object_id, documents_8904.document, documents_8904.tableoid, documents_8904.ctid
           ->  LockRows
                 Output: documents_8904.ctid, documents_8904.object_id, documents_8904.document, documents_8904.tableoid, documents_8904.ctid
                 ->  Custom Scan (DocumentDBApiExplainQueryScan)
                       Output: documents_8904.ctid, documents_8904.object_id, documents_8904.document, documents_8904.tableoid, documents_8904.ctid
                       namespaceName: coll_q_runtime_explain_db.coll_update_explain
