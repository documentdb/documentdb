   Output: bson_distinct_agg((bson_distinct_unwind(collection.document, 'n.a'::text, 'en-u-ks-level1'::text)))
   ->  Unique
         Output: (bson_distinct_unwind(collection.document, 'n.a'::text, 'en-u-ks-level1'::text))
         ->  Sort
               Output: (bson_distinct_unwind(collection.document, 'n.a'::text, 'en-u-ks-level1'::text))
               Sort Key: (bson_distinct_unwind(collection.document, 'n.a'::text, 'en-u-ks-level1'::text)) USING <<<
               ->  ProjectSet
                     Output: bson_distinct_unwind(collection.document, 'n.a'::text, 'en-u-ks-level1'::text)
                     ->  Custom Scan (DocumentDBApiExplainQueryScan)
                           Output: collection.document
                           namespaceName: coll_q_runtime_explain_db.coll_distinct
                           indexName: _id_
                           ->  Bitmap Heap Scan on documentdb_data.documents_8903 collection
                                 Output: collection.document
                                 Recheck Cond: (collection.shard_key_value = '8903'::bigint)
                                 Filter: (collection.document @*= '{ "a" : [ "CAFE", "TEA" ], "collation" : "en-u-ks-level1" }'::bson)
                                 ->  Bitmap Index Scan on _id_
                                       Index Cond: (collection.shard_key_value = '8903'::bigint)
