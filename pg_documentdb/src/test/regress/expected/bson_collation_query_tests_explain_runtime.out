SELECT documentdb_test_helpers.run_explain_and_trim($cmd$
EXPLAIN (COSTS OFF, VERBOSE ON)
SELECT document FROM bson_aggregation_distinct(
  'coll_q_runtime_explain_db',
  '{ "distinct": "coll_distinct", "key": "a", "collation": { "locale": "en", "strength": 1 } }')
$cmd$);
                                               run_explain_and_trim                                               
------------------------------------------------------------------------------------------------------------------
 Aggregate
   Output: bson_distinct_agg((bson_distinct_unwind(collection.document, 'a'::text, 'en-u-ks-level1'::text)))
   ->  Unique
         Output: (bson_distinct_unwind(collection.document, 'a'::text, 'en-u-ks-level1'::text))
         ->  Sort
               Output: (bson_distinct_unwind(collection.document, 'a'::text, 'en-u-ks-level1'::text))
               Sort Key: (bson_distinct_unwind(collection.document, 'a'::text, 'en-u-ks-level1'::text)) USING <<<
               ->  ProjectSet
                     Output: bson_distinct_unwind(collection.document, 'a'::text, 'en-u-ks-level1'::text)
                     ->  Custom Scan (DocumentDBApiExplainQueryScan)
                           Output: collection.document
                           namespaceName: coll_q_runtime_explain_db.coll_distinct
                           indexName: _id_
                           ->  Bitmap Heap Scan on documentdb_data.documents_8903 collection
                                 Output: collection.document
                                 Recheck Cond: (collection.shard_key_value = '8903'::bigint)
                                 ->  Bitmap Index Scan on _id_
                                       Index Cond: (collection.shard_key_value = '8903'::bigint)
(18 rows)

