-- multi:true carries the normalized collation into the selection filter that
-- picks the matched documents. The update expression itself keeps binary
-- semantics, so update_bson_document receives no collation argument.
SELECT documentdb_test_helpers.run_explain_and_trim($cmd$
EXPLAIN (COSTS OFF, VERBOSE ON)
SELECT document FROM bson_aggregation_update(
  'coll_q_runtime_explain_db',
  '{ "update": "coll_update_explain", "updates": [ { "q": { "a": "CaT" }, "u": { "$set": { "b": 1 } }, "multi": true, "collation": { "locale": "en", "strength": 1 } } ] }')
$cmd$);
                                                                                                                                                             run_explain_and_trim                                                                                                                                                              
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Aggregate
   Output: bson_build_document('n'::text, count(*), 'nModified'::text, sum(u.updated), 'ok'::text, '1'::double precision)
   CTE u
     ->  Update on documentdb_data.documents_8904
           Output: documentdb_api_internal.bson_update_returned_value(documents_8904.shard_key_value)
           ->  Custom Scan (DocumentDBApiExplainQueryScan)
                 Output: COALESCE(documentdb_api_internal.update_bson_document(documents_8904.document, '{ "" : { "$set" : { "b" : { "$numberInt" : "1" } } } }'::bson, '{ "a" : "CaT" }'::bson, NULL::bson, '{ "now" : NOW_SYS_VARIABLE }'::bson, NULL::text), documents_8904.document), documents_8904.ctid
                 namespaceName: coll_q_runtime_explain_db.coll_update_explain
                 indexName: _id_
                 ->  Bitmap Heap Scan on documentdb_data.documents_8904
                       Output: documents_8904.document, documents_8904.ctid
                       Recheck Cond: (documents_8904.shard_key_value = '8904'::bigint)
                       Filter: (documents_8904.document @= '{ "a" : "CaT", "collation" : "en-u-ks-level1" }'::bson)
                       ->  Bitmap Index Scan on _id_
                             Index Cond: (documents_8904.shard_key_value = '8904'::bigint)
   ->  CTE Scan on u
         Output: u.updated
(17 rows)

