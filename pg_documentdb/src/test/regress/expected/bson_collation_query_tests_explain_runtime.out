-- find with collation on equality predicate
SELECT documentdb_test_helpers.run_explain_and_trim($cmd$ EXPLAIN (COSTS OFF) SELECT document FROM bson_aggregation_find('coll_q_runtime_explain_db', '{ "find": "coll_simple", "filter": { "a": "CAT" }, "sort": { "_id": 1 }, "collation": { "locale": "en", "strength": 1 } }') $cmd$);
                                                                run_explain_and_trim                                                                
----------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Sort Key: (documentdb_api_internal.bson_orderby_index(document, '{ "_id" : { "$numberInt" : "1" } }'::bson, 'en-u-ks-level1'::text)) NULLS FIRST
   ->  Custom Scan (DocumentDBApiExplainQueryScan)
         namespaceName: coll_q_runtime_explain_db.coll_simple
         indexName: _id_
         ->  Bitmap Heap Scan on documents_8901 collection
               Recheck Cond: (shard_key_value = '8901'::bigint)
               Filter: (document @= '{ "a" : "CAT", "collation" : "en-u-ks-level1" }'::bson)
               ->  Bitmap Index Scan on _id_
                     Index Cond: (shard_key_value = '8901'::bigint)
(10 rows)

