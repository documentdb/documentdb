  'coll_q_runtime_explain_db',
  '{ "distinct": "coll_distinct", "key": "n.a", "query": { "a": { "$in": [ "CAFE", "TEA" ] } }, "collation": { "locale": "en", "strength": 1 } }')
$cmd$);
                                                         run_explain_and_trim                                                          
