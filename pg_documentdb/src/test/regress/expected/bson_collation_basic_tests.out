-- Delete treats null and empty documents as omission.
BEGIN;
SELECT documentdb_api.delete('collation_basic_db', '{ "delete": "coll_null_empty", "deletes": [ { "q": { "s": "a" }, "limit": 0, "collation": null } ] }');
                                         delete                                         
----------------------------------------------------------------------------------------
