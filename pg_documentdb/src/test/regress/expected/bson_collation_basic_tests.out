ROLLBACK;
BEGIN;
SELECT documentdb_api.delete('collation_basic_db', '{ "delete": "coll_null_empty", "deletes": [ { "q": { "s": "a" }, "limit": 0, "collation": {} } ] }');
                                         delete                                         
----------------------------------------------------------------------------------------
 ("{ ""n"" : { ""$numberInt"" : ""1"" }, ""ok"" : { ""$numberDouble"" : ""1.0"" } }",t)
