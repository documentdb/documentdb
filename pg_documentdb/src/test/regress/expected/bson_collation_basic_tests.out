SELECT document FROM bson_aggregation_pipeline('collation_basic_db', '{ "aggregate": "coll_null_empty", "pipeline": [ { "$match": { "s": "a" } }, { "$sort": { "_id": 1 } } ], "cursor": {}, "collation": null }');
                   document                    
-----------------------------------------------
 { "_id" : { "$numberInt" : "2" }, "s" : "a" }
(1 row)

