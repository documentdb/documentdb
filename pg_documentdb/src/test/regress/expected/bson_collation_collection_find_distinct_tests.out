-- An omitted or empty command collation inherits the collection default.
SELECT document FROM bson_aggregation_find(
    'collation_find_db',
    '{ "find": "default_match", "filter": { "value": "cafe" }, "sort": { "_id": 1 } }');
                       document                       
------------------------------------------------------
