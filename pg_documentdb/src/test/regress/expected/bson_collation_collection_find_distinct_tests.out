SELECT documentdb_test_helpers.run_explain_and_trim($cmd$
EXPLAIN (COSTS OFF)
SELECT document FROM bson_aggregation_find(
    'collation_find_db',
    '{ "find": "default_match", "filter": { "value": "cafe" }, "sort": { "_id": 1 } }')
$cmd$);
                                                                run_explain_and_trim                                                                
----------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Sort Key: (documentdb_api_internal.bson_orderby_index(document, '{ "_id" : { "$numberInt" : "1" } }'::bson, 'fr-u-ks-level1'::text)) NULLS FIRST
   ->  Custom Scan (DocumentDBApiExplainQueryScan)
         namespaceName: collation_find_db.default_match
         indexName: _id_
         ->  Bitmap Heap Scan on documents_782201 collection
               Recheck Cond: (shard_key_value = '782201'::bigint)
               Filter: (document @= '{ "value" : "cafe", "collation" : "fr-u-ks-level1" }'::bson)
               ->  Bitmap Index Scan on _id_
                     Index Cond: (shard_key_value = '782201'::bigint)
