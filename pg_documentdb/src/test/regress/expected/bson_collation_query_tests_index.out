  "filter": { "a": {"$lte": "two"} },
  "projection": {
    "sortedArray": { "$sortArray": { "input": "$b", "sortBy": 1 } }
  },
  "collation": { "locale": "en", "numericOrdering" : false },
  "limit": 5
}');
                              document                              
--------------------------------------------------------------------
 { "_id" : { "$numberInt" : "1" }, "sortedArray" : [ "1", "10" ] }
 { "_id" : { "$numberInt" : "2" }, "sortedArray" : [ "020", "2" ] }
(2 rows)

