 { "_id" : { "$numberInt" : "2" }, "a" : "dog", "newField" : false }
 { "_id" : { "$numberInt" : "3" }, "a" : "cAt", "newField" : true }
 { "_id" : { "$numberInt" : "4" }, "a" : "dOg", "newField" : false }
 { "_id" : "bat", "a" : "bat", "newField" : false }
(5 rows)

