  '{ "a": ["10", "2"] }'::bson, '{ "result": { "$max": "$a" } }'::bson, false, '{}'::bson, 'en-u-kn-true');
                bson_expression_get                
---------------------------------------------------
 { "result" : "10", "collation" : "en-u-kn-true" }
(1 row)

