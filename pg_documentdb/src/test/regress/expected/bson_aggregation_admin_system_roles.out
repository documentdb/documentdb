-- Filter into the inherited roles array that $replaceRoot assembles.
SELECT document
FROM documentdb_api_catalog.bson_aggregation_find(
	'admin',
	'{ "find": "system.roles", "filter": { "roles.role": "readAnyDatabase" }, "sort": { "role": 1 } }');
