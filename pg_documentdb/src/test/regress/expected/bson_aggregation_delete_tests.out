DO $$
BEGIN
	FOR document_id IN 3..102 LOOP
		PERFORM documentdb_api.insert_one(
			'db',
			'aggregation_delete',
			format('{ "_id": %s, "a": 2, "b": 0 }', document_id)::documentdb_core.bson,
			NULL);
	END LOOP;
END;
$$;
