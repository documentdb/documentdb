    '{"aggregate":"unwind_eq_coll","pipeline":[{"$match":{"tag":{"$eq":1}}},{"$sort":{"_id":1}},{"$unwind":"$items"}],"cursor":{"batchSize":1}}',
    4294967294) AS fp
CROSS JOIN LATERAL pg_temp.drain_unwind_eq_cursor(fp.cursorPage, fp.continuation, fp.persistConnection) AS drained;
-- Repeat every stage with statistics enabled against the same planning controls.
SELECT statement FROM cursor_stage_statements ORDER BY stage, mode, ordinal
\gexec
SET documentdb.enableDynamicCursors TO 'off';
SET cursor_tuple_fraction TO '0.1';
SELECT 'facet' AS stage, 'dynamic_off' AS mode;
 stage |    mode     
-------+-------------
 facet | dynamic_off
(1 row)


SELECT line
FROM documentdb_test_helpers.run_explain_and_trim('EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF) SELECT document FROM bson_aggregation_pipeline(''dyncurdb'', ''{"cursor": {"batchSize": 1}, "pipeline": [{"$match": {"tag": {"$eq": 1}}}, {"$sort": {"_id": 1}}, {"$facet": {"rows": [{"$project": {"_id": 1, "items": "$tag"}}]}}, {"$unwind": "$rows"}, {"$replaceWith": "$rows"}], "aggregate": "unwind_eq_coll"}'');', p_normalize_window := true) AS plan(line)
WHERE line !~ '^[[:space:]]+Storage: ';

                                                              line                                                               
---------------------------------------------------------------------------------------------------------------------------------
 Subquery Scan on agg_stage_4 (actual rows=100 loops=1)
   ->  ProjectSet (actual rows=100 loops=1)
         ->  Aggregate (actual rows=1 loops=1)
               ->  Aggregate (actual rows=1 loops=1)
                     ->  Sort (actual rows=100 loops=1)
                           Sort Key: (bson_orderby(collection.document, '{ "_id" : { "$numberInt" : "1" } }'::bson)) NULLS FIRST
                           Sort Method: quicksort  Memory: xxxkB
                           ->  Bitmap Heap Scan on documents_2608 collection (actual rows=100 loops=1)
                                 Recheck Cond: (document @= '{ "tag" : { "$numberInt" : "1" } }'::bson)
                                 Heap Blocks: exact=100
                                 ->  Bitmap Index Scan on tag_1 (actual rows=100 loops=1)
                                       Index Cond: (document @= '{ "tag" : { "$numberInt" : "1" } }'::bson)
(12 rows)


SELECT drained.persistent, cardinality(drained.ids) AS rows,
       ARRAY(SELECT id FROM unnest(drained.ids) AS ids(id) ORDER BY id) =
           ARRAY(SELECT id FROM (
               SELECT i AS id FROM generate_series(1, 10000) AS documents(i) WHERE i % 100 = 1
               UNION ALL SELECT NULL::integer WHERE NULL::integer IS NOT NULL
           ) AS expected ORDER BY id) AS correct_ids,
       drained.items = array_fill(1, ARRAY[100 + 0]) AS correct_items
FROM documentdb_api.aggregate_cursor_first_page('dyncurdb', '{"cursor": {"batchSize": 1}, "pipeline": [{"$match": {"tag": {"$eq": 1}}}, {"$sort": {"_id": 1}}, {"$facet": {"rows": [{"$project": {"_id": 1, "items": "$tag"}}]}}, {"$unwind": "$rows"}, {"$replaceWith": "$rows"}], "aggregate": "unwind_eq_coll"}', 4294967294) AS fp
CROSS JOIN LATERAL pg_temp.drain_unwind_eq_cursor(fp.cursorPage, fp.continuation, fp.persistConnection) AS drained;

