(1 row)

-- 1e: EXPLAIN plans for btree pushdown
EXPLAIN (COSTS OFF) SELECT document FROM bson_aggregation_find('id_push_db', '{ "find": "test_coll", "filter": { "_id": 3 } }');
                                                    QUERY PLAN                                                    
------------------------------------------------------------------------------------------------------------------
 Index Scan using _id_ on documents_25860001 collection
   Index Cond: ((shard_key_value = '25860001'::bigint) AND (object_id = '{ "" : { "$numberInt" : "3" } }'::bson))
(2 rows)

EXPLAIN (COSTS OFF) SELECT document FROM bson_aggregation_find('id_push_db', '{ "find": "test_coll", "filter": { "_id": { "$gt": 3 } } }');
                                                                                      QUERY PLAN                                                                                       
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Index Scan using _id_ on documents_25860001 collection
   Index Cond: ((shard_key_value = '25860001'::bigint) AND (object_id > '{ "" : { "$numberInt" : "3" } }'::bson) AND (object_id <= '{ "" : { "$numberDouble" : "Infinity" } }'::bson))
(2 rows)

EXPLAIN (COSTS OFF) SELECT document FROM bson_aggregation_find('id_push_db', '{ "find": "test_coll", "filter": { "_id": { "$gte": 3, "$lt": 5 } } }');
                                                                                                                                                       QUERY PLAN                                                                                                                                                       
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Index Scan using _id_ on documents_25860001 collection
   Index Cond: ((shard_key_value = '25860001'::bigint) AND (object_id >= '{ "" : { "$numberInt" : "3" } }'::bson) AND (object_id <= '{ "" : { "$numberDouble" : "Infinity" } }'::bson) AND (object_id < '{ "" : { "$numberInt" : "5" } }'::bson) AND (object_id >= '{ "" : { "$numberDouble" : "-Infinity" } }'::bson))
(2 rows)

EXPLAIN (COSTS OFF) SELECT document FROM bson_aggregation_find('id_push_db', '{ "find": "test_coll", "filter": { "_id": { "$in": [1, 3, 5] } } }');
                                                                                                   QUERY PLAN                                                                                                    
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Index Scan using _id_ on documents_25860001 collection
   Index Cond: ((shard_key_value = '25860001'::bigint) AND (object_id = ANY (ARRAY['{ "" : { "$numberInt" : "1" } }'::bson, '{ "" : { "$numberInt" : "3" } }'::bson, '{ "" : { "$numberInt" : "5" } }'::bson])))
(2 rows)

EXPLAIN (COSTS OFF) SELECT document FROM bson_aggregation_find('id_push_db', '{ "find": "test_coll", "filter": { "_id": { "$regex": "^ab" } } }');
                                                               QUERY PLAN                                                                
-----------------------------------------------------------------------------------------------------------------------------------------
 Index Scan using _id_ on documents_25860001 collection
   Index Cond: ((shard_key_value = '25860001'::bigint) AND (object_id >= '{ "" : "ab" }'::bson) AND (object_id < '{ "" : "ac" }'::bson))
   Filter: (document @~ '{ "_id" : { "$regularExpression" : { "pattern" : "^ab", "options" : "" } } }'::bson)
(3 rows)

------------------------------------------------------------
-- Section 2: Bitmap scan fallback
------------------------------------------------------------
BEGIN;
SET LOCAL enable_indexscan TO off;
EXPLAIN (COSTS OFF) SELECT document FROM bson_aggregation_find('id_push_db', '{ "find": "test_coll", "filter": { "_id": 3 } }');
                                                    QUERY PLAN                                                    
------------------------------------------------------------------------------------------------------------------
 Index Scan using _id_ on documents_25860001 collection
   Index Cond: ((shard_key_value = '25860001'::bigint) AND (object_id = '{ "" : { "$numberInt" : "3" } }'::bson))
(2 rows)

EXPLAIN (COSTS OFF) SELECT document FROM bson_aggregation_find('id_push_db', '{ "find": "test_coll", "filter": { "_id": { "$gt": 3, "$lt": 5 } } }');
                                                                                                                                                         QUERY PLAN                                                                                                                                                          
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Bitmap Heap Scan on documents_25860001 collection
   Recheck Cond: (shard_key_value = '25860001'::bigint)
   Filter: ((document @> '{ "_id" : { "$numberInt" : "3" } }'::bson) AND (document @< '{ "_id" : { "$numberInt" : "5" } }'::bson))
   ->  Bitmap Index Scan on _id_
         Index Cond: ((shard_key_value = '25860001'::bigint) AND (object_id > '{ "" : { "$numberInt" : "3" } }'::bson) AND (object_id <= '{ "" : { "$numberDouble" : "Infinity" } }'::bson) AND (object_id < '{ "" : { "$numberInt" : "5" } }'::bson) AND (object_id >= '{ "" : { "$numberDouble" : "-Infinity" } }'::bson))
(5 rows)

-- Correctness under bitmap
SELECT document FROM bson_aggregation_find('id_push_db', '{ "find": "test_coll", "filter": { "_id": 3 } }');
                                   document                                   
------------------------------------------------------------------------------
 { "_id" : { "$numberInt" : "3" }, "a" : { "$numberInt" : "30" }, "b" : "z" }
(1 row)

SELECT document FROM bson_aggregation_find('id_push_db', '{ "find": "test_coll", "filter": { "_id": { "$gt": 3, "$lt": 5 } } }');
                                   document                                   
------------------------------------------------------------------------------
 { "_id" : { "$numberInt" : "4" }, "a" : { "$numberInt" : "40" }, "b" : "w" }
(1 row)

COMMIT;
