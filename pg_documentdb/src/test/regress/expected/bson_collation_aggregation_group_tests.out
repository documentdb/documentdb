-- Legacy accumulator paths cannot evaluate collation-sensitive expressions.
SET documentdb.enableNewWithExprAccumulators TO off;
SELECT document FROM bson_aggregation_pipeline('db',
    '{ "aggregate": "group_collation_test", "pipeline": [
        { "$group": { "_id": null, "acc": { "$avg": "$value" } } }
    ], "collation": { "locale": "en", "strength": 1 } }');
ERROR:  collation is not supported with the $avg accumulator in $group yet.
SELECT document FROM bson_aggregation_pipeline('db',
    '{ "aggregate": "group_collation_test", "pipeline": [
        { "$group": { "_id": null, "acc": { "$sum": "$value" } } }
    ], "collation": { "locale": "en", "strength": 1 } }');
ERROR:  collation is not supported with the $sum accumulator in $group yet.
SELECT document FROM bson_aggregation_pipeline('db',
    '{ "aggregate": "group_collation_test", "pipeline": [
        { "$group": { "_id": null, "acc": { "$first": "$value" } } }
    ], "collation": { "locale": "en", "strength": 1 } }');
ERROR:  collation is not supported with the $first accumulator in $group yet.
SELECT document FROM bson_aggregation_pipeline('db',
    '{ "aggregate": "group_collation_test", "pipeline": [
        { "$group": { "_id": null, "acc": { "$last": "$value" } } }
    ], "collation": { "locale": "en", "strength": 1 } }');
ERROR:  collation is not supported with the $last accumulator in $group yet.
RESET documentdb.enableNewWithExprAccumulators;
-- After a $sort, $first and $last use the sorted accumulator, which sorts the
-- values itself byte by byte and cannot honor the collation.
SELECT document FROM bson_aggregation_pipeline('db',
    '{ "aggregate": "group_collation_test", "pipeline": [
        { "$sort": { "_id": 1 } },
        { "$group": { "_id": "$category", "acc": { "$first": "$category" } } }
    ], "collation": { "locale": "en", "strength": 1 } }');
ERROR:  collation is not supported with the $first accumulator in $group yet.
SELECT document FROM bson_aggregation_pipeline('db',
    '{ "aggregate": "group_collation_test", "pipeline": [
        { "$sort": { "_id": 1 } },
        { "$group": { "_id": "$category", "acc": { "$last": "$category" } } }
    ], "collation": { "locale": "en", "strength": 1 } }');
ERROR:  collation is not supported with the $last accumulator in $group yet.
-- Without that $sort they keep working.
SELECT document FROM bson_aggregation_pipeline('db',
    '{ "aggregate": "group_collation_test", "pipeline": [
        { "$group": { "_id": "$category", "f": { "$first": "$value" }, "l": { "$last": "$value" } } },
        { "$sort": { "_id": 1 } }
    ], "collation": { "locale": "en", "strength": 1 } }');
                                    document                                     
---------------------------------------------------------------------------------
 { "_id" : "Cat", "f" : { "$numberInt" : "10" }, "l" : { "$numberInt" : "30" } }
 { "_id" : "Dog", "f" : { "$numberInt" : "40" }, "l" : { "$numberInt" : "60" } }
(2 rows)

-- With no collation requested, nothing changes.
SELECT document FROM bson_aggregation_pipeline('db',
    '{ "aggregate": "group_collation_test", "pipeline": [
        { "$group": {
            "_id": null,
            "categories": { "$addToSet": "$category" },
            "values": { "$push": "$value" }
        } }
    ] }');
                                                                                                                      document                                                                                                                      
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 { "_id" : null, "categories" : [ "Cat", "cat", "CAT", "Dog", "dog", "DOG" ], "values" : [ { "$numberInt" : "10" }, { "$numberInt" : "20" }, { "$numberInt" : "30" }, { "$numberInt" : "40" }, { "$numberInt" : "50" }, { "$numberInt" : "60" } ] }
(1 row)

-- Case-sensitive control: strength 3 keeps all case variants separate.
SELECT document FROM bson_aggregation_pipeline('db',
    '{ "aggregate": "group_collation_test", "pipeline": [
        { "$group": {
            "_id": "$category",
            "firstId": { "$min": "$_id" },
            "maxValue": { "$max": "$value" }
        } },
        { "$sort": { "firstId": 1 } }
    ], "collation": { "locale": "en", "strength": 3 } }');
                                          document                                           
---------------------------------------------------------------------------------------------
 { "_id" : "Cat", "firstId" : { "$numberInt" : "1" }, "maxValue" : { "$numberInt" : "10" } }
 { "_id" : "cat", "firstId" : { "$numberInt" : "2" }, "maxValue" : { "$numberInt" : "20" } }
 { "_id" : "CAT", "firstId" : { "$numberInt" : "3" }, "maxValue" : { "$numberInt" : "30" } }
 { "_id" : "Dog", "firstId" : { "$numberInt" : "4" }, "maxValue" : { "$numberInt" : "40" } }
 { "_id" : "dog", "firstId" : { "$numberInt" : "5" }, "maxValue" : { "$numberInt" : "50" } }
 { "_id" : "DOG", "firstId" : { "$numberInt" : "6" }, "maxValue" : { "$numberInt" : "60" } }
(6 rows)

-- skipFailOnCollation lets a caller keep the old behavior: no error, and the
-- accumulator answers with a byte by byte comparison.
SET documentdb.skipFailOnCollation TO on;
SELECT document FROM bson_aggregation_pipeline('db',
    '{ "aggregate": "group_collation_test", "pipeline": [
        { "$group": { "_id": null, "acc": { "$addToSet": "$category" } } }
    ], "collation": { "locale": "en", "strength": 1 } }');
                                document                                
------------------------------------------------------------------------
 { "_id" : null, "acc" : [ "Cat", "cat", "CAT", "Dog", "dog", "DOG" ] }
(1 row)

RESET documentdb.skipFailOnCollation;
SELECT documentdb_api.drop_collection('db', 'group_collation_test');
 drop_collection 
-----------------
 t
(1 row)

RESET documentdb.enableNewWithExprAccumulators;
RESET documentdb_core.enableCollation;
