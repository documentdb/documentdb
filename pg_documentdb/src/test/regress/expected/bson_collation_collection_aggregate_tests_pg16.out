-- $expr predicates inside $match use the inherited collation.
SELECT document FROM bson_aggregation_pipeline(
    'collation_aggregate_db',
    '{ "aggregate": "source", "pipeline": [
        { "$match": { "$expr": { "$eq": ["$category", "CAFE"] } } },
        { "$sort": { "_id": 1 } },
        { "$project": { "_id": 1, "category": 1 } }
    ] }');
                        document                         
---------------------------------------------------------
 { "_id" : { "$numberInt" : "1" }, "category" : "cafe" }
 { "_id" : { "$numberInt" : "2" }, "category" : "café" }
 { "_id" : { "$numberInt" : "3" }, "category" : "CAFE" }
(3 rows)

-- The inherited numeric ordering is used by $sort.
SELECT document FROM bson_aggregation_pipeline(
    'collation_aggregate_db',
    '{ "aggregate": "source", "pipeline": [
        { "$sort": { "rank": 1 } },
        { "$project": { "_id": 1, "rank": 1 } }
    ] }');
                     document                      
---------------------------------------------------
 { "_id" : { "$numberInt" : "3" }, "rank" : "1" }
 { "_id" : { "$numberInt" : "2" }, "rank" : "2" }
 { "_id" : { "$numberInt" : "1" }, "rank" : "10" }
 { "_id" : { "$numberInt" : "4" }, "rank" : "20" }
(4 rows)

-- Group key equality uses the inherited collation.
SELECT document FROM bson_aggregation_pipeline(
    'collation_aggregate_db',
    '{ "aggregate": "source", "pipeline": [
        { "$group": {
            "_id": "$category",
            "firstId": { "$min": "$_id" },
            "count": { "$sum": 1 }
        } },
        { "$project": {
            "_id": 0,
            "firstId": 1,
            "count": 1
        } },
        { "$sort": { "firstId": 1 } }
    ] }');
                                 document                                 
--------------------------------------------------------------------------
 { "firstId" : { "$numberInt" : "1" }, "count" : { "$numberInt" : "3" } }
 { "firstId" : { "$numberInt" : "4" }, "count" : { "$numberInt" : "1" } }
(2 rows)

-- String group accumulators use the inherited numeric ordering.
SELECT document FROM bson_aggregation_pipeline(
    'collation_aggregate_db',
    '{ "aggregate": "source", "pipeline": [
        { "$sort": { "_id": 1 } },
        { "$group": {
            "_id": null,
            "minimum": { "$min": "$rank" },
            "maximum": { "$max": "$rank" }
        } }
    ] }');
                      document                       
-----------------------------------------------------
 { "_id" : null, "minimum" : "1", "maximum" : "20" }
(1 row)

-- Expression comparisons, array search, set equality, ordering, and min/max
-- share the inherited effective collation.
SELECT document FROM bson_aggregation_pipeline(
    'collation_aggregate_db',
    '{ "aggregate": "source", "pipeline": [
        { "$match": { "_id": 1 } },
        { "$project": {
            "_id": 0,
            "eq": { "$eq": ["$category", "CAFE"] },
            "cmp": { "$cmp": ["$category", "CAFE"] },
            "index": { "$indexOfArray": ["$tags", "cafe"] },
            "setEquals": { "$setEquals": ["$tags", ["cafe"]] },
            "sorted": { "$sortArray": { "input": ["10", "2", "1"], "sortBy": 1 } },
            "minimum": { "$min": "$vals" },
            "maximum": { "$max": "$vals" }
        } }
    ] }');
                                                                                    document                                                                                     
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 { "eq" : true, "cmp" : { "$numberInt" : "0" }, "index" : { "$numberInt" : "0" }, "setEquals" : true, "sorted" : [ "1", "2", "10" ], "minimum" : "apple", "maximum" : "Banana" }
(1 row)

-- Projection-family stages use the inherited collation in expressions.
SELECT document FROM bson_aggregation_pipeline(
    'collation_aggregate_db',
    '{ "aggregate": "source", "pipeline": [
        { "$match": { "_id": 1 } },
        { "$addFields": {
            "addFieldsEqual": { "$eq": ["$category", "CAFE"] }
        } },
        { "$set": {
            "setEqual": { "$eq": ["$category", "CAFÉ"] }
        } },
        { "$project": {
            "_id": 1,
            "addFieldsEqual": 1,
            "setEqual": 1
        } }
    ] }');
                                    document                                    
--------------------------------------------------------------------------------
 { "_id" : { "$numberInt" : "1" }, "addFieldsEqual" : true, "setEqual" : true }
(1 row)

SELECT document FROM bson_aggregation_pipeline(
    'collation_aggregate_db',
    '{ "aggregate": "source", "pipeline": [
        { "$match": { "_id": 1 } },
        { "$replaceRoot": {
            "newRoot": {
                "sourceId": "$_id",
                "equal": { "$eq": ["$category", "CAFE"] }
            }
        } }
    ] }');
                        document                         
---------------------------------------------------------
 { "sourceId" : { "$numberInt" : "1" }, "equal" : true }
(1 row)

SELECT document FROM bson_aggregation_pipeline(
    'collation_aggregate_db',
    '{ "aggregate": "source", "pipeline": [
        { "$match": { "_id": 1 } },
        { "$replaceWith": {
            "sourceId": "$_id",
            "equal": { "$eq": ["$category", "CAFÉ"] }
        } }
    ] }');
                        document                         
---------------------------------------------------------
 { "sourceId" : { "$numberInt" : "1" }, "equal" : true }
(1 row)

-- $redact decisions use the inherited collation.
SELECT document FROM bson_aggregation_pipeline(
    'collation_aggregate_db',
    '{ "aggregate": "source", "pipeline": [
        { "$match": { "category": "cafe" } },
        { "$redact": {
            "$cond": {
                "if": { "$eq": ["$category", "CAFE"] },
                "then": "$$KEEP",
                "else": "$$PRUNE"
            }
        } },
        { "$sort": { "_id": 1 } },
        { "$project": { "_id": 1, "category": 1 } }
    ] }');
                        document                         
---------------------------------------------------------
 { "_id" : { "$numberInt" : "1" }, "category" : "cafe" }
 { "_id" : { "$numberInt" : "2" }, "category" : "café" }
 { "_id" : { "$numberInt" : "3" }, "category" : "CAFE" }
(3 rows)

-- Collation remains effective across $unwind and into the following $match.
SELECT document FROM bson_aggregation_pipeline(
    'collation_aggregate_db',
    '{ "aggregate": "source", "pipeline": [
        { "$unwind": "$tags" },
        { "$match": { "tags": "cafe" } },
        { "$sort": { "_id": 1 } },
        { "$project": { "_id": 1, "tags": 1 } }
    ] }');
                      document                       
-----------------------------------------------------
 { "_id" : { "$numberInt" : "1" }, "tags" : "CAFE" }
 { "_id" : { "$numberInt" : "2" }, "tags" : "CAFÉ" }
(2 rows)

-- A terminal $count observes the inherited match result.
SELECT document FROM bson_aggregation_pipeline(
    'collation_aggregate_db',
    '{ "aggregate": "source", "pipeline": [
        { "$match": { "category": "cafe" } },
        { "$count": "matchingCategories" }
    ] }');
                     document                      
---------------------------------------------------
 { "matchingCategories" : { "$numberInt" : "3" } }
(1 row)

-- Accumulators that cannot honor a collation retain their existing rejection.
SELECT document FROM bson_aggregation_pipeline(
    'collation_aggregate_db',
    '{ "aggregate": "source", "pipeline": [
        { "$group": { "_id": null, "categories": { "$addToSet": "$category" } } }
    ] }');
