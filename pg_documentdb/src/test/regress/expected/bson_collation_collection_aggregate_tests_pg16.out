                { "$match": { "key": "cafe" } },
                { "$count": "count" }
            ],
            "ordered": [
                { "$sort": { "rank": 1 } },
                { "$project": { "_id": 1, "rank": 1 } }
            ],
            "nestedLookup": [
                { "$match": { "_id": 1 } },
                { "$lookup": {
                    "from": "lookup_target",
                    "let": {
                        "sourceKey": "$key",
                        "wantedState": "active"
                    },
                    "pipeline": [
                        { "$match": {
                            "$expr": {
                                "$and": [
                                    { "$eq": ["$key", "$$sourceKey"] },
                                    { "$eq": ["$state", "$$wantedState"] }
                                ]
                            }
                        } }
                    ],
                    "as": "matches"
                } },
                { "$project": {
                    "_id": 0,
                    "matchCount": { "$size": "$matches" }
                } }
            ]
        } }
    ] }');
