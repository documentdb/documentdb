-- A missing collection has no metadata to inherit.
SELECT document FROM bson_aggregation_pipeline(
    'collation_aggregate_db',
    '{ "aggregate": "missing", "pipeline": [
        { "$match": { "value": "cafe" } }
    ] }');
 document 
