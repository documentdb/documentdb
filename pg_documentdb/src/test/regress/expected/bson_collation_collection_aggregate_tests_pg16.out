(0 rows)

-- Collectionless aggregate commands do not inherit collection metadata.
SELECT document FROM bson_aggregation_pipeline(
    'collation_aggregate_db',
    '{ "aggregate": 1, "pipeline": [
        { "$documents": [
            { "_id": 1, "value": "cafe" },
            { "_id": 2, "value": "CAFE" }
        ] },
        { "$match": { "value": "cafe" } }
    ] }');
                 documents_aggregate                  
------------------------------------------------------
 { "_id" : { "$numberInt" : "1" }, "value" : "cafe" }
(1 row)

