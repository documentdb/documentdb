SELECT collection_id AS all_ast_plain_id FROM documentdb_api_catalog.collections
WHERE database_name = 'update_all_ast' AND collection_name = 'plain' \gset
SELECT collection_id AS all_ast_described_id FROM documentdb_api_catalog.collections
WHERE database_name = 'update_all_ast' AND collection_name = 'described' \gset
PREPARE update_all_worker(bigint, bson) AS
SELECT documentdb_api_internal.update_worker($1, $1, 0, $2, NULL::bsonsequence, NULL::text)
FROM documentdb_api.collection('update_all_ast', 'plain');
PREPARE update_all_described_worker(bigint, bson) AS
SELECT documentdb_api_internal.update_worker($1, $1, 0, $2, NULL::bsonsequence, NULL::text)
FROM documentdb_api.collection('update_all_ast', 'described');
BEGIN;
SET LOCAL documentdb.enable_update_query_ast TO OFF;
SET LOCAL documentdb.enable_update_many_worker_pushdown TO ON;
EXECUTE update_all_worker(:all_ast_plain_id, '{"updateMany":{"query":{"group":"x"},"update":{"$set":{"worker":true}}}}');
