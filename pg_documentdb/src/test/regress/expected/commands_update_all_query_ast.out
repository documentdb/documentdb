SET documentdb.enable_support_function_id_pushdown TO OFF;
SET documentdb.enable_update_query_ast TO OFF;
DO $$
BEGIN
    IF (SELECT count(*) FROM update_all_results) <> 5 * (SELECT count(*) FROM update_all_cases)
       OR EXISTS (
           SELECT 1 FROM update_all_results a JOIN update_all_results b USING (seq)
           WHERE a.pass = 'legacy' AND b.pass <> 'legacy' AND
                 ROW(a.result, a.success, a.error, a.documents) IS DISTINCT FROM
                 ROW(b.result, b.success, b.error, b.documents)
       ) THEN
        RAISE EXCEPTION 'Native update-all response or document parity failed';
    END IF;
END;
$$;
SELECT c.label,
       ROW(a.result, a.success, a.error, a.documents) IS NOT DISTINCT FROM
       ROW(b.result, b.success, b.error, b.documents) AS native_equal,
       ROW(a.result, a.success, a.error, a.documents) IS NOT DISTINCT FROM
       ROW(d.result, d.success, d.error, d.documents) AS disabled_again_equal
FROM update_all_cases c
JOIN update_all_results a ON a.seq = c.seq AND a.pass = 'legacy'
JOIN update_all_results b ON b.seq = c.seq AND b.pass = 'native'
JOIN update_all_results d ON d.seq = c.seq AND d.pass = 'legacy_again'
ORDER BY c.seq;
                label                 | native_equal | disabled_again_equal 
--------------------------------------+--------------+----------------------
 empty predicate                      | t            | t
 no-op                                | t            | t
 zero matches                         | t            | t
 mixed ID residual match              | t            | t
 mixed ID residual rejection          | t            | t
 ID range                             | t            | t
 protected ID equality                | t            | t
 protected ID eq operator             | t            | t
 protected repeated ID                | t            | t
 array filters                        | t            | t
 let and normalized now               | t            | t
 collated match and positional update | t            | t
 collated update expression           | t            | t
 collated array filters and modifier  | t            | t
 strict valid                         | t            | t
 strict invalid rolls back all rows   | t            | t
 strict bypass                        | t            | t
 strict zero matches                  | t            | t
 moderate valid to invalid            | t            | t
 moderate invalid to invalid          | t            | t
 description validation let collation | t            | t
 description validation rejects       | t            | t
 batch write visibility               | t            | t
 partially unchanged matches          | t            | t
 ID membership with residual          | t            | t
 disjunctive ID filters               | t            | t
 element match before transformation  | t            | t
 comment-only predicate               | t            | t
 contradictory ID filters             | t            | t
(29 rows)

SELECT b.pass, count(*) AS cases,
       bool_and(ROW(a.result, a.success, a.error, a.documents) IS NOT DISTINCT FROM
                ROW(b.result, b.success, b.error, b.documents)) AS exact_parity
FROM update_all_results a JOIN update_all_results b USING (seq)
WHERE a.pass = 'legacy' AND b.pass IN ('legacy_id_pushdown', 'native_id_pushdown')
GROUP BY b.pass ORDER BY b.pass;
        pass        | cases | exact_parity 
--------------------+-------+--------------
 legacy_id_pushdown |    29 | t
 native_id_pushdown |    29 | t
(2 rows)

