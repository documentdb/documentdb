CREATE TEMP TABLE update_all_cases (
    seq int PRIMARY KEY, label text, target text, command bson,
    matched int, modified int, fails bool DEFAULT false
);
INSERT INTO update_all_cases VALUES
 (1, 'empty predicate', 'plain', '{"update":"plain","updates":[{"q":{},"u":{"$inc":{"value":1}},"multi":true}]}', 3, 3, false),
 (2, 'no-op', 'plain', '{"update":"plain","updates":[{"q":{"group":"x"},"u":{"$set":{"group":"x"}},"multi":true}]}', 2, 0, false),
 (3, 'zero matches', 'plain', '{"update":"plain","updates":[{"q":{"group":"missing"},"u":{"$inc":{"value":1}},"multi":true}]}', 0, 0, false),
 (4, 'mixed ID residual match', 'plain', '{"update":"plain","updates":[{"q":{"_id":1,"group":"x"},"u":{"$inc":{"value":1}},"multi":true}]}', 1, 1, false),
 (5, 'mixed ID residual rejection', 'plain', '{"update":"plain","updates":[{"q":{"_id":1,"group":"missing"},"u":{"$inc":{"value":1}},"multi":true}]}', 0, 0, false),
 (6, 'ID range', 'plain', '{"update":"plain","updates":[{"q":{"_id":{"$gte":2}},"u":{"$inc":{"value":1}},"multi":true}]}', 2, 2, false),
 (7, 'protected ID equality', 'plain', '{"update":"plain","updates":[{"q":{"_id":1},"u":{"$inc":{"value":1}},"multi":true}]}', 1, 1, false),
 (8, 'protected ID eq operator', 'plain', '{"update":"plain","updates":[{"q":{"_id":{"$eq":1}},"u":{"$inc":{"value":1}},"multi":true}]}', 1, 1, false),
 (9, 'protected repeated ID', 'plain', '{"update":"plain","updates":[{"q":{"$and":[{"_id":1},{"_id":1}]},"u":{"$inc":{"value":1}},"multi":true}]}', 1, 1, false),
 (10, 'array filters', 'plain', '{"update":"plain","updates":[{"q":{"group":"x"},"u":{"$inc":{"items.$[item].qty":10}},"arrayFilters":[{"item.qty":{"$lt":3}}],"multi":true}]}', 2, 2, false),
 (11, 'let and normalized now', 'plain', '{"update":"plain","let":{"wanted":{"$literal":"x"},"increment":2},"updates":[{"q":{"$expr":{"$eq":["$group","$$wanted"]}},"u":[{"$set":{"value":{"$add":["$value","$$increment"]},"stamp":"$$NOW"}},{"$set":{"same_now":{"$eq":["$stamp","$$NOW"]}}},{"$unset":"stamp"}],"multi":true}]}', 2, 2, false),
 (12, 'collated match and positional update', 'plain', '{"update":"plain","updates":[{"q":{"label":"CAT","items.label":"CAT"},"u":{"$inc":{"items.$.qty":10}},"multi":true,"collation":{"locale":"en","strength":2}}]}', 2, 2, false),
 (13, 'collated update expression', 'plain', '{"update":"plain","updates":[{"q":{"label":"CAT"},"u":[{"$set":{"equal":{"$eq":["$label","CAT"]}}}],"multi":true,"collation":{"locale":"en","strength":2}}]}', 2, 2, false),
 (14, 'collated array filters and modifier', 'plain', '{"update":"plain","updates":[{"q":{"label":"CAT"},"u":{"$set":{"items.$[item].seen":true},"$addToSet":{"tags":"CAT"}},"arrayFilters":[{"item.label":"CAT"}],"multi":true,"collation":{"locale":"en","strength":2}}]}', 2, 2, false),
 (15, 'strict valid', 'strict', '{"update":"strict","updates":[{"q":{"group":"x"},"u":{"$inc":{"value":1}},"multi":true}]}', 2, 2, false),
 (16, 'strict invalid rolls back all rows', 'strict', '{"update":"strict","updates":[{"q":{"group":"x"},"u":[{"$set":{"value":{"$cond":[{"$eq":["$_id",2]},"invalid",11]}}}],"multi":true}]}', NULL, NULL, true),
 (17, 'strict bypass', 'strict', '{"update":"strict","bypassDocumentValidation":true,"updates":[{"q":{"group":"x"},"u":{"$set":{"value":"bypassed"}},"multi":true}]}', 2, 2, false),
 (18, 'strict zero matches', 'strict', '{"update":"strict","updates":[{"q":{"_id":1,"group":"missing"},"u":{"$set":{"value":"invalid"}},"multi":true}]}', 0, 0, false),
 (19, 'moderate valid to invalid', 'moderate', '{"update":"moderate","updates":[{"q":{"group":"x"},"u":{"$set":{"value":"invalid"}},"multi":true}]}', NULL, NULL, true),
 (20, 'moderate invalid to invalid', 'moderate', '{"update":"moderate","updates":[{"q":{"group":"y"},"u":{"$set":{"value":"still invalid"}},"multi":true}]}', 1, 1, false),
 (21, 'description validation let collation', 'described', '{"update":"described","let":{"increment":2},"updates":[{"q":{"_id":1,"label":"CAT"},"u":[{"$set":{"value":{"$add":["$value","$$increment"]},"equal":{"$eq":["$label","CAT"]}}}],"multi":true,"collation":{"locale":"en","strength":2}}]}', 1, 1, false),
 (22, 'description validation rejects', 'described', '{"update":"described","updates":[{"q":{"_id":1,"group":"x"},"u":{"$set":{"value":"invalid"}},"multi":true}]}', NULL, NULL, true),
 (23, 'batch write visibility', 'plain', '{"update":"plain","updates":[{"q":{"group":"x"},"u":{"$set":{"visible":true}},"multi":true},{"q":{"visible":true},"u":{"$inc":{"value":1}},"multi":true},{"q":{"visible":true},"u":{"$set":{"visible":true}},"multi":true}]}', 6, 4, false),
 (24, 'partially unchanged matches', 'plain', '{"update":"plain","updates":[{"q":{"group":"x"},"u":{"$set":{"value":10}},"multi":true}]}', 2, 1, false),
