(1 row)

-- ===========================================================================
-- SECTION A: $project computing a field + $match on the computed field.
-- With enable_subquery_pushdown_for_match_on_persisted_cursors=on, the second $match
-- must trigger a subquery boundary (projection runs before the filter) even
-- though dynamic cursors are disabled.
-- ===========================================================================
-- ---------------------------------------------------------------------------
-- Test A1: Result correctness with the persisted pushdown GUC on
-- ---------------------------------------------------------------------------
SET documentdb.enable_subquery_pushdown_for_match_on_persisted_cursors TO on;
SELECT document FROM bson_aggregation_pipeline('pcsub_pushdown_db',
    '{ "aggregate": "flights", "pipeline": [
        { "$match": { "routeId": 1 } },
        { "$project": {
            "_id": 1,
            "routeId": 1,
            "legCount": { "$size": "$legs" }
        }},
        { "$match": { "legCount": { "$gt": 0 } } },
        { "$sort": { "_id": 1 } }
    ], "cursor": {} }');
                                                   document                                                   
--------------------------------------------------------------------------------------------------------------
 { "_id" : { "$numberInt" : "5" }, "routeId" : { "$numberInt" : "1" }, "legCount" : { "$numberInt" : "2" } }
 { "_id" : { "$numberInt" : "10" }, "routeId" : { "$numberInt" : "1" }, "legCount" : { "$numberInt" : "2" } }
 { "_id" : { "$numberInt" : "15" }, "routeId" : { "$numberInt" : "1" }, "legCount" : { "$numberInt" : "2" } }
 { "_id" : { "$numberInt" : "20" }, "routeId" : { "$numberInt" : "1" }, "legCount" : { "$numberInt" : "2" } }
(4 rows)

-- ---------------------------------------------------------------------------
-- Test A2: EXPLAIN — verify a Subquery Scan boundary appears in the plan.
-- ---------------------------------------------------------------------------
SELECT documentdb_test_helpers.run_explain_and_trim($cmd$
EXPLAIN (VERBOSE ON, COSTS OFF) SELECT document FROM bson_aggregation_pipeline('pcsub_pushdown_db',
    '{ "aggregate": "flights", "pipeline": [
        { "$match": { "routeId": 1 } },
        { "$project": {
            "_id": 1,
            "routeId": 1,
            "legCount": { "$size": "$legs" }
        }},
        { "$match": { "legCount": { "$gt": 0 } } },
        { "$sort": { "_id": 1 } }
    ], "cursor": {} }');
$cmd$);
                                                                                                                   run_explain_and_trim                                                                                                                    
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: agg_stage_2.document, (bson_orderby(agg_stage_2.document, '{ "_id" : { "$numberInt" : "1" } }'::bson))
   Sort Key: (bson_orderby(agg_stage_2.document, '{ "_id" : { "$numberInt" : "1" } }'::bson)) NULLS FIRST
   ->  Subquery Scan on agg_stage_2
         Output: agg_stage_2.document, bson_orderby(agg_stage_2.document, '{ "_id" : { "$numberInt" : "1" } }'::bson)
         Filter: (agg_stage_2.document #> '{ "legCount" : { "$numberInt" : "0" } }'::bsonquery)
         ->  Index Scan using "idx_routeId" on documentdb_data.documents_25860101 collection
               Output: bson_dollar_project(collection.document, '{ "_id" : { "$numberInt" : "1" }, "routeId" : { "$numberInt" : "1" }, "legCount" : { "$size" : "$legs" } }'::bson, '{ "now" : NOW_SYS_VARIABLE }'::bson)
               Index Cond: (collection.document @= '{ "routeId" : { "$numberInt" : "1" } }'::bson)
(9 rows)

