-- ===========================================================================
-- SECTION E: A collation-sensitive match on a projected string retains the
-- command collation through the subquery boundary and persisted cursor pages.
-- routeId:1 matches four documents whose carrier values differ only by case.
-- ===========================================================================
SET documentdb_core.enableCollation TO on;
SELECT documentdb_test_helpers.run_explain_and_trim($cmd$
EXPLAIN (VERBOSE ON, COSTS OFF) SELECT document FROM bson_aggregation_pipeline('pcsub_pushdown_db',
    '{ "aggregate": "flights", "pipeline": [
        { "$match": { "routeId": 1 } },
        { "$project": {
            "_id": 1,
            "carrierName": "$carrier"
        }},
        { "$match": { "carrierName": "ALPHA" } },
        { "$sort": { "_id": 1 } }
    ], "cursor": {},
       "collation": { "locale": "en", "strength": 1 } }');
$cmd$);
                                                                                                         run_explain_and_trim                                                                                                          
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: agg_stage_2.document, (bson_orderby_index(agg_stage_2.document, '{ "_id" : { "$numberInt" : "1" } }'::bson, 'en-u-ks-level1'::text))
   Sort Key: (bson_orderby_index(agg_stage_2.document, '{ "_id" : { "$numberInt" : "1" } }'::bson, 'en-u-ks-level1'::text)) NULLS FIRST
   ->  Subquery Scan on agg_stage_2
         Output: agg_stage_2.document, bson_orderby_index(agg_stage_2.document, '{ "_id" : { "$numberInt" : "1" } }'::bson, 'en-u-ks-level1'::text)
         Filter: (agg_stage_2.document #= '{ "carrierName" : "ALPHA", "collation" : "en-u-ks-level1" }'::bsonquery)
         ->  Index Scan using _id_ on documentdb_data.documents_25860101 collection
               Output: bson_dollar_project(collection.document, '{ "_id" : { "$numberInt" : "1" }, "carrierName" : "$carrier" }'::bson, '{ "now" : NOW_SYS_VARIABLE }'::bson, 'en-u-ks-level1'::text)
               Index Cond: (collection.shard_key_value = '25860101'::bigint)
               Filter: (collection.document @= '{ "routeId" : { "$numberInt" : "1" }, "collation" : "en-u-ks-level1" }'::bson)
(10 rows)

