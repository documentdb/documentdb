DROP TABLE pcsub_view_def_first_page;
-- ===========================================================================
-- SECTION H: $limit / $skip argument validation with the pushdown GUC on.
-- Regression guard: the persisted-cursor look-ahead walks the stages to decide
-- persistence before the stages are built. It must not pre-empt the
-- stage-specific validation error for $limit (5107201) / $skip (5107200) when
-- the argument is a numeric value that cannot be expressed as a 64-bit integer
-- (e.g. Decimal128 NaN or out of range). The look-ahead only runs when the GUC
-- is on, so the specific error must be raised identically whether the GUC is
-- on or off.
-- ===========================================================================
-- Baseline: with the GUC off the look-ahead is skipped and the stage handler
-- raises the specific error.
SET documentdb.enable_subquery_pushdown_for_match_on_persisted_cursors TO off;
-- $limit Decimal128 NaN -> 5107201
SELECT document FROM bson_aggregation_pipeline('pcsub_pushdown_db',
    '{ "aggregate": "flights", "pipeline": [
        { "$limit": { "$numberDecimal": "NaN" } }
    ], "cursor": {} }');
ERROR:  Invalid $limit stage argument: value cannot be represented as a 64-bit integer: $limit: NaN
-- $limit Decimal128 out of 64-bit range -> 5107201
SELECT document FROM bson_aggregation_pipeline('pcsub_pushdown_db',
    '{ "aggregate": "flights", "pipeline": [
        { "$limit": { "$numberDecimal": "Infinity" } }
    ], "cursor": {} }');
ERROR:  Invalid $limit stage argument: value cannot be represented as a 64-bit integer: $limit: Infinity
-- $skip Decimal128 NaN -> 5107200
SELECT document FROM bson_aggregation_pipeline('pcsub_pushdown_db',
    '{ "aggregate": "flights", "pipeline": [
        { "$skip": { "$numberDecimal": "NaN" } }
    ], "cursor": {} }');
ERROR:  Invalid parameter provided to $skip stage: value cannot be expressed as a 64-bit integer $skip: NaN
-- $skip Decimal128 out of 64-bit range -> 5107200
SELECT document FROM bson_aggregation_pipeline('pcsub_pushdown_db',
    '{ "aggregate": "flights", "pipeline": [
        { "$skip": { "$numberDecimal": "Infinity" } }
    ], "cursor": {} }');
ERROR:  Invalid parameter provided to $skip stage: value cannot be expressed as a 64-bit integer $skip: Infinity
-- With the GUC on the look-ahead runs first, yet the errors must be identical
-- to the baseline above (same code, same message, same stage).
SET documentdb.enable_subquery_pushdown_for_match_on_persisted_cursors TO on;
-- $limit Decimal128 NaN -> 5107201 (not a generic conversion error)
SELECT document FROM bson_aggregation_pipeline('pcsub_pushdown_db',
    '{ "aggregate": "flights", "pipeline": [
        { "$limit": { "$numberDecimal": "NaN" } }
    ], "cursor": {} }');
ERROR:  Invalid $limit stage argument: value cannot be represented as a 64-bit integer: $limit: NaN
-- $limit Decimal128 out of 64-bit range -> 5107201
SELECT document FROM bson_aggregation_pipeline('pcsub_pushdown_db',
    '{ "aggregate": "flights", "pipeline": [
        { "$limit": { "$numberDecimal": "Infinity" } }
    ], "cursor": {} }');
ERROR:  Invalid $limit stage argument: value cannot be represented as a 64-bit integer: $limit: Infinity
-- $skip Decimal128 NaN -> 5107200
SELECT document FROM bson_aggregation_pipeline('pcsub_pushdown_db',
    '{ "aggregate": "flights", "pipeline": [
        { "$skip": { "$numberDecimal": "NaN" } }
    ], "cursor": {} }');
ERROR:  Invalid parameter provided to $skip stage: value cannot be expressed as a 64-bit integer $skip: NaN
-- $skip Decimal128 out of 64-bit range -> 5107200
SELECT document FROM bson_aggregation_pipeline('pcsub_pushdown_db',
    '{ "aggregate": "flights", "pipeline": [
        { "$skip": { "$numberDecimal": "Infinity" } }
    ], "cursor": {} }');
ERROR:  Invalid parameter provided to $skip stage: value cannot be expressed as a 64-bit integer $skip: Infinity
-- Computed group input must be shared by the key and all accumulators.
SET documentdb_core.enableCollation TO on;
SELECT $command${
    "aggregate": "flights", "pipeline": [
        { "$project": { "routeId": 1, "carrier": 1, "legs": 1 } },
        { "$project": { "routeId": 1, "carrier": 1,
                       "distance": { "$sum": "$legs.dist" } } },
        { "$group": {
            "_id": { "route": "$routeId", "carrier": "$carrier" },
            "total": { "$sum": "$distance" },
            "average": { "$avg": "$distance" },
            "minimum": { "$min": "$distance" },
            "maximum": { "$max": "$distance" },
            "count": { "$sum": 1 }
        } },
        { "$sort": { "_id.route": 1 } }
    ], "cursor": { "batchSize": 2 },
    "collation": { "locale": "en", "strength": 1 }
}$command$ AS pcsub_group_command \gset
BEGIN;
SET LOCAL track_functions TO 'all';
SELECT coalesce(sum(calls), 0) AS pcsub_group_initial_calls
FROM pg_stat_xact_user_functions WHERE funcname = 'bson_dollar_project' \gset
SET LOCAL documentdb.enable_subquery_pushdown_for_group TO off;
CREATE TEMP TABLE pcsub_group_baseline AS
SELECT document FROM bson_aggregation_pipeline('pcsub_pushdown_db', :'pcsub_group_command');
SELECT sum(calls) AS pcsub_group_baseline_calls
FROM pg_stat_xact_user_functions WHERE funcname = 'bson_dollar_project' \gset
SET LOCAL documentdb.enable_subquery_pushdown_for_group TO on;
CREATE TEMP TABLE pcsub_group_shared AS
SELECT document FROM bson_aggregation_pipeline('pcsub_pushdown_db', :'pcsub_group_command');
SELECT sum(calls) - :pcsub_group_baseline_calls = 40 AS projects_once_per_document,
       sum(calls) - :pcsub_group_baseline_calls <
           :pcsub_group_baseline_calls - :pcsub_group_initial_calls AS fewer_projection_calls
FROM pg_stat_xact_user_functions WHERE funcname = 'bson_dollar_project';
 projects_once_per_document | fewer_projection_calls 
----------------------------+------------------------
 t                          | t
(1 row)

COMMIT;
SELECT NOT EXISTS (
    (SELECT document FROM pcsub_group_baseline EXCEPT ALL SELECT document FROM pcsub_group_shared)
    UNION ALL
    (SELECT document FROM pcsub_group_shared EXCEPT ALL SELECT document FROM pcsub_group_baseline)
) AS identical_group_results;
 identical_group_results 
-------------------------
 t
(1 row)

