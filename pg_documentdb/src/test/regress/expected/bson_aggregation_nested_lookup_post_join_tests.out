RESET documentdb.force_nested_lookup_pipeline_after_join;
-- Parent-level let must remain bound to the correct outer row when its
-- pipeline also contains a nested lookup.
SELECT document
FROM bson_aggregation_pipeline(
    'lookup_post_join_db',
    $pipeline$
    {
      "aggregate": "orders",
      "pipeline": [
        { "$sort": { "_id": 1 } },
        {
          "$lookup": {
            "from": "items",
            "localField": "itemCodes",
            "foreignField": "code",
            "let": {
              "outerOrderId": "$_id"
            },
            "pipeline": [
              {
                "$match": {
                  "$expr": {
                    "$eq": [ "$$outerOrderId", 1 ]
                  }
                }
              },
              { "$sort": { "_id": 1 } },
              {
                "$lookup": {
                  "from": "suppliers",
                  "localField": "supplierCode",
                  "foreignField": "code",
                  "as": "suppliers"
                }
              }
            ],
            "as": "items"
          }
        }
      ]
    }
    $pipeline$
);
