-- A missing nested namespace contributes an empty array without removing the
-- parent foreign document.
SELECT document
FROM bson_aggregation_pipeline(
    'lookup_post_join_db',
    $pipeline$
    {
      "aggregate": "orders",
      "pipeline": [
        { "$match": { "_id": 1 } },
        {
          "$lookup": {
            "from": "items",
            "localField": "itemCodes",
            "foreignField": "code",
            "pipeline": [
              { "$match": { "code": 10 } },
              {
                "$lookup": {
                  "from": "missing_nested_collection",
                  "localField": "supplierCode",
                  "foreignField": "code",
                  "as": "missing"
                }
              }
            ],
            "as": "items"
          }
        }
      ]
    }
    $pipeline$
);
                                                                                                                                        document                                                                                                                                         
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 { "_id" : { "$numberInt" : "1" }, "itemCodes" : [ { "$numberInt" : "10" }, { "$numberInt" : "20" } ], "items" : [ { "_id" : { "$numberInt" : "101" }, "code" : { "$numberInt" : "10" }, "enabled" : true, "supplierCode" : "S1", "supplier" : { "code" : "S1" }, "missing" : [  ] } ] }
