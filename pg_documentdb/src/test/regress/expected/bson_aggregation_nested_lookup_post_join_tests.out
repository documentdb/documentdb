-- Flag off establishes the semantic baseline.
SELECT document
FROM bson_aggregation_pipeline(
    'lookup_post_join_db',
    $pipeline$
    {
      "aggregate": "orders",
      "pipeline": [
        { "$sort": { "_id": 1 } },
        {
          "$lookup": {
            "from": "items",
            "localField": "itemCodes",
            "foreignField": "code",
            "pipeline": [
              { "$match": { "enabled": true } },
              { "$sort": { "_id": 1 } },
              {
                "$lookup": {
                  "from": "suppliers",
                  "localField": "supplierCode",
                  "foreignField": "code",
                  "pipeline": [
                    { "$sort": { "_id": 1 } },
                    {
                      "$lookup": {
                        "from": "regions",
                        "localField": "regionCode",
                        "foreignField": "code",
                        "pipeline": [
                          { "$sort": { "_id": 1 } }
                        ],
                        "as": "region"
                      }
                    }
                  ],
                  "as": "suppliers"
                }
              },
              {
                "$lookup": {
                  "from": "stock",
                  "localField": "code",
                  "foreignField": "itemCode",
                  "pipeline": [
                    { "$sort": { "_id": 1 } }
                  ],
                  "as": "stock"
                }
              }
            ],
            "as": "items"
          }
        }
      ]
    }
    $pipeline$
);
