SET documentdb.next_collection_id TO 1983000;
SET documentdb.next_collection_index_id TO 1983000;
SET documentdb.maxUserLimit TO 10;
\set VERBOSITY TERSE
-- Enable role CRUD operations for testing
SET documentdb.enableRoleCrud TO ON;
-- Enable db admin requirement for testing
SET documentdb.enableRolesAdminDBCheck TO ON;
-- Create a custom role for testing rolesInfo with a custom role
SELECT documentdb_api.create_role('{"createRole":"test_custom_role", "roles":["readAnyDatabase"], "privileges":[], "$db":"admin"}');
            create_role
-----------------------------------
 { "ok" : { "$numberInt" : "1" } }
(1 row)

-- ********* Test rolesInfo with int value *********
-- Test rolesInfo with 1
SELECT documentdb_api.roles_info('{"rolesInfo":1, "$db":"admin"}');
                                                                                                      roles_info
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 { "roles" : [ { "_id" : "admin.test_custom_role", "role" : "test_custom_role", "db" : "admin", "isBuiltIn" : false, "roles" : [ { "role" : "readAnyDatabase", "db" : "admin" } ] } ], "ok" : { "$numberInt" : "1" } }
(1 row)

-- Test rolesInfo with int value other than 1, which is not allowed
SELECT documentdb_api.roles_info('{"rolesInfo":0, "$db":"admin"}');
ERROR:  'rolesInfo' must be 1, a string, a document, or an array.
-- Test rolesInfo with showPrivileges
SELECT documentdb_api.roles_info('{"rolesInfo":1, "showPrivileges":true, "$db":"admin"}');
                                                                                                                 roles_info
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 { "roles" : [ { "_id" : "admin.test_custom_role", "role" : "test_custom_role", "db" : "admin", "isBuiltIn" : false, "privileges" : [  ], "roles" : [ { "role" : "readAnyDatabase", "db" : "admin" } ] } ], "ok" : { "$numberInt" : "1" } }
(1 row)

-- Test rolesInfo with invalid showPrivileges type
SELECT documentdb_api.roles_info('{"rolesInfo":1, "showPrivileges":1, "$db":"admin"}');
ERROR:  'showPrivileges' must be a boolean value
-- Test rolesInfo with showBuiltInRoles
SELECT documentdb_api.roles_info('{"rolesInfo":1, "showBuiltInRoles":true, "$db":"admin"}');
                                                                                                                                                                                                                                                                                        roles_info
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 { "roles" : [ { "_id" : "admin.readAnyDatabase", "role" : "readAnyDatabase", "db" : "admin", "isBuiltIn" : true, "roles" : [  ] }, { "_id" : "admin.clusterAdmin", "role" : "clusterAdmin", "db" : "admin", "isBuiltIn" : true, "roles" : [  ] }, { "_id" : "admin.readWriteAnyDatabase", "role" : "readWriteAnyDatabase", "db" : "admin", "isBuiltIn" : true, "roles" : [  ] }, { "_id" : "admin.test_custom_role", "role" : "test_custom_role", "db" : "admin", "isBuiltIn" : false, "roles" : [ { "role" : "readAnyDatabase", "db" : "admin" } ] } ], "ok" : { "$numberInt" : "1" } }
(1 row)

-- Test rolesInfo with showBuiltInRoles and showPrivileges
SELECT documentdb_api.roles_info('{"rolesInfo":1, "showBuiltInRoles":true, "showPrivileges":true, "$db":"admin"}');
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              roles_info
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 { "roles" : [ { "_id" : "admin.readAnyDatabase", "role" : "readAnyDatabase", "db" : "admin", "isBuiltIn" : true, "privileges" : [ { "resource" : { "db" : "", "collection" : "" }, "actions" : [ "changeStream", "collStats", "dbStats", "find", "killCursors", "listCollections", "listIndexes" ] }, { "resource" : { "cluster" : true }, "actions" : [ "listDatabases" ] } ], "roles" : [  ] }, { "_id" : "admin.clusterAdmin", "role" : "clusterAdmin", "db" : "admin", "isBuiltIn" : true, "privileges" : [ { "resource" : { "cluster" : true }, "actions" : [ "compact", "connPoolStats", "dropConnections", "getChangeStreamState", "getClusterParameter", "getCmdLineOpts", "getDefaultRWConcern", "getLog", "getParameter", "getShardMap", "hostInfo", "killAnyCursor", "killAnySession", "killop", "listDatabases", "listSessions", "listShards", "serverStatus", "setChangeStreamState" ] }, { "resource" : { "db" : "", "collection" : "" }, "actions" : [ "analyzeShardKey", "collStats", "dbStats", "dropDatabase", "enableSharding", "getDatabaseVersion", "getShardVersion", "indexStats", "killCursors", "reshardCollection", "splitVector", "unshardCollection" ] } ], "roles" : [  ] }, { "_id" : "admin.readWriteAnyDatabase", "role" : "readWriteAnyDatabase", "db" : "admin", "isBuiltIn" : true, "privileges" : [ { "resource" : { "db" : "", "collection" : "" }, "actions" : [ "changeStream", "collStats", "createCollection", "createIndex", "dbStats", "dropCollection", "dropIndex", "find", "insert", "killCursors", "listCollections", "listIndexes", "remove", "update" ] }, { "resource" : { "cluster" : true }, "actions" : [ "listDatabases" ] } ], "roles" : [  ] }, { "_id" : "admin.test_custom_role", "role" : "test_custom_role", "db" : "admin", "isBuiltIn" : false, "privileges" : [  ], "roles" : [ { "role" : "readAnyDatabase", "db" : "admin" } ] } ], "ok" : { "$numberInt" : "1" } }
