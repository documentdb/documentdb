-- hint is emitted; the plan keeps the _id index scan.
EXPLAIN (COSTS OFF, VERBOSE ON) SELECT document FROM bson_aggregation_pipeline('scalar_agg_db', '{ "aggregate": "scalar_agg_push", "pipeline": [ { "$group": { "_id": null, "m": { "$max": { "$isArray": "$b" } } } } ] }');
