SET search_path TO documentdb_api,documentdb_core,documentdb_api_catalog,documentdb_api_internal,public;
-- =============================================================================
-- Scalar aggregate index pushdown: for $group with a constant _id (e.g.
-- _id: null), simple "$field" references in the accumulators are emitted as
-- bson_full_scan({"<field>": {"fullScan": true}}) hints so the planner can pick
-- a covering Index Only Scan.  Gated by
-- documentdb.enable_scalar_aggregate_index_pushdown.
-- =============================================================================
SET documentdb.defaultUseCompositeOpClass TO on;
SET documentdb.next_collection_id TO 21300;
SET documentdb.next_collection_index_id TO 21300;
SELECT documentdb_api_internal.create_indexes_non_concurrently(
    'scalar_agg_db', '{ "createIndexes": "scalar_agg_push", "indexes": [ { "name": "a_1", "key": { "a": 1 } }, { "name": "b_c_1", "key": { "b": 1, "c": 1 } }, { "name": "e_f_1", "key": { "e.f": 1 } } ] }', TRUE);
NOTICE:  creating collection
                                                                                                   create_indexes_non_concurrently                                                                                                   
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 { "raw" : { "defaultShard" : { "numIndexesBefore" : { "$numberInt" : "1" }, "numIndexesAfter" : { "$numberInt" : "4" }, "createdCollectionAutomatically" : true, "ok" : { "$numberInt" : "1" } } }, "ok" : { "$numberInt" : "1" } }
(1 row)

SELECT COUNT(documentdb_api.insert_one('scalar_agg_db', 'scalar_agg_push', bson_build_document('_id', i, 'a', i % 100, 'b', i % 10, 'c', i, 'e', bson_build_document('f', i % 100)) )) FROM generate_series(1, 1000) AS i;
 count 
-------
  1000
(1 row)

ANALYZE;
set enable_seqscan to off;
set enable_bitmapscan to off;
-- =============================================================================
-- Baseline: GUC off => no pushdown; plan keeps the _id index scan.
-- =============================================================================
BEGIN;
set local documentdb.enable_scalar_aggregate_index_pushdown to off;
EXPLAIN (COSTS OFF, VERBOSE ON) SELECT document FROM bson_aggregation_pipeline('scalar_agg_db', '{ "aggregate": "scalar_agg_push", "pipeline": [ { "$group": { "_id": null, "total": { "$sum": "$a" } } } ] }');
                                                                                                                    QUERY PLAN                                                                                                                    
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 GroupAggregate
   Output: bson_repath_and_build('_id'::text, '{ "" : null }'::bson, 'total'::text, bsonsumwithexpr(document, '{ "" : "$a" }'::bson, '{ "now" : NOW_SYS_VARIABLE }'::bson, NULL::text)), ('{ "" : null }'::bson)
   Group Key: '{ "" : null }'::bson
   ->  Index Scan using _id_ on documentdb_data.documents_21301 collection
         Output: '{ "" : null }'::bson, document
         Index Cond: (collection.shard_key_value = '21301'::bigint)
(6 rows)

ROLLBACK;
set documentdb.enable_scalar_aggregate_index_pushdown to on;
-- _id: null with $sum:"$a" on indexed field "a" -> covering Index Only Scan
-- on a_1 (no GROUP BY/ORDER BY consumer needed).
EXPLAIN (COSTS OFF, VERBOSE ON) SELECT document FROM bson_aggregation_pipeline('scalar_agg_db', '{ "aggregate": "scalar_agg_push", "pipeline": [ { "$group": { "_id": null, "total": { "$sum": "$a" } } } ] }');
                                                                                                                    QUERY PLAN                                                                                                                    
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 GroupAggregate
   Output: bson_repath_and_build('_id'::text, '{ "" : null }'::bson, 'total'::text, bsonsumwithexpr(document, '{ "" : "$a" }'::bson, '{ "now" : NOW_SYS_VARIABLE }'::bson, NULL::text)), ('{ "" : null }'::bson)
   Group Key: '{ "" : null }'::bson
   ->  Index Only Scan using a_1 on documentdb_data.documents_21301 collection
         Output: '{ "" : null }'::bson, document
         Index Cond: (collection.document @<> '{ "a" : { "fullScan" : true } }'::bson)
(6 rows)

-- Same shape with $avg -- covering Index Only Scan on a_1.
EXPLAIN (COSTS OFF, VERBOSE ON) SELECT document FROM bson_aggregation_pipeline('scalar_agg_db', '{ "aggregate": "scalar_agg_push", "pipeline": [ { "$group": { "_id": null, "average": { "$avg": "$a" } } } ] }');
                                                                                                                       QUERY PLAN                                                                                                                       
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 GroupAggregate
   Output: bson_repath_and_build('_id'::text, '{ "" : null }'::bson, 'average'::text, bsonaveragewithexpr(document, '{ "" : "$a" }'::bson, '{ "now" : NOW_SYS_VARIABLE }'::bson, NULL::text)), ('{ "" : null }'::bson)
   Group Key: '{ "" : null }'::bson
   ->  Index Only Scan using a_1 on documentdb_data.documents_21301 collection
         Output: '{ "" : null }'::bson, document
         Index Cond: (collection.document @<> '{ "a" : { "fullScan" : true } }'::bson)
(6 rows)

-- Multiple accumulators on the same field -> single qual on "a", Index Only
-- Scan on a_1.
EXPLAIN (COSTS OFF, VERBOSE ON) SELECT document FROM bson_aggregation_pipeline('scalar_agg_db', '{ "aggregate": "scalar_agg_push", "pipeline": [ { "$group": { "_id": null, "mx": { "$max": "$a" }, "mn": { "$min": "$a" } } } ] }');
                                                                                                                                                                                           QUERY PLAN                                                                                                                                                                                           
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 GroupAggregate
   Output: bson_repath_and_build('_id'::text, '{ "" : null }'::bson, 'mx'::text, bsonmaxwithexpr(document, '{ "" : "$a" }'::bson, '{ "now" : NOW_SYS_VARIABLE }'::bson, NULL::text), 'mn'::text, bsonminwithexpr(document, '{ "" : "$a" }'::bson, '{ "now" : NOW_SYS_VARIABLE }'::bson, NULL::text)), ('{ "" : null }'::bson)
   Group Key: '{ "" : null }'::bson
   ->  Index Only Scan using a_1 on documentdb_data.documents_21301 collection
         Output: '{ "" : null }'::bson, document
         Index Cond: (collection.document @<> '{ "a" : { "fullScan" : true } }'::bson)
(6 rows)

-- Accumulators on different fields (b, c), both covered by b_c_1.
EXPLAIN (COSTS OFF, VERBOSE ON) SELECT document FROM bson_aggregation_pipeline('scalar_agg_db', '{ "aggregate": "scalar_agg_push", "pipeline": [ { "$group": { "_id": null, "sb": { "$sum": "$b" }, "mc": { "$max": "$c" } } } ] }');
                                                                                                                                                                                           QUERY PLAN                                                                                                                                                                                           
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 GroupAggregate
   Output: bson_repath_and_build('_id'::text, '{ "" : null }'::bson, 'sb'::text, bsonsumwithexpr(document, '{ "" : "$b" }'::bson, '{ "now" : NOW_SYS_VARIABLE }'::bson, NULL::text), 'mc'::text, bsonmaxwithexpr(document, '{ "" : "$c" }'::bson, '{ "now" : NOW_SYS_VARIABLE }'::bson, NULL::text)), ('{ "" : null }'::bson)
   Group Key: '{ "" : null }'::bson
   ->  Index Only Scan using b_c_1 on documentdb_data.documents_21301 collection
         Output: '{ "" : null }'::bson, document
         Index Cond: ((collection.document @<> '{ "b" : { "fullScan" : true } }'::bson) AND (collection.document @<> '{ "c" : { "fullScan" : true } }'::bson))
(6 rows)

-- Non-null constant _id values also push.
EXPLAIN (COSTS OFF, VERBOSE ON) SELECT document FROM bson_aggregation_pipeline('scalar_agg_db', '{ "aggregate": "scalar_agg_push", "pipeline": [ { "$group": { "_id": 1, "total": { "$sum": "$a" } } } ] }');
                                                                                                                                      QUERY PLAN                                                                                                                                      
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 GroupAggregate
   Output: bson_repath_and_build('_id'::text, '{ "" : { "$numberInt" : "1" } }'::bson, 'total'::text, bsonsumwithexpr(document, '{ "" : "$a" }'::bson, '{ "now" : NOW_SYS_VARIABLE }'::bson, NULL::text)), ('{ "" : { "$numberInt" : "1" } }'::bson)
   Group Key: '{ "" : { "$numberInt" : "1" } }'::bson
   ->  Index Only Scan using a_1 on documentdb_data.documents_21301 collection
         Output: '{ "" : { "$numberInt" : "1" } }'::bson, document
         Index Cond: (collection.document @<> '{ "a" : { "fullScan" : true } }'::bson)
(6 rows)

EXPLAIN (COSTS OFF, VERBOSE ON) SELECT document FROM bson_aggregation_pipeline('scalar_agg_db', '{ "aggregate": "scalar_agg_push", "pipeline": [ { "$group": { "_id": "literal", "total": { "$sum": "$a" } } } ] }');
