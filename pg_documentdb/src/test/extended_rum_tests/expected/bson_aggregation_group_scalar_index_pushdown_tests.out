EXPLAIN (COSTS OFF, VERBOSE ON) SELECT document FROM bson_aggregation_pipeline('scalar_agg_db', '{ "aggregate": "scalar_agg_push", "pipeline": [ { "$group": { "_id": null, "label": { "$max": "foo" }, "total": { "$sum": "$a" } } } ] }');
                                                                                                                                                                                                QUERY PLAN                                                                                                                                                                                                
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 GroupAggregate
   Output: bson_repath_and_build('_id'::text, '{ "" : null }'::bson, 'label'::text, bsonmaxwithexpr('{ }'::bson, '{ "" : "foo" }'::bson, '{ "now" : NOW_SYS_VARIABLE }'::bson, NULL::text), 'total'::text, bsonsumwithexpr(document, '{ "" : "$a" }'::bson, '{ "now" : NOW_SYS_VARIABLE }'::bson, NULL::text)), ('{ "" : null }'::bson)
   Group Key: '{ "" : null }'::bson
   ->  Index Only Scan using a_1 on documentdb_data.documents_21301 collection
         Output: '{ "" : null }'::bson, document
         Index Cond: (collection.document @<> '{ "a" : { "fullScan" : true } }'::bson)
(6 rows)

-- Expression argument reads fields the index cannot be proven to cover, so no
-- single-field hint is added.
EXPLAIN (COSTS OFF, VERBOSE ON) SELECT document FROM bson_aggregation_pipeline('scalar_agg_db', '{ "aggregate": "scalar_agg_push", "pipeline": [ { "$group": { "_id": null, "total": { "$sum": { "$multiply": ["$a", "$b"] } } } } ] }');
                                                                                                                                  QUERY PLAN                                                                                                                                  
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 GroupAggregate
   Output: bson_repath_and_build('_id'::text, '{ "" : null }'::bson, 'total'::text, bsonsumwithexpr(document, '{ "" : { "$multiply" : [ "$a", "$b" ] } }'::bson, '{ "now" : NOW_SYS_VARIABLE }'::bson, NULL::text)), ('{ "" : null }'::bson)
   Group Key: '{ "" : null }'::bson
   ->  Index Scan using _id_ on documentdb_data.documents_21301 collection
         Output: '{ "" : null }'::bson, document
         Index Cond: (collection.shard_key_value = '21301'::bigint)
(6 rows)

-- $isArray wraps the field reference in an expression document, so (like
