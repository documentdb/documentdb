-- Mixed group: a covered "$a" accumulator alongside an un-pushable sibling
-- (an expression).  The "$a" hint is still emitted, but the uncovered sibling
-- forces a heap-reading scan (not index-only), so the result stays correct.
EXPLAIN (COSTS OFF, VERBOSE ON) SELECT document FROM bson_aggregation_pipeline('scalar_agg_db', '{ "aggregate": "scalar_agg_push", "pipeline": [ { "$group": { "_id": null, "total": { "$sum": "$a" }, "p": { "$sum": { "$multiply": ["$a", "$b"] } } } } ] }');
                                                                                                                                                                                                          QUERY PLAN                                                                                                                                                                                                          
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 GroupAggregate
   Output: bson_repath_and_build('_id'::text, '{ "" : null }'::bson, 'total'::text, bsonsumwithexpr(document, '{ "" : "$a" }'::bson, '{ "now" : NOW_SYS_VARIABLE }'::bson, NULL::text), 'p'::text, bsonsumwithexpr(document, '{ "" : { "$multiply" : [ "$a", "$b" ] } }'::bson, '{ "now" : NOW_SYS_VARIABLE }'::bson, NULL::text)), ('{ "" : null }'::bson)
   Group Key: '{ "" : null }'::bson
   ->  Index Scan using a_1 on documentdb_data.documents_21301 collection
         Output: '{ "" : null }'::bson, document
         Index Cond: (collection.document @<> '{ "a" : { "fullScan" : true } }'::bson)
(6 rows)

-- Mixed group with a "$$variable" sibling: a covered "$a" accumulator alongside
-- a $max over a let-bound variable ("$$myVar").  A "$$variable" is not a "$field"
-- path, so it contributes no hint, but the "$a" hint is still emitted and drives 
-- the a_1 index scan.
EXPLAIN (COSTS OFF, VERBOSE ON) SELECT document FROM bson_aggregation_pipeline('scalar_agg_db', '{ "aggregate": "scalar_agg_push", "let": { "myVar": "hi" }, "pipeline": [ { "$group": { "_id": null, "total": { "$sum": "$a" }, "v": { "$max": "$$myVar" } } } ] }');
                                                                                                                                                                                                                                           QUERY PLAN                                                                                                                                                                                                                                            
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 GroupAggregate
   Output: bson_repath_and_build('_id'::text, '{ "" : null }'::bson, 'total'::text, bsonsumwithexpr(document, '{ "" : "$a" }'::bson, '{ "now" : NOW_SYS_VARIABLE, "let" : { "myVar" : { "$literal" : "hi" } } }'::bson, NULL::text), 'v'::text, bsonmaxwithexpr(document, '{ "" : "$$myVar" }'::bson, '{ "now" : NOW_SYS_VARIABLE, "let" : { "myVar" : { "$literal" : "hi" } } }'::bson, NULL::text)), ('{ "" : null }'::bson)
   Group Key: '{ "" : null }'::bson
   ->  Index Scan using a_1 on documentdb_data.documents_21301 collection
         Output: '{ "" : null }'::bson, document
         Index Cond: (collection.document @<> '{ "a" : { "fullScan" : true } }'::bson)
(6 rows)

-- WithExpr accumulators (enableNewWithExprAccumulators on): $sum/$avg/$max/$min
-- take a different code path -- verify pushdown still works and is correct.
BEGIN;
set local documentdb.enableNewWithExprAccumulators to on;
EXPLAIN (COSTS OFF, VERBOSE ON) SELECT document FROM bson_aggregation_pipeline('scalar_agg_db', '{ "aggregate": "scalar_agg_push", "pipeline": [ { "$group": { "_id": null, "total": { "$sum": "$a" }, "average": { "$avg": "$a" }, "mx": { "$max": "$b" }, "mn": { "$min": "$b" } } } ] }');
                                                                                                                                                                                                                                                                                                                                                  QUERY PLAN                                                                                                                                                                                                                                                                                                                                                  
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 GroupAggregate
