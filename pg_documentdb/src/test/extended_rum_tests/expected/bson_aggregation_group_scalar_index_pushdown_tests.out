-- Order-sensitive accumulators with a simple "$field" ($first/$push) push too.
-- Without a preceding $sort the input order is arbitrary, so index order is a
-- valid ordering (sorted inputs are covered by the correctness cases below).
EXPLAIN (COSTS OFF, VERBOSE ON) SELECT document FROM bson_aggregation_pipeline('scalar_agg_db', '{ "aggregate": "scalar_agg_push", "pipeline": [ { "$group": { "_id": null, "f": { "$first": "$a" } } } ] }');
                                                                                                                   QUERY PLAN                                                                                                                   
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 GroupAggregate
   Output: bson_repath_and_build('_id'::text, '{ "" : null }'::bson, 'f'::text, bsonfirstwithexpr(document, '{ "" : "$a" }'::bson, '{ "now" : NOW_SYS_VARIABLE }'::bson, NULL::text)), ('{ "" : null }'::bson)
   Group Key: '{ "" : null }'::bson
   ->  Index Only Scan using a_1 on documentdb_data.documents_21301 collection
         Output: '{ "" : null }'::bson, document
         Index Cond: (collection.document @<> '{ "a" : { "fullScan" : true } }'::bson)
(6 rows)

