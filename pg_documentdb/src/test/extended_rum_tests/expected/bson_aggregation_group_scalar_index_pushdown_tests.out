   Output: bson_repath_and_build('_id'::text, '{ "" : "literal" }'::bson, 'total'::text, bsonsumwithexpr(document, '{ "" : "$a" }'::bson, '{ "now" : NOW_SYS_VARIABLE }'::bson, NULL::text)), ('{ "" : "literal" }'::bson)
   Group Key: '{ "" : "literal" }'::bson
