-- =============================================================================
-- Cost-based determinism: penalize heap access with a high seq_page_cost (1000)
-- while leaving enable_seqscan / enable_bitmapscan ON.  At the default
-- seq_page_cost the optimizer prefers a Seq Scan over the 1000-row
-- scalar_agg_push collection; once heap pages are made expensive the covering
-- Index Only Scan on a_1 wins deterministically -- no enable_* knobs required.
-- =============================================================================
set documentdb.enable_scalar_aggregate_index_pushdown to on;
