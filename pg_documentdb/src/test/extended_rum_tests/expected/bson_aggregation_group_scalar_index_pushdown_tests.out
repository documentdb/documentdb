RESET enable_seqscan;
RESET enable_bitmapscan;
set documentdb.enable_scalar_aggregate_index_pushdown to off;
-- =============================================================================
-- P1: more than INDEX_MAX_KEYS (32) distinct "$field" accumulators.  The path
-- collector caps at INDEX_MAX_KEYS and drops the surplus without overflowing the
-- fixed scalarAggFieldPaths array; every accumulator is still evaluated, so the
-- result document keeps all fields (1 _id + 40 accumulators = 41).
-- =============================================================================
set documentdb.enable_scalar_aggregate_index_pushdown to on;
DO $prj$
DECLARE
    v_accums text;
    v_spec text;
    v_doc documentdb_core.bson;
BEGIN
    SELECT string_agg(format('"f%s": { "$max": "$g%s" }', i, i), ', ')
      INTO v_accums FROM generate_series(1, 40) AS i;
    v_spec := format('{ "aggregate": "scalar_agg_push", "pipeline": [ { "$group": { "_id": null, %s } } ] }', v_accums);
    SELECT document INTO v_doc FROM bson_aggregation_pipeline('scalar_agg_db', v_spec::documentdb_core.bson);
    RAISE NOTICE 'field-cap group top-level field count: %',
        (bson_dollar_project(v_doc, '{ "n": { "$size": { "$objectToArray": "$$ROOT" } } }') ->> 'n');
END $prj$;
NOTICE:  field-cap group top-level field count: 41
set documentdb.enable_scalar_aggregate_index_pushdown to off;
-- =============================================================================
-- Cursor coverage.  A constant _id $group is a single group with no ordered
-- grouping key, so it is always a persisted (never streaming) cursor whether
-- dynamic cursors are off or on (see IsGroupByFullyPushableForStreaming).  It
-- still pages: scalar_agg_drain reports (groups, pages).
-- =============================================================================
set enable_seqscan to off;
set enable_bitmapscan to off;
set documentdb.enable_scalar_aggregate_index_pushdown to on;
set documentdb.enableCursorsOnAggregationQueryRewrite to on;
CREATE OR REPLACE FUNCTION scalar_agg_drain(p_agg text, p_cursor_id int8,
                                            OUT groups bigint, OUT pages int) AS $$
DECLARE
    v_page documentdb_core.bson;
    v_cont documentdb_core.bson;
    v_batch bigint;
BEGIN
    groups := 0;
    pages := 0;
    SELECT fp.cursorPage, fp.continuation INTO v_page, v_cont
    FROM aggregate_cursor_first_page(
        database => 'scalar_agg_db', commandSpec => p_agg::documentdb_core.bson,
        cursorId => p_cursor_id) fp;
    pages := pages + 1;
    SELECT (bson_dollar_project(v_page, '{ "c": { "$size": { "$ifNull": ["$cursor.firstBatch", []] } } }') ->> 'c')::bigint INTO v_batch;
    groups := groups + COALESCE(v_batch, 0);

    WHILE v_cont IS NOT NULL LOOP
        SELECT gm.cursorPage, gm.continuation INTO v_page, v_cont
        FROM cursor_get_more(
            database => 'scalar_agg_db',
            getMoreSpec => FORMAT('{ "getMore": { "$numberLong": "%s" }, "collection": "scalar_agg_push", "batchSize": 10 }', p_cursor_id)::documentdb_core.bson,
            continuationSpec => v_cont) gm;
        pages := pages + 1;
        SELECT (bson_dollar_project(v_page, '{ "c": { "$size": { "$ifNull": ["$cursor.nextBatch", []] } } }') ->> 'c')::bigint INTO v_batch;
        groups := groups + COALESCE(v_batch, 0);
    END LOOP;
END;
$$ LANGUAGE plpgsql;
-- batchSize 1: the group fits in the first page (1 group, 1 page).
SET documentdb.enableDynamicCursors TO off;
SELECT groups, pages FROM scalar_agg_drain('{ "aggregate": "scalar_agg_push", "pipeline": [ { "$group": { "_id": null, "total": { "$sum": "$a" } } } ], "cursor": { "batchSize": 1 } }', 7710);
 groups | pages 
--------+-------
      1 |     1
(1 row)

SET documentdb.enableDynamicCursors TO on;
