DROP FUNCTION scalar_agg_drain(text, int8);
SET documentdb.enableDynamicCursors TO off;
SET documentdb.enableCursorsOnAggregationQueryRewrite TO off;
-- =============================================================================
-- Three distinct "$field" accumulator paths, covering vs. non-covering index.
-- Composite index x_y_z_1 has keys (x, y, z):
--   * $group on x, y, z -- all three paths are keys of x_y_z_1 -> covering
--     Index Only Scan with three fullScan hints.
--   * $group on x, y, w -- w is not indexed, so no single index spans all three
--     paths -> heap-fetching Index Scan on the covered x/y prefix.
-- =============================================================================
SELECT documentdb_api_internal.create_indexes_non_concurrently(
    'scalar_agg_db', '{ "createIndexes": "scalar_agg_multi", "indexes": [ { "name": "x_y_z_1", "key": { "x": 1, "y": 1, "z": 1 } } ] }', TRUE);
NOTICE:  creating collection
                                                                                                   create_indexes_non_concurrently                                                                                                   
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 { "raw" : { "defaultShard" : { "numIndexesBefore" : { "$numberInt" : "1" }, "numIndexesAfter" : { "$numberInt" : "2" }, "createdCollectionAutomatically" : true, "ok" : { "$numberInt" : "1" } } }, "ok" : { "$numberInt" : "1" } }
(1 row)

SELECT COUNT(documentdb_api.insert_one('scalar_agg_db', 'scalar_agg_multi', bson_build_document('_id', i, 'x', i % 100, 'y', i % 10, 'z', i, 'w', i % 50) )) FROM generate_series(1, 1000) AS i;
 count 
-------
  1000
(1 row)

ANALYZE;
set enable_seqscan to off;
set enable_bitmapscan to off;
set documentdb.enable_scalar_aggregate_index_pushdown to on;
-- Covering: x, y, z are all keys of x_y_z_1 -> Index Only Scan, three fullScan hints.
EXPLAIN (COSTS OFF, VERBOSE ON) SELECT document FROM bson_aggregation_pipeline('scalar_agg_db', '{ "aggregate": "scalar_agg_multi", "pipeline": [ { "$group": { "_id": null, "sx": { "$sum": "$x" }, "sy": { "$sum": "$y" }, "sz": { "$sum": "$z" } } } ] }');
                                                                                                                                                                                                                                                                   QUERY PLAN                                                                                                                                                                                                                                                                    
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 GroupAggregate
   Output: bson_repath_and_build('_id'::text, '{ "" : null }'::bson, 'sx'::text, bsonsumwithexpr(document, '{ "" : "$x" }'::bson, '{ "now" : NOW_SYS_VARIABLE }'::bson, NULL::text), 'sy'::text, bsonsumwithexpr(document, '{ "" : "$y" }'::bson, '{ "now" : NOW_SYS_VARIABLE }'::bson, NULL::text), 'sz'::text, bsonsumwithexpr(document, '{ "" : "$z" }'::bson, '{ "now" : NOW_SYS_VARIABLE }'::bson, NULL::text)), ('{ "" : null }'::bson)
   Group Key: '{ "" : null }'::bson
   ->  Index Only Scan using x_y_z_1 on documentdb_data.documents_21303 collection
         Output: '{ "" : null }'::bson, document
         Index Cond: ((collection.document @<> '{ "y" : { "fullScan" : true } }'::bson) AND (collection.document @<> '{ "x" : { "fullScan" : true } }'::bson) AND (collection.document @<> '{ "z" : { "fullScan" : true } }'::bson))
(6 rows)

SELECT document FROM bson_aggregation_pipeline('scalar_agg_db', '{ "aggregate": "scalar_agg_multi", "pipeline": [ { "$group": { "_id": null, "sx": { "$sum": "$x" }, "sy": { "$sum": "$y" }, "sz": { "$sum": "$z" } } } ] }');
                                                         document                                                          
---------------------------------------------------------------------------------------------------------------------------
 { "_id" : null, "sx" : { "$numberInt" : "49500" }, "sy" : { "$numberInt" : "4500" }, "sz" : { "$numberInt" : "500500" } }
(1 row)

-- Non-covering: swap z for the un-indexed w.  x_y_z_1 covers x/y but not w, so no
-- Index Only Scan -- the x/y prefix pushes down to a heap-fetching Index Scan.
EXPLAIN (COSTS OFF, VERBOSE ON) SELECT document FROM bson_aggregation_pipeline('scalar_agg_db', '{ "aggregate": "scalar_agg_multi", "pipeline": [ { "$group": { "_id": null, "sx": { "$sum": "$x" }, "sy": { "$sum": "$y" }, "sw": { "$sum": "$w" } } } ] }');
                                                                                                                                                                                                                                                                   QUERY PLAN                                                                                                                                                                                                                                                                    
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 GroupAggregate
   Output: bson_repath_and_build('_id'::text, '{ "" : null }'::bson, 'sx'::text, bsonsumwithexpr(document, '{ "" : "$x" }'::bson, '{ "now" : NOW_SYS_VARIABLE }'::bson, NULL::text), 'sy'::text, bsonsumwithexpr(document, '{ "" : "$y" }'::bson, '{ "now" : NOW_SYS_VARIABLE }'::bson, NULL::text), 'sw'::text, bsonsumwithexpr(document, '{ "" : "$w" }'::bson, '{ "now" : NOW_SYS_VARIABLE }'::bson, NULL::text)), ('{ "" : null }'::bson)
   Group Key: '{ "" : null }'::bson
   ->  Index Scan using x_y_z_1 on documentdb_data.documents_21303 collection
         Output: '{ "" : null }'::bson, document
         Index Cond: ((collection.document @<> '{ "y" : { "fullScan" : true } }'::bson) AND (collection.document @<> '{ "x" : { "fullScan" : true } }'::bson))
(6 rows)

SELECT document FROM bson_aggregation_pipeline('scalar_agg_db', '{ "aggregate": "scalar_agg_multi", "pipeline": [ { "$group": { "_id": null, "sx": { "$sum": "$x" }, "sy": { "$sum": "$y" }, "sw": { "$sum": "$w" } } } ] }');
                                                         document                                                         
--------------------------------------------------------------------------------------------------------------------------
 { "_id" : null, "sx" : { "$numberInt" : "49500" }, "sy" : { "$numberInt" : "4500" }, "sw" : { "$numberInt" : "24500" } }
(1 row)

RESET enable_seqscan;
RESET enable_bitmapscan;
set documentdb.enable_scalar_aggregate_index_pushdown to off;
-- =============================================================================
-- Three distinct "$field" accumulator paths indexed by three SEPARATE
-- single-field indexes (x_1, y_1, z_1) -- no single index spans all three, so
-- no covering Index Only Scan:
--   * bitmap scans off -> a single-index Index Scan (one path's fullScan hint
--     pushed; the other two accumulators read "document" from the heap).
--   * bitmap scans on  -> a single-index Bitmap Heap Scan (no BitmapAnd).
-- =============================================================================
SELECT documentdb_api_internal.create_indexes_non_concurrently(
    'scalar_agg_db', '{ "createIndexes": "scalar_agg_sep", "indexes": [ { "name": "x_1", "key": { "x": 1 } }, { "name": "y_1", "key": { "y": 1 } }, { "name": "z_1", "key": { "z": 1 } } ] }', TRUE);
NOTICE:  creating collection
                                                                                                   create_indexes_non_concurrently                                                                                                   
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 { "raw" : { "defaultShard" : { "numIndexesBefore" : { "$numberInt" : "1" }, "numIndexesAfter" : { "$numberInt" : "4" }, "createdCollectionAutomatically" : true, "ok" : { "$numberInt" : "1" } } }, "ok" : { "$numberInt" : "1" } }
(1 row)

SELECT COUNT(documentdb_api.insert_one('scalar_agg_db', 'scalar_agg_sep', bson_build_document('_id', i, 'x', i % 100, 'y', i % 10, 'z', i) )) FROM generate_series(1, 1000) AS i;
 count 
-------
  1000
(1 row)

ANALYZE;
set documentdb.enable_scalar_aggregate_index_pushdown to on;
-- Bitmap scans off: single-index Index Scan (one fullScan hint pushed, heap fetch).
set enable_seqscan to off;
set enable_bitmapscan to off;
EXPLAIN (COSTS OFF, VERBOSE ON) SELECT document FROM bson_aggregation_pipeline('scalar_agg_db', '{ "aggregate": "scalar_agg_sep", "pipeline": [ { "$group": { "_id": null, "sx": { "$sum": "$x" }, "sy": { "$sum": "$y" }, "sz": { "$sum": "$z" } } } ] }');
                                                                                                                                                                                                                                                                   QUERY PLAN                                                                                                                                                                                                                                                                    
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 GroupAggregate
   Output: bson_repath_and_build('_id'::text, '{ "" : null }'::bson, 'sx'::text, bsonsumwithexpr(document, '{ "" : "$x" }'::bson, '{ "now" : NOW_SYS_VARIABLE }'::bson, NULL::text), 'sy'::text, bsonsumwithexpr(document, '{ "" : "$y" }'::bson, '{ "now" : NOW_SYS_VARIABLE }'::bson, NULL::text), 'sz'::text, bsonsumwithexpr(document, '{ "" : "$z" }'::bson, '{ "now" : NOW_SYS_VARIABLE }'::bson, NULL::text)), ('{ "" : null }'::bson)
   Group Key: '{ "" : null }'::bson
   ->  Index Scan using z_1 on documentdb_data.documents_21304 collection
         Output: '{ "" : null }'::bson, document
         Index Cond: (collection.document @<> '{ "z" : { "fullScan" : true } }'::bson)
(6 rows)

-- Bitmap scans on: single-index Bitmap Heap Scan (no BitmapAnd).
set enable_seqscan to off;
set enable_bitmapscan to on;
EXPLAIN (COSTS OFF, VERBOSE ON) SELECT document FROM bson_aggregation_pipeline('scalar_agg_db', '{ "aggregate": "scalar_agg_sep", "pipeline": [ { "$group": { "_id": null, "sx": { "$sum": "$x" }, "sy": { "$sum": "$y" }, "sz": { "$sum": "$z" } } } ] }');
                                                                                                                                                                                                                                                                   QUERY PLAN                                                                                                                                                                                                                                                                    
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 GroupAggregate
   Output: bson_repath_and_build('_id'::text, '{ "" : null }'::bson, 'sx'::text, bsonsumwithexpr(document, '{ "" : "$x" }'::bson, '{ "now" : NOW_SYS_VARIABLE }'::bson, NULL::text), 'sy'::text, bsonsumwithexpr(document, '{ "" : "$y" }'::bson, '{ "now" : NOW_SYS_VARIABLE }'::bson, NULL::text), 'sz'::text, bsonsumwithexpr(document, '{ "" : "$z" }'::bson, '{ "now" : NOW_SYS_VARIABLE }'::bson, NULL::text)), ('{ "" : null }'::bson)
   Group Key: '{ "" : null }'::bson
   ->  Bitmap Heap Scan on documentdb_data.documents_21304 collection
         Output: '{ "" : null }'::bson, document
         Recheck Cond: (collection.document @<> '{ "z" : { "fullScan" : true } }'::bson)
         ->  Bitmap Index Scan on z_1
               Index Cond: (collection.document @<> '{ "z" : { "fullScan" : true } }'::bson)
(8 rows)

SELECT document FROM bson_aggregation_pipeline('scalar_agg_db', '{ "aggregate": "scalar_agg_sep", "pipeline": [ { "$group": { "_id": null, "sx": { "$sum": "$x" }, "sy": { "$sum": "$y" }, "sz": { "$sum": "$z" } } } ] }');
