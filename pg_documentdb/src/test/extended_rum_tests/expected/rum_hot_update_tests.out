-- a scalar becomes an array: new terms, and the composite index becomes
-- multi-key on b
SELECT documentdb_api.update('hot_db', '{ "update": "hot_upd", "updates": [
  { "q": { "_id": 61 }, "u": { "$set": { "b": [ 1, 2 ] } } } ] }');
                                                               update                                                               
------------------------------------------------------------------------------------------------------------------------------------
 ("{ ""ok"" : { ""$numberDouble"" : ""1.0"" }, ""nModified"" : { ""$numberInt"" : ""1"" }, ""n"" : { ""$numberInt"" : ""1"" } }",t)
(1 row)

-- None of these 61 updates is HOT, on any server.
SELECT updated, hot FROM hot_counts();
 updated | hot 
---------+-----
      61 |   0
(1 row)

COMMIT;
-- Every index finds what a sequential scan finds.
-- Each filter's count through the indexes (where one applies), then with
-- a sequential scan: they must agree.
SET documentdb.forceDisableSeqScan TO on;
SELECT document FROM bson_aggregation_count('hot_db', '{ "count": "hot_upd", "query": { "a": { "$gte": 0 } } }');
                                document                                
------------------------------------------------------------------------
 { "n" : { "$numberInt" : "200" }, "ok" : { "$numberDouble" : "1.0" } }
(1 row)

