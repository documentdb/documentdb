-- A unique index is an exclusion constraint, and same index entries do not
-- mean the same constraint result: the constraint compares the documents'
-- values.  A server that makes such an update HOT checks the constraint
-- itself after the update; on other servers the update is not HOT.
-- Make the entries collide: every unique term hashes alike, and two values
-- with a long common prefix give the same truncated composite term.  The
-- constraint's recheck tells them apart at insert, and must at update.
SELECT documentdb_api.create_collection('hot_db', 'hot_uniq');
NOTICE:  creating collection
 create_collection 
-------------------
 t
(1 row)

SELECT collection_id AS uniq_col FROM documentdb_api_catalog.collections
  WHERE database_name = 'hot_db' AND collection_name = 'hot_uniq' \gset
SELECT FORMAT('ALTER TABLE documentdb_data.documents_%s SET (fillfactor = 10, autovacuum_enabled = off)', :uniq_col) \gexec
ALTER TABLE documentdb_data.documents_3202 SET (fillfactor = 10, autovacuum_enabled = off)
