   200
(1 row)

CREATE FUNCTION hot_counts(OUT updated bigint, OUT hot bigint) LANGUAGE sql AS $$
  SELECT n_tup_upd, n_tup_hot_upd FROM pg_stat_xact_user_tables
   WHERE relname = 'documents_' || current_setting('hot.col') $$;
SELECT set_config('hot.col', :'hot_col', false) IS NOT NULL AS ok;
 ok 
----
 t
(1 row)

-- pg_stat_xact_* shows what this backend has not yet reported, which can
-- include earlier transactions: report everything before each count.
-- Every index sees the same terms: HOT where the server supports it.
SELECT pg_stat_force_next_flush();
 pg_stat_force_next_flush 
--------------------------
 
(1 row)

BEGIN;
SELECT documentdb_api.update('hot_db', '{ "update": "hot_upd", "updates": [
  { "q": {}, "u": { "$inc": { "n": 1 } }, "multi": true } ] }');
                                                                 update                                                                 
----------------------------------------------------------------------------------------------------------------------------------------
 ("{ ""ok"" : { ""$numberDouble"" : ""1.0"" }, ""nModified"" : { ""$numberInt"" : ""200"" }, ""n"" : { ""$numberInt"" : ""200"" } }",t)
(1 row)

SELECT updated, hot IN (0, updated) AS hot_all_or_none FROM hot_counts();
 updated | hot_all_or_none 
---------+-----------------
     200 | t
(1 row)

-- One document at a time (updateOne): the new document is computed in C
-- and written back whole.
SELECT COUNT(documentdb_api.update('hot_db', FORMAT('{ "update": "hot_upd", "updates": [
  { "q": { "_id": %s }, "u": { "$set": { "x": "y" } } } ] }', i)::bson))
  FROM generate_series(1, 50) i;
 count 
-------
    50
(1 row)

SELECT updated, hot IN (0, updated) AS hot_all_or_none FROM hot_counts();
 updated | hot_all_or_none 
---------+-----------------
     250 | t
(1 row)

COMMIT;
