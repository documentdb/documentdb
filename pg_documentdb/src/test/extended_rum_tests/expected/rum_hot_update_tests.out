SET search_path TO documentdb_api_catalog, documentdb_core, public;
SET documentdb.next_collection_id TO 3200;
SET documentdb.next_collection_index_id TO 3200;
-- Updates that leave the terms of every index on a collection unchanged can
-- be heap-only (HOT) when the server lets index access methods compare the
-- entries an old and a new document give (amcomparedatums).  On servers
-- without that, every update to an indexed collection makes new index
-- entries.  Either way, every query must find exactly the documents a
-- sequential scan finds.
SELECT documentdb_api.drop_collection('hot_db', 'hot_upd');
 drop_collection 
-----------------
 f
(1 row)

SELECT documentdb_api.create_collection('hot_db', 'hot_upd');
NOTICE:  creating collection
 create_collection 
-------------------
 t
(1 row)

SELECT collection_id AS hot_col FROM documentdb_api_catalog.collections
  WHERE database_name = 'hot_db' AND collection_name = 'hot_upd' \gset
-- Leave room on every page for every update in this test, so that whether
-- an update is HOT depends only on the indexes.
SELECT FORMAT('ALTER TABLE documentdb_data.documents_%s SET (fillfactor = 10, autovacuum_enabled = off)', :hot_col) \gexec
ALTER TABLE documentdb_data.documents_3201 SET (fillfactor = 10, autovacuum_enabled = off)
SELECT documentdb_api_internal.create_indexes_non_concurrently('hot_db',
  '{ "createIndexes": "hot_upd", "indexes": [
     { "key": { "a": 1 }, "name": "a_1" },
     { "key": { "b": 1, "c": 1 }, "name": "b_1_c_1", "enableCompositeTerm": true },
     { "key": { "h": "hashed" }, "name": "h_hashed" } ] }', TRUE);
                                                                                                   create_indexes_non_concurrently                                                                                                    
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 { "raw" : { "defaultShard" : { "numIndexesBefore" : { "$numberInt" : "1" }, "numIndexesAfter" : { "$numberInt" : "4" }, "createdCollectionAutomatically" : false, "ok" : { "$numberInt" : "1" } } }, "ok" : { "$numberInt" : "1" } }
(1 row)

SELECT COUNT(documentdb_api.insert_one('hot_db', 'hot_upd',
  FORMAT('{ "_id": %s, "a": %s, "b": %s, "c": "c%s", "h": %s, "n": 0 }', i, i, i % 10, i, i)::bson))
  FROM generate_series(1, 200) i;
 count 
