-- ============================================================
-- Case 4: no weak-lock pruning algorithm is active. Cleanup-phase pruning only
-- compensates for leaves a weak-lock algorithm skipped, so with both algorithms
-- off it must not descend the posting trees.
-- ============================================================
SET documentdb_rum.enable_single_pass_posting_tree_vacuum TO off;
SET documentdb_rum.enable_targeted_posting_tree_pruning TO off;
SELECT FORMAT('TRUNCATE documentdb_data.documents_%s;', :orphan_col) \gexec
