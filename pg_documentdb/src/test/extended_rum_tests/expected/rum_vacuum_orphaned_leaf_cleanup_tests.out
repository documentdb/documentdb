SELECT collection_id AS orphan_col FROM documentdb_api_catalog.collections
WHERE database_name = 'pvacuum_orphan_db' AND collection_name = 'orphan_test' \gset
-- disable autovacuum to have predictability
SELECT FORMAT('ALTER TABLE documentdb_data.documents_%s SET (autovacuum_enabled = off, toast.autovacuum_enabled = off, vacuum_index_cleanup = on, toast.vacuum_index_cleanup = on)', :orphan_col) \gexec
ALTER TABLE documentdb_data.documents_25001 SET (autovacuum_enabled = off, toast.autovacuum_enabled = off, vacuum_index_cleanup = on, toast.vacuum_index_cleanup = on)
SELECT documentdb_api_internal.create_indexes_non_concurrently(
    'pvacuum_orphan_db',
    '{ "createIndexes": "orphan_test", "indexes": [ { "key": { "a": 1 }, "name": "a_1", "enableCompositeTerm": true } ] }', TRUE);
