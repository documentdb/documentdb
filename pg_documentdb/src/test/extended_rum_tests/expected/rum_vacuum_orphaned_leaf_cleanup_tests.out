SELECT index_id AS orphan_index_id FROM documentdb_api_catalog.collection_indexes
WHERE collection_id = :orphan_col AND index_id != :orphan_col \gset
SELECT FORMAT('documentdb_data.documents_rum_index_%s', :orphan_index_id) AS orphan_index_name \gset
CREATE FUNCTION pg_temp.index_page_stats(indexName text)
RETURNS TABLE(flags text, n_entries int, left_link bigint, right_link bigint,
              block_number int, page_flags int)
LANGUAGE sql
AS $$
    SELECT s->>'flagsStr', (s->>'nEntries')::int,
           (s->>'leftLink')::bigint, (s->>'rightLink')::bigint,
           i, (s->>'flags')::int
    FROM generate_series(1,
             (pg_relation_size(indexName) / current_setting('block_size')::int)::int - 1) AS i,
         LATERAL documentdb_api_internal.documentdb_rum_page_get_stats(
             public.get_raw_page(indexName, i)) AS s;
$$;
CREATE FUNCTION pg_temp.data_page_counts(indexName text)
RETURNS TABLE(recorded_data_pages bigint, live_data_pages bigint)
LANGUAGE sql
AS $$
    SELECT (documentdb_api_internal.documentdb_rum_get_meta_page_info(
                public.get_raw_page(indexName, 0))->>'dataPages')::bigint,
           (SELECT count(*) FROM pg_temp.index_page_stats(indexName)
            WHERE (page_flags & 1) <> 0
              AND (page_flags & 4) = 0 AND (page_flags & 64) = 0);
$$;
-- Counts empty posting-tree leaves that are neither deleted nor half-dead.
CREATE FUNCTION pg_temp.count_orphaned_empty_leaves(indexName text)
RETURNS bigint
LANGUAGE sql
AS $$
    SELECT count(*)
    FROM pg_temp.index_page_stats(indexName)
    WHERE flags LIKE '%DATA%'
      AND flags LIKE '%LEAF%'
      AND flags NOT LIKE '%DELETED%'
      AND flags NOT LIKE '%HALF_DEAD%'
      AND n_entries = 0;
$$;
-- Builds a posting tree spanning many leaves on a single term, then empties
-- every leaf via a delete plus a bulk delete that is forbidden from pruning.
CREATE PROCEDURE pg_temp.build_orphaned_posting_tree(collectionId bigint)
LANGUAGE plpgsql
AS $$
BEGIN
    PERFORM documentdb_api.insert_one('pvacuum_orphan_db', 'orphan_test',
        FORMAT('{ "_id": %s, "a": 500 }', i)::bson) FROM generate_series(1, 20000) AS i;

    PERFORM documentdb_api.delete('pvacuum_orphan_db',
        '{ "delete": "orphan_test", "deletes": [ { "q": { "_id": { "$gte": 1 } }, "limit": 0 } ]}');
END;
$$;
-- ============================================================
-- Case 1: single-pass posting tree vacuum
-- ============================================================
-- Keep each posting tree data page small so the tree spans many leaves
SET documentdb_rum.data_page_posting_tree_size = 3;
CALL pg_temp.build_orphaned_posting_tree(:orphan_col);
-- wait for the xmin horizon to advance past the DELETE so VACUUM is guaranteed
-- to consider the deleted tuples fully dead and run ambulkdelete
CALL documentdb_test_helpers.wait_for_vacuum_horizon();
-- ambulkdelete empties every leaf but is forbidden from deleting any of them,
-- which is the state left behind when the target-page cleanup lock fails.
SET documentdb_rum.vacuum_skip_prune_posting_tree_pages TO on;
SELECT FORMAT('VACUUM (FREEZE ON, INDEX_CLEANUP ON, DISABLE_PAGE_SKIPPING ON, PARALLEL 0) documentdb_data.documents_%s;', :orphan_col) \gexec
VACUUM (FREEZE ON, INDEX_CLEANUP ON, DISABLE_PAGE_SKIPPING ON, PARALLEL 0) documentdb_data.documents_25001;
SET documentdb_rum.vacuum_skip_prune_posting_tree_pages TO off;
SELECT pg_temp.count_orphaned_empty_leaves(:'orphan_index_name') AS orphans_before_sp \gset
-- No further deletes happen, so the heap has no dead tuples and ambulkdelete is
-- not called. Only rumvacuumcleanup runs, and it must reclaim the orphans.
SET client_min_messages TO LOG;
SELECT FORMAT('VACUUM (FREEZE ON, INDEX_CLEANUP ON, DISABLE_PAGE_SKIPPING ON, PARALLEL 0) documentdb_data.documents_%s;', :orphan_col) \gexec
VACUUM (FREEZE ON, INDEX_CLEANUP ON, DISABLE_PAGE_SKIPPING ON, PARALLEL 0) documentdb_data.documents_25001;
LOG:  Vacuum[index=xxx,vacuumCleanup=1] emptyEntryPages=0, emptyEntries=0, emptyPostingTrees=1, prunedEntries=0, prunedPages=0,prunedPostingTrees=0, postingPagesDeleted=15, emptyPostingPages=2, numBacktracks=0, isNewBulkDelete=1, numEntryPages=1, numDataPages=7, numVoidPages=15, fullScanPostingTreePrunes=0, targetedPostingTreePrunes=0, singlePassPostingTreePrunes=0, staleEmptyLeafRetries=0, cleanupRetryRuns=1, cleanupRetryPostingTrees=1, cleanupRetryPostingPagesDeleted=15, cleanupRetryEntryPagesPruned=0, cleanupRetryEntriesPruned=0
RESET client_min_messages;
SELECT pg_temp.count_orphaned_empty_leaves(:'orphan_index_name') AS orphans_after_sp \gset
SELECT :orphans_before_sp > 2 AS had_prunable_orphans_single_pass,
       :orphans_after_sp < :orphans_before_sp AS cleanup_pruned_orphans_single_pass,
       :orphans_after_sp AS bound_leaves_remaining_single_pass;
 had_prunable_orphans_single_pass | cleanup_pruned_orphans_single_pass | bound_leaves_remaining_single_pass 
----------------------------------+------------------------------------+------------------------------------
 t                                | t                                  |                                  2
(1 row)

-- Pages deleted ahead of the physical scan must not be subtracted twice.
SELECT recorded_data_pages = live_data_pages AS data_pages_match_forward_pruning
FROM pg_temp.data_page_counts(:'orphan_index_name');
