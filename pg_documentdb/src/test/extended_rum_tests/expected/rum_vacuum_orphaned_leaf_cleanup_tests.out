CALL documentdb_test_helpers.wait_for_vacuum_horizon();
SELECT FORMAT('VACUUM (FREEZE ON, INDEX_CLEANUP ON, DISABLE_PAGE_SKIPPING ON, PARALLEL 0) documentdb_data.documents_%s;', :orphan_col) \gexec
VACUUM (FREEZE ON, INDEX_CLEANUP ON, DISABLE_PAGE_SKIPPING ON, PARALLEL 0) documentdb_data.documents_25001;
SELECT count(*) FILTER (WHERE flags = 'LEAF|DATA' AND n_entries = 0
                         AND left_link IS NULL AND right_link IS NULL) AS empty_roots_before,
       count(*) FILTER (WHERE flags = 'LEAF') AS entry_pages_before,
       coalesce(sum(n_entries) FILTER (WHERE flags = 'LEAF'), 0) AS leaf_entries_before
FROM pg_temp.index_page_stats(:'orphan_index_name') \gset
SELECT :empty_roots_before > 2 AS has_empty_single_page_roots,
       :entry_pages_before > 2 AS has_interior_entry_pages;
 has_empty_single_page_roots | has_interior_entry_pages 
-----------------------------+--------------------------
 t                           | t
(1 row)

SET documentdb_rum.prune_rum_empty_pages TO on;
SET client_min_messages TO LOG;
SELECT FORMAT('VACUUM (FREEZE ON, INDEX_CLEANUP ON, DISABLE_PAGE_SKIPPING ON, PARALLEL 0) documentdb_data.documents_%s;', :orphan_col) \gexec
VACUUM (FREEZE ON, INDEX_CLEANUP ON, DISABLE_PAGE_SKIPPING ON, PARALLEL 0) documentdb_data.documents_25001;
LOG:  Vacuum[index=xxx,vacuumCleanup=1] emptyEntryPages=9, emptyEntries=0, emptyPostingTrees=20, prunedEntries=8, prunedPages=7,prunedPostingTrees=15, postingPagesDeleted=0, emptyPostingPages=5, numBacktracks=0, isNewBulkDelete=1, numEntryPages=3, numDataPages=5, numVoidPages=15, fullScanPostingTreePrunes=0, targetedPostingTreePrunes=0, singlePassPostingTreePrunes=0, staleEmptyLeafRetries=0, cleanupRetryRuns=1, cleanupRetryPostingTrees=20, cleanupRetryPostingPagesDeleted=15, cleanupRetryEntryPagesPruned=7, cleanupRetryEntriesPruned=8
RESET client_min_messages;
SELECT count(*) FILTER (WHERE flags = 'LEAF|DATA' AND n_entries = 0
                         AND left_link IS NULL AND right_link IS NULL) AS empty_roots_after,
       count(*) FILTER (WHERE flags = 'LEAF') AS entry_pages_after,
       coalesce(sum(n_entries) FILTER (WHERE flags = 'LEAF'), 0) AS leaf_entries_after
FROM pg_temp.index_page_stats(:'orphan_index_name') \gset
SELECT :empty_roots_after < :empty_roots_before AS cleanup_deleted_posting_roots,
       :entry_pages_after < :entry_pages_before AS cleanup_pruned_entry_pages,
       :leaf_entries_after < :leaf_entries_before AS cleanup_pruned_leaf_entries;
 cleanup_deleted_posting_roots | cleanup_pruned_entry_pages | cleanup_pruned_leaf_entries 
-------------------------------+----------------------------+-----------------------------
 t                             | t                          | t
(1 row)

-- Metapage estimates must exclude unlinked leaves and their retained high keys.
WITH live_entries AS (
    SELECT count(*) FILTER (WHERE flags IN ('', 'LEAF')) AS entry_pages,
           coalesce(sum(n_entries) FILTER (WHERE flags = 'LEAF'), 0) AS entries
    FROM pg_temp.index_page_stats(:'orphan_index_name')
), metadata AS (
    SELECT documentdb_api_internal.documentdb_rum_get_meta_page_info(
        public.get_raw_page(:'orphan_index_name', 0)) AS info
)
SELECT (info->>'entryPages')::bigint = entry_pages AS metapage_entry_pages_match,
       (info->>'entries')::bigint = entries AS metapage_entries_match
FROM metadata, live_entries;
 metapage_entry_pages_match | metapage_entries_match 
----------------------------+------------------------
 t                          | t
(1 row)

SELECT recorded_data_pages = live_data_pages AS data_pages_match_forward_root_pruning
FROM pg_temp.data_page_counts(:'orphan_index_name');
