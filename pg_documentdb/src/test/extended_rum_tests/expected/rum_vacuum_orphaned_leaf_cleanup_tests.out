-- Case 10: create the posting tree before entry-tree splits move its term to
-- a later block. Cleanup then deletes data pages the physical scan counted.
SET documentdb_rum.enable_vacuum_cleanup_posting_tree_pruning TO off;
SET documentdb_rum.prune_rum_empty_pages TO off;
SET documentdb_rum.data_page_posting_tree_size TO 3;
SELECT FORMAT('TRUNCATE documentdb_data.documents_%s;', :orphan_col) \gexec
TRUNCATE documentdb_data.documents_25001;
SELECT count(documentdb_api.insert_one('pvacuum_orphan_db', 'orphan_test',
    FORMAT('{ "_id": %s, "a": "%s" }', i, repeat('z', 1000))::bson))
FROM generate_series(1, 20000) AS i;
