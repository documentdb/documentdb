-- Inline cleanup is not attributed to the retry feature even when the flag is
-- on and bulk deletion is skipped.
SET documentdb_rum.enable_vacuum_cleanup_posting_tree_pruning TO on;
SET client_min_messages TO LOG;
SELECT FORMAT('VACUUM (FREEZE ON, INDEX_CLEANUP ON, DISABLE_PAGE_SKIPPING ON, PARALLEL 0) documentdb_data.documents_%s;', :orphan_col) \gexec
VACUUM (FREEZE ON, INDEX_CLEANUP ON, DISABLE_PAGE_SKIPPING ON, PARALLEL 0) documentdb_data.documents_25001;
LOG:  Vacuum[index=xxx,vacuumCleanup=1] emptyEntryPages=0, emptyEntries=0, emptyPostingTrees=1, prunedEntries=0, prunedPages=0,prunedPostingTrees=0, postingPagesDeleted=0, emptyPostingPages=2, numBacktracks=0, isNewBulkDelete=1, numEntryPages=1, numDataPages=7, numVoidPages=15, fullScanPostingTreePrunes=0, targetedPostingTreePrunes=0, singlePassPostingTreePrunes=0, staleEmptyLeafRetries=0, cleanupRetryRuns=0, cleanupRetryPostingTrees=0, cleanupRetryPostingPagesDeleted=0, cleanupRetryEntryPagesPruned=0, cleanupRetryEntriesPruned=0
RESET client_min_messages;
-- Case 9: empty single-page posting roots allow entry-page pruning. Count
-- committed leaf-tuple removals and posting-root deletions as well as the
-- entry pages unlinked, without counting retained high keys as tuple removals.
SET documentdb_rum.enable_new_bulk_delete_inline_data_pages TO off;
SET documentdb_rum.enable_vacuum_cleanup_posting_tree_pruning TO on;
SET documentdb_rum.prune_rum_empty_pages TO off;
RESET documentdb_rum.data_page_posting_tree_size;
SELECT FORMAT('TRUNCATE documentdb_data.documents_%s;', :orphan_col) \gexec
TRUNCATE documentdb_data.documents_25001;
-- Grow the terms together so entry pages split before posting lists become trees.
SELECT count(documentdb_api.insert_one('pvacuum_orphan_db', 'orphan_test',
    FORMAT('{ "_id": %s, "a": "%s" }', (term - 1) * 2000 + i, repeat('k', 1000) || term)::bson))
FROM (SELECT term, i FROM generate_series(1, 20) AS term, generate_series(1, 2000) AS i
      ORDER BY i, term) AS input;
 count 
