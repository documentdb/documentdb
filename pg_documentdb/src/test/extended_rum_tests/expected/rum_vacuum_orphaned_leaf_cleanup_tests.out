-- Case 11: single-page posting roots can also precede the entry leaves that
-- reference them. Count their deletion even when the whole entry leaf is unlinked.
SET documentdb_rum.enable_vacuum_cleanup_posting_tree_pruning TO off;
RESET documentdb_rum.data_page_posting_tree_size;
SELECT FORMAT('TRUNCATE documentdb_data.documents_%s;', :orphan_col) \gexec
TRUNCATE documentdb_data.documents_25001;
-- Finish each posting tree before starting the next term to avoid early entry splits.
SELECT count(documentdb_api.insert_one('pvacuum_orphan_db', 'orphan_test',
    FORMAT('{ "_id": %s, "a": "%s" }', (term - 1) * 2000 + i,
        'm' || lpad(term::text, 4, '0'))::bson))
FROM (SELECT term, i FROM generate_series(1, 20) AS term, generate_series(1, 2000) AS i
      ORDER BY term, i) AS input;
