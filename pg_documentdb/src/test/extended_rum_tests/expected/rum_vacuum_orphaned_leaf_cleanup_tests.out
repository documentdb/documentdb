-- ============================================================
-- Case 6: bulk delete runs. The isBulkDeleteSkipped gate stops the cleanup
-- phase from repeating a traversal ambulkdelete already did. That is only safe
-- if ambulkdelete itself re-arms leaves a previous cycle stranded, so with the
-- cleanup-phase pruning still switched off from case 5 the orphans left above
-- must be reclaimed by a VACUUM that does have dead tuples to remove.
-- ============================================================
-- Produce new dead tuples on the same term so ambulkdelete is called and walks
-- this posting tree again.
DO $$
BEGIN
    PERFORM documentdb_api.insert_one('pvacuum_orphan_db', 'orphan_test',
        FORMAT('{ "_id": %s, "a": 500 }', i)::bson) FROM generate_series(1, 200) AS i;

    PERFORM documentdb_api.delete('pvacuum_orphan_db',
        '{ "delete": "orphan_test", "deletes": [ { "q": { "_id": { "$gte": 1 } }, "limit": 0 } ]}');
END;
$$;
CALL documentdb_test_helpers.wait_for_vacuum_horizon();
SET client_min_messages TO LOG;
SELECT FORMAT('VACUUM (FREEZE ON, INDEX_CLEANUP ON, DISABLE_PAGE_SKIPPING ON, PARALLEL 0) documentdb_data.documents_%s;', :orphan_col) \gexec
VACUUM (FREEZE ON, INDEX_CLEANUP ON, DISABLE_PAGE_SKIPPING ON, PARALLEL 0) documentdb_data.documents_25001;
LOG:  Vacuum[index=xxx,vacuumCleanup=0] emptyEntryPages=1, emptyEntries=0, emptyPostingTrees=1, prunedEntries=0, prunedPages=0,prunedPostingTrees=0, postingPagesDeleted=15, emptyPostingPages=12, numBacktracks=0, isNewBulkDelete=1, numEntryPages=1, numDataPages=7, numVoidPages=15, fullScanPostingTreePrunes=0, targetedPostingTreePrunes=1, singlePassPostingTreePrunes=0, staleEmptyLeafRetries=11, cleanupRetryRuns=0, cleanupRetryPostingTrees=0, cleanupRetryPostingPagesDeleted=0, cleanupRetryEntryPagesPruned=0, cleanupRetryEntriesPruned=0
LOG:  Vacuum[index=xxx,vacuumCleanup=1] emptyEntryPages=0, emptyEntries=0, emptyPostingTrees=0, prunedEntries=0, prunedPages=0,prunedPostingTrees=0, postingPagesDeleted=0, emptyPostingPages=2, numBacktracks=0, isNewBulkDelete=1, numEntryPages=1, numDataPages=7, numVoidPages=15, fullScanPostingTreePrunes=0, targetedPostingTreePrunes=0, singlePassPostingTreePrunes=0, staleEmptyLeafRetries=0, cleanupRetryRuns=0, cleanupRetryPostingTrees=0, cleanupRetryPostingPagesDeleted=0, cleanupRetryEntryPagesPruned=0, cleanupRetryEntriesPruned=0
RESET client_min_messages;
SELECT pg_temp.count_orphaned_empty_leaves(:'orphan_index_name') AS orphans_after_bulkdel \gset
SELECT :orphans_after_bulkdel < :orphans_after_ff AS bulk_delete_reclaimed_stranded_leaves,
       :orphans_after_bulkdel AS bound_leaves_remaining_bulk_delete;
 bulk_delete_reclaimed_stranded_leaves | bound_leaves_remaining_bulk_delete 
---------------------------------------+------------------------------------
 t                                     |                                  2
(1 row)

SET documentdb_rum.enable_vacuum_cleanup_posting_tree_pruning TO on;
-- Case 7: bulk delete with the feature on must not count a cleanup retry.
SELECT FORMAT('TRUNCATE documentdb_data.documents_%s;', :orphan_col) \gexec
TRUNCATE documentdb_data.documents_25001;
CALL pg_temp.build_orphaned_posting_tree(:orphan_col);
CALL documentdb_test_helpers.wait_for_vacuum_horizon();
SET client_min_messages TO LOG;
SELECT FORMAT('VACUUM (FREEZE ON, INDEX_CLEANUP ON, DISABLE_PAGE_SKIPPING ON, PARALLEL 0) documentdb_data.documents_%s;', :orphan_col) \gexec
