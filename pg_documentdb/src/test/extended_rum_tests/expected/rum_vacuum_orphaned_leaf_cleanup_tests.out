-- Tests that rumvacuumcleanup prunes orphaned empty posting-tree leaves even
-- when ambulkdelete is not called (no dead TIDs in the heap).
--
-- The scenario: a weak-lock pruning algorithm (single-pass or targeted) skips
-- an empty leaf because it cannot acquire the target-page cleanup lock.
-- The workload then becomes read-only, so no further dead tuples are produced
-- and ambulkdelete is never called again. Without the fix those leaves persist
-- forever. With the fix rumvacuumcleanup, which always runs, reclaims them.
--
-- The contention is simulated deterministically with
-- vacuum_skip_prune_posting_tree_pages, which suppresses structural pruning in
-- exactly the same way a failed conditional cleanup lock would.
--
-- The later cases cover the gates on that behavior: no weak-lock algorithm
-- active, the enable_vacuum_cleanup_posting_tree_pruning feature flag off, and
-- a VACUUM that does call ambulkdelete.
--
-- Page-count queries compare counts rather than absolute numbers so the test is
-- stable across PostgreSQL versions and page layouts. The only absolute value
-- asserted is the residue of 2: a posting tree's leftmost and rightmost leaves
-- have an invalid left/right link, so rumDeletePage always refuses to unlink
-- them and they legitimately remain as empty leaves.
SET search_path TO documentdb_api_catalog, documentdb_core, public;
SET documentdb.next_collection_id TO 25000;
SET documentdb.next_collection_index_id TO 25000;
SELECT NOT current_setting('documentdb_rum.enable_vacuum_cleanup_posting_tree_pruning')::boolean
    AS cleanup_retry_disabled_by_default;
 cleanup_retry_disabled_by_default 
-----------------------------------
 t
(1 row)

-- Use the disk-ordered bulk delete path
SET documentdb_rum.enable_new_bulk_delete TO on;
SET documentdb_rum.enable_new_bulk_delete_inline_data_pages TO off;
SET documentdb_rum.enable_vacuum_cleanup_posting_tree_pruning TO on;
-- Enable single-pass, the first weak-lock algorithm under test
SET documentdb_rum.enable_single_pass_posting_tree_vacuum TO on;
SET documentdb_rum.enable_targeted_posting_tree_pruning TO off;
-- No other session reads this index. Recycle deleted pages immediately so
-- unrelated transactions cannot change the logged page-state counts.
SET documentdb_rum.skip_global_visibility_check_on_prune TO on;
SELECT documentdb_api.create_collection('pvacuum_orphan_db', 'orphan_test');
NOTICE:  creating collection
