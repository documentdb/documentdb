SET search_path TO documentdb_api_catalog, documentdb_core, public;
SET documentdb.next_collection_id TO 3300;
SET documentdb.next_collection_index_id TO 3300;
-- bson_subattr_support describes, to servers that ask
-- (SupportRequestSubattr), which parts of a document update_bson_document
-- may change and which part bson_extract_vector reads, so that an update
-- can skip evaluating a vector index it cannot affect.  That never changes
-- whether an update is HOT, only how much work deciding it takes; a wrong
-- answer, though, would lose index entries.  Servers built with assertions
-- evaluate the indexes anyway and fail the update if an answer was wrong.
-- And on every server, after updates touching and not touching the paths
-- the indexes use, every index must find what a sequential scan finds.
--
-- The collection has only expression indexes (vector and 2d); every other
-- DocumentDB index has the document itself as a column, which the server
-- never skips.  bson_validate_geometry (2d) is not described: it returns
-- the whole document.
-- the support function is attached where expected, and only there
SELECT p.proname, s.proname AS support
  FROM pg_proc p JOIN pg_proc s ON s.oid = p.prosupport
 WHERE s.proname = 'bson_subattr_support'
 ORDER BY 1, p.pronargs;
       proname        |       support        
----------------------+----------------------
 bson_extract_vector  | bson_subattr_support
 update_bson_document | bson_subattr_support
 update_bson_document | bson_subattr_support
(3 rows)

