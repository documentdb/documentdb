(1 row)

-- Each index's answer, then a sequential scan's: they must agree.
-- The vector index through $search: with one list and one probe it
-- returns every row it holds, nearest first; the documents that have a
-- vector "v", from the table.
CREATE TEMP TABLE via_index AS SELECT document FROM bson_aggregation_pipeline('subattr_db',
  '{ "aggregate": "subattr", "pipeline": [
    { "$search": { "cosmosSearch": { "vector": [ 0, 1, 1 ], "k": 200, "path": "v" } } } ], "cursor": {} }');
SELECT COUNT(*) AS rows, md5(string_agg(document->>'_id', ',' ORDER BY (document->>'_id')::int)) AS ids
  FROM via_index;
 rows |               ids                
------+----------------------------------
  100 | c19b8f199318cb3d62203faa50450afb
(1 row)

