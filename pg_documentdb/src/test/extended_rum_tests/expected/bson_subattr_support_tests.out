SELECT documentdb_api_internal.create_indexes_non_concurrently('subattr_db',
  '{ "createIndexes": "subattr", "indexes": [
     { "key": { "v": "cosmosSearch" }, "name": "v_ivf",
       "cosmosSearchOptions": { "kind": "vector-ivf", "numLists": 1, "similarity": "L2", "dimensions": 3 } },
     { "key": { "loc": "2d" }, "name": "loc_2d" } ] }', TRUE);
