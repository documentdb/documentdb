SELECT FORMAT('ALTER TABLE documentdb_data.documents_%s SET (fillfactor = 10, autovacuum_enabled = off)', :sa_col) \gexec
ALTER TABLE documentdb_data.documents_3301 SET (fillfactor = 10, autovacuum_enabled = off)
