DROP TABLE via_index;
EXPLAIN (COSTS OFF) SELECT document FROM bson_aggregation_pipeline('subattr_db', '{ "aggregate": "subattr", "pipeline": [
    { "$search": { "cosmosSearch": { "vector": [ 0, 1, 1 ], "k": 200, "path": "v" } } } ], "cursor": {} }');
                                                               QUERY PLAN                                                                
-----------------------------------------------------------------------------------------------------------------------------------------
 Subquery Scan on agg_stage_0
   ->  Limit
         ->  Custom Scan (DocumentDBApiQueryScan)
               CosmosSearch Custom Params: { "nProbes" : 1 }
               ->  Index Scan using v_ivf on documents_3301 collection
                     Order By: (vector(documentdb_api_internal.bson_extract_vector(document, 'v'::text), 3, true) <-> '[0,1,1]'::vector)
(6 rows)

-- the 2d index through its own expression and predicate
SELECT FORMAT($$SELECT COUNT(*) FROM documentdb_data.documents_%s
  WHERE documentdb_api_catalog.bson_validate_geometry(document, 'loc'::text) IS NOT NULL
    AND documentdb_api_catalog.bson_validate_geometry(document, 'loc'::text) OPERATOR(documentdb_api_catalog.@|-|)
        '{ "loc": { "$box": [ [ 0, 0 ], [ 5, 5 ] ] } }'::documentdb_core.bson$$, :sa_col) AS gq \gset
BEGIN;
SET LOCAL enable_seqscan TO off;
SELECT FORMAT('EXPLAIN (COSTS OFF) %s', :'gq') \gexec
EXPLAIN (COSTS OFF) SELECT COUNT(*) FROM documentdb_data.documents_3301
  WHERE documentdb_api_catalog.bson_validate_geometry(document, 'loc'::text) IS NOT NULL
    AND documentdb_api_catalog.bson_validate_geometry(document, 'loc'::text) OPERATOR(documentdb_api_catalog.@|-|)
        '{ "loc": { "$box": [ [ 0, 0 ], [ 5, 5 ] ] } }'::documentdb_core.bson
                                                                                                         QUERY PLAN                                                                                                         
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Aggregate
   ->  Bitmap Heap Scan on documents_3301
         Recheck Cond: (bson_validate_geometry(document, 'loc'::text) @|-| '{ "loc" : { "$box" : [ [ { "$numberInt" : "0" }, { "$numberInt" : "0" } ], [ { "$numberInt" : "5" }, { "$numberInt" : "5" } ] ] } }'::bson)
         ->  Bitmap Index Scan on loc_2d
               Index Cond: (bson_validate_geometry(document, 'loc'::text) @|-| '{ "loc" : { "$box" : [ [ { "$numberInt" : "0" }, { "$numberInt" : "0" } ], [ { "$numberInt" : "5" }, { "$numberInt" : "5" } ] ] } }'::bson)
(5 rows)

SELECT :'gq' \gexec
