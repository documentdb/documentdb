--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 { "raw" : { "defaultShard" : { "numIndexesBefore" : { "$numberInt" : "1" }, "numIndexesAfter" : { "$numberInt" : "3" }, "createdCollectionAutomatically" : false, "ok" : { "$numberInt" : "1" } } }, "ok" : { "$numberInt" : "1" } }
(1 row)

-- Not touching what the indexes read.  The server skips the vector index
-- (it reads only "v"); it still evaluates the 2d index, whose datum is
-- the whole document, so these updates are not HOT on any server.
SELECT documentdb_api.update('subattr_db', '{ "update": "subattr", "updates": [
  { "q": {}, "u": { "$inc": { "n": 1 }, "$set": { "w.v": [ 4, 5, 6 ] } }, "multi": true } ] }');
                                                                 update                                                                 
----------------------------------------------------------------------------------------------------------------------------------------
 ("{ ""ok"" : { ""$numberDouble"" : ""1.0"" }, ""nModified"" : { ""$numberInt"" : ""120"" }, ""n"" : { ""$numberInt"" : ""120"" } }",t)
(1 row)

-- Touching them: by name, by position, by renaming onto and away from them.
-- The last fails (a fourth dimension): the vector index was evaluated.
SELECT documentdb_api.update('subattr_db', '{ "update": "subattr", "updates": [
  { "q": { "_id": { "$lte": 10 } }, "u": { "$set": { "v": [ 9, 9, 9 ] } }, "multi": true },
  { "q": { "_id": { "$gt": 10, "$lte": 20 } }, "u": { "$set": { "v.1": 8 } }, "multi": true },
  { "q": { "_id": { "$gt": 20, "$lte": 30 } }, "u": { "$unset": { "v": 1 } }, "multi": true },
  { "q": { "_id": { "$gt": 30, "$lte": 40 } }, "u": { "$rename": { "w.v": "v" } }, "multi": true },
  { "q": { "_id": { "$gt": 40, "$lte": 50 } }, "u": { "$rename": { "v": "vv" } }, "multi": true },
  { "q": { "_id": { "$gt": 50, "$lte": 60 } }, "u": { "$set": { "loc": [ 1, 1 ] } }, "multi": true },
  { "q": { "_id": { "$gt": 60, "$lte": 70 } }, "u": { "$set": { "loc.0": 2 } }, "multi": true },
  { "q": { "_id": { "$gt": 70, "$lte": 80 } }, "u": { "$push": { "v": 1 } }, "multi": true } ] }');
                                                                                                                                             update                                                                                                                                             
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 ("{ ""ok"" : { ""$numberDouble"" : ""1.0"" }, ""nModified"" : { ""$numberInt"" : ""70"" }, ""n"" : { ""$numberInt"" : ""70"" }, ""writeErrors"" : [ { ""index"" : { ""$numberInt"" : ""7"" }, ""code"" : { ""$numberInt"" : ""130"" }, ""errmsg"" : ""expected 3 dimensions, not 4"" } ] }",f)
(1 row)

-- one at a time (updateOne), not touching the indexes
SELECT COUNT(documentdb_api.update('subattr_db', FORMAT('{ "update": "subattr", "updates": [
  { "q": { "_id": %s }, "u": { "$set": { "n": %s } } } ] }', i, i)::bson))
  FROM generate_series(101, 110) i;
 count 
