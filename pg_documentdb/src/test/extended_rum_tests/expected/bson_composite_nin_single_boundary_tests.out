            "d": { "$nin": [2, 4] }
        }
    }',
    '{
        "find": "skip_scan_interactions",
        "filter": {
            "a": { "$in": [2, 9] },
            "c": { "$gt": 1, "$lt": 6 },
            "d": { "$nin": [2, 4] }
        },
        "hint": { "$natural": 1 }
    }',
    ARRAY(
        SELECT a * 1000 + b * 10 + c
        FROM unnest(ARRAY[2, 9]) a,
             generate_series(1, 10) b,
             unnest(ARRAY[3, 5]) c
        ORDER BY 1));
