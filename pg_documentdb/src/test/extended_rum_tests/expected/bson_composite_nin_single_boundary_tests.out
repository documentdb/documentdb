SET documentdb.enable_single_boundary_for_dollar_not_in TO off;
CREATE TEMP TABLE nin_guc_empty_disabled_results AS
SELECT document FROM bson_aggregation_find(
    'nin_guc_db',
    '{ "find": "mkp", "filter": { "a.b": { "$nin": [] } }, "hint": "ab_ac_1" }');
SET documentdb.enable_single_boundary_for_dollar_not_in TO on;
CREATE TEMP TABLE nin_guc_empty_enabled_results AS
SELECT document FROM bson_aggregation_find(
    'nin_guc_db',
    '{ "find": "mkp", "filter": { "a.b": { "$nin": [] } }, "hint": "ab_ac_1" }');
CREATE TEMP TABLE nin_guc_empty_runtime_results AS
SELECT document FROM bson_aggregation_find(
    'nin_guc_db',
    '{ "find": "mkp", "filter": { "a.b": { "$nin": [] } }, "hint": { "$natural": 1 } }');
DO $$
BEGIN
    IF EXISTS (
        SELECT document::text FROM nin_guc_empty_disabled_results
        EXCEPT ALL
        SELECT document::text FROM nin_guc_empty_runtime_results
    ) OR EXISTS (
        SELECT document::text FROM nin_guc_empty_runtime_results
        EXCEPT ALL
        SELECT document::text FROM nin_guc_empty_disabled_results
    ) OR EXISTS (
        SELECT document::text FROM nin_guc_empty_enabled_results
        EXCEPT ALL
        SELECT document::text FROM nin_guc_empty_runtime_results
    ) OR EXISTS (
        SELECT document::text FROM nin_guc_empty_runtime_results
        EXCEPT ALL
        SELECT document::text FROM nin_guc_empty_enabled_results
    ) THEN
        RAISE EXCEPTION '$nin: [] returned different indexed and runtime results';
    END IF;
END;
$$;
SELECT
    'mkp empty predicate' AS test_case,
    (SELECT array_agg((document ->> '_id')::int ORDER BY (document ->> '_id')::int)
     FROM nin_guc_empty_disabled_results) AS disabled_ids,
    (SELECT array_agg((document ->> '_id')::int ORDER BY (document ->> '_id')::int)
     FROM nin_guc_empty_enabled_results) AS enabled_ids,
    (SELECT array_agg((document ->> '_id')::int ORDER BY (document ->> '_id')::int)
     FROM nin_guc_empty_runtime_results) AS runtime_ids;
