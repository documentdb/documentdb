SET documentdb.enable_single_boundary_for_dollar_not_in TO off;
CREATE TEMP TABLE nin_guc_collation_disabled_results AS
SELECT document FROM bson_aggregation_find(
    'nin_guc_db',
    '{
        "find": "collated",
        "filter": { "a": { "$nin": ["apple", "cherry"] } },
        "collation": { "locale": "en", "strength": 1 },
        "hint": "a_en_s1"
    }');
SET documentdb.enable_single_boundary_for_dollar_not_in TO on;
CREATE TEMP TABLE nin_guc_collation_enabled_results AS
SELECT document FROM bson_aggregation_find(
    'nin_guc_db',
    '{
        "find": "collated",
        "filter": { "a": { "$nin": ["apple", "cherry"] } },
        "collation": { "locale": "en", "strength": 1 },
        "hint": "a_en_s1"
    }');
SELECT
    'collation' AS test_case,
    (SELECT array_agg((document ->> '_id')::int ORDER BY (document ->> '_id')::int)
     FROM nin_guc_collation_disabled_results) AS disabled_ids,
    (SELECT array_agg((document ->> '_id')::int ORDER BY (document ->> '_id')::int)
     FROM nin_guc_collation_enabled_results) AS enabled_ids,
    NOT EXISTS (
        SELECT document::text FROM nin_guc_collation_disabled_results
        EXCEPT ALL
        SELECT document::text FROM nin_guc_collation_enabled_results
    ) AND NOT EXISTS (
        SELECT document::text FROM nin_guc_collation_enabled_results
        EXCEPT ALL
        SELECT document::text FROM nin_guc_collation_disabled_results
    ) AS results_match;
 test_case | disabled_ids | enabled_ids | results_match 
-----------+--------------+-------------+---------------
 collation | {4,5,6}      | {4,5,6}     | t
(1 row)

