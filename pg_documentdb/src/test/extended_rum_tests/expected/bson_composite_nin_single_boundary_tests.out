SET search_path TO documentdb_api,documentdb_core,documentdb_api_catalog;
SET documentdb.next_collection_id TO 2500;
SET documentdb.next_collection_index_id TO 2500;
SET documentdb.defaultUseCompositeOpClass TO on;
SET documentdb.enableCompositeIndexPlanner TO on;
SET documentdb.enableIndexMetadataGlobalTracking TO on;
SET documentdb.enable_failure_on_parallel_index_arrays_for_metadata_tracking TO off;
SET documentdb_core.enableCollation TO on;
SET documentdb.enableCollationWithNonUniqueOrderedIndexes TO on;
CREATE SCHEMA nin_guc_test;
CREATE FUNCTION nin_guc_test.assert_same_results(
    label text,
    database_name text,
    find_spec documentdb_core.bson)
RETURNS TABLE(test_case text, disabled_ids int[], enabled_ids int[])
LANGUAGE plpgsql
AS $$
DECLARE
    guc_disabled_ids int[];
    guc_enabled_ids int[];
    disabled_only bigint;
    enabled_only bigint;
BEGIN
    PERFORM set_config('client_min_messages', 'warning', true);
    DROP TABLE IF EXISTS nin_guc_disabled_results;
    DROP TABLE IF EXISTS nin_guc_enabled_results;
    PERFORM set_config('client_min_messages', 'notice', true);

    PERFORM set_config(
        'documentdb.enable_single_boundary_for_dollar_not_in', 'off', false);
    CREATE TEMP TABLE nin_guc_disabled_results AS
    SELECT document FROM bson_aggregation_find(database_name, find_spec);

    PERFORM set_config(
        'documentdb.enable_single_boundary_for_dollar_not_in', 'on', false);
    CREATE TEMP TABLE nin_guc_enabled_results AS
    SELECT document FROM bson_aggregation_find(database_name, find_spec);

    SELECT count(*) INTO disabled_only FROM (
        SELECT document::text FROM nin_guc_disabled_results
        EXCEPT ALL
        SELECT document::text FROM nin_guc_enabled_results
    ) results;

    SELECT count(*) INTO enabled_only FROM (
        SELECT document::text FROM nin_guc_enabled_results
        EXCEPT ALL
        SELECT document::text FROM nin_guc_disabled_results
    ) results;

    SELECT array_agg((document ->> '_id')::int ORDER BY (document ->> '_id')::int)
    INTO guc_disabled_ids
    FROM nin_guc_disabled_results;

    SELECT array_agg((document ->> '_id')::int ORDER BY (document ->> '_id')::int)
    INTO guc_enabled_ids
    FROM nin_guc_enabled_results;

    guc_disabled_ids := COALESCE(guc_disabled_ids, '{}');
    guc_enabled_ids := COALESCE(guc_enabled_ids, '{}');

    IF disabled_only <> 0 OR enabled_only <> 0 THEN
        RAISE EXCEPTION
            '% returned different results: disabled-only=%, enabled-only=%',
            label, disabled_only, enabled_only;
    END IF;

    DROP TABLE nin_guc_disabled_results;
    DROP TABLE nin_guc_enabled_results;

    RETURN QUERY SELECT label, guc_disabled_ids, guc_enabled_ids;
END;
$$;
CREATE FUNCTION nin_guc_test.assert_same_results_with_runtime(
    label text,
    database_name text,
    indexed_find_spec documentdb_core.bson,
    runtime_find_spec documentdb_core.bson,
    expected_ids int[])
RETURNS TABLE(
    test_case text,
    disabled_ids int[],
    enabled_ids int[],
    runtime_ids int[])
LANGUAGE plpgsql
AS $$
DECLARE
    guc_disabled_ids int[];
    guc_enabled_ids int[];
    runtime_result_ids int[];
BEGIN
    PERFORM set_config('client_min_messages', 'warning', true);
    DROP TABLE IF EXISTS nin_guc_disabled_results;
    DROP TABLE IF EXISTS nin_guc_enabled_results;
    DROP TABLE IF EXISTS nin_runtime_results;
    PERFORM set_config('client_min_messages', 'notice', true);

    PERFORM set_config(
        'documentdb.enable_single_boundary_for_dollar_not_in', 'off', false);
    CREATE TEMP TABLE nin_guc_disabled_results AS
    SELECT document FROM bson_aggregation_find(database_name, indexed_find_spec);

    PERFORM set_config(
        'documentdb.enable_single_boundary_for_dollar_not_in', 'on', false);
    CREATE TEMP TABLE nin_guc_enabled_results AS
    SELECT document FROM bson_aggregation_find(database_name, indexed_find_spec);

    CREATE TEMP TABLE nin_runtime_results AS
    SELECT document FROM bson_aggregation_find(database_name, runtime_find_spec);

    SELECT array_agg((document ->> '_id')::int ORDER BY (document ->> '_id')::int)
    INTO guc_disabled_ids
    FROM nin_guc_disabled_results;

    SELECT array_agg((document ->> '_id')::int ORDER BY (document ->> '_id')::int)
    INTO guc_enabled_ids
    FROM nin_guc_enabled_results;

    SELECT array_agg((document ->> '_id')::int ORDER BY (document ->> '_id')::int)
    INTO runtime_result_ids
    FROM nin_runtime_results;

    guc_disabled_ids := COALESCE(guc_disabled_ids, '{}');
    guc_enabled_ids := COALESCE(guc_enabled_ids, '{}');
    runtime_result_ids := COALESCE(runtime_result_ids, '{}');

    IF EXISTS (
        SELECT document::text FROM nin_guc_disabled_results
        EXCEPT ALL
        SELECT document::text FROM nin_runtime_results
    ) OR EXISTS (
        SELECT document::text FROM nin_runtime_results
        EXCEPT ALL
        SELECT document::text FROM nin_guc_disabled_results
    ) OR EXISTS (
        SELECT document::text FROM nin_guc_enabled_results
        EXCEPT ALL
        SELECT document::text FROM nin_runtime_results
    ) OR EXISTS (
        SELECT document::text FROM nin_runtime_results
        EXCEPT ALL
        SELECT document::text FROM nin_guc_enabled_results
    ) THEN
        RAISE EXCEPTION '% returned different indexed and runtime results', label;
    END IF;

    IF runtime_result_ids IS DISTINCT FROM expected_ids THEN
        RAISE EXCEPTION
            '% returned unexpected IDs: expected=%, actual=%',
            label, expected_ids, runtime_result_ids;
    END IF;

    DROP TABLE nin_guc_disabled_results;
    DROP TABLE nin_guc_enabled_results;
    DROP TABLE nin_runtime_results;

    RETURN QUERY
    SELECT label, guc_disabled_ids, guc_enabled_ids, runtime_result_ids;
END;
$$;
CREATE FUNCTION nin_guc_test.assert_ordered_results_with_runtime(
    label text,
    database_name text,
    indexed_find_spec documentdb_core.bson,
    runtime_find_spec documentdb_core.bson)
RETURNS TABLE(
    test_case text,
    disabled_ids int[],
    enabled_ids int[],
    runtime_ids int[])
LANGUAGE plpgsql
AS $$
DECLARE
    guc_disabled_ids int[];
    guc_enabled_ids int[];
    runtime_result_ids int[];
BEGIN
    PERFORM set_config('client_min_messages', 'warning', true);
    DROP TABLE IF EXISTS nin_ordered_disabled_results;
    DROP TABLE IF EXISTS nin_ordered_enabled_results;
    DROP TABLE IF EXISTS nin_ordered_runtime_results;
    PERFORM set_config('client_min_messages', 'notice', true);

    PERFORM set_config(
        'documentdb.enable_single_boundary_for_dollar_not_in', 'off', false);
    CREATE TEMP TABLE nin_ordered_disabled_results AS
    SELECT document FROM bson_aggregation_find(database_name, indexed_find_spec);
    ALTER TABLE nin_ordered_disabled_results ADD COLUMN result_order bigserial;

    PERFORM set_config(
        'documentdb.enable_single_boundary_for_dollar_not_in', 'on', false);
    CREATE TEMP TABLE nin_ordered_enabled_results AS
    SELECT document FROM bson_aggregation_find(database_name, indexed_find_spec);
    ALTER TABLE nin_ordered_enabled_results ADD COLUMN result_order bigserial;

    CREATE TEMP TABLE nin_ordered_runtime_results AS
    SELECT document FROM bson_aggregation_find(database_name, runtime_find_spec);
    ALTER TABLE nin_ordered_runtime_results ADD COLUMN result_order bigserial;

    IF EXISTS (
        SELECT result_order, document::text FROM nin_ordered_disabled_results
        EXCEPT ALL
        SELECT result_order, document::text FROM nin_ordered_runtime_results
    ) OR EXISTS (
        SELECT result_order, document::text FROM nin_ordered_runtime_results
        EXCEPT ALL
        SELECT result_order, document::text FROM nin_ordered_disabled_results
    ) OR EXISTS (
        SELECT result_order, document::text FROM nin_ordered_enabled_results
        EXCEPT ALL
        SELECT result_order, document::text FROM nin_ordered_runtime_results
    ) OR EXISTS (
        SELECT result_order, document::text FROM nin_ordered_runtime_results
        EXCEPT ALL
        SELECT result_order, document::text FROM nin_ordered_enabled_results
    ) THEN
        RAISE EXCEPTION '% returned different indexed and runtime ordering', label;
    END IF;

    SELECT array_agg((document ->> '_id')::int ORDER BY result_order)
    INTO guc_disabled_ids
    FROM nin_ordered_disabled_results;

    SELECT array_agg((document ->> '_id')::int ORDER BY result_order)
    INTO guc_enabled_ids
    FROM nin_ordered_enabled_results;

    SELECT array_agg((document ->> '_id')::int ORDER BY result_order)
    INTO runtime_result_ids
    FROM nin_ordered_runtime_results;

    DROP TABLE nin_ordered_disabled_results;
    DROP TABLE nin_ordered_enabled_results;
    DROP TABLE nin_ordered_runtime_results;

    RETURN QUERY
    SELECT label, guc_disabled_ids, guc_enabled_ids, runtime_result_ids;
END;
$$;
CREATE FUNCTION nin_guc_test.assert_high_key_results_with_runtime(
    label text,
    database_name text,
    indexed_find_spec documentdb_core.bson,
    runtime_find_spec documentdb_core.bson,
    expected_count bigint)
RETURNS TABLE(
    test_case text,
    disabled_count bigint,
    enabled_count bigint,
    runtime_count bigint)
LANGUAGE plpgsql
AS $$
DECLARE
    high_key_disabled_count bigint;
    high_key_enabled_count bigint;
    runtime_result_count bigint;
BEGIN
    PERFORM set_config('client_min_messages', 'warning', true);
    DROP TABLE IF EXISTS nin_high_key_disabled_results;
    DROP TABLE IF EXISTS nin_high_key_enabled_results;
    DROP TABLE IF EXISTS nin_high_key_runtime_results;
    PERFORM set_config('client_min_messages', 'notice', true);

    PERFORM set_config(
        'documentdb.enable_single_boundary_for_dollar_not_in', 'on', false);
    PERFORM set_config('documentdb.enable_high_key_optimization', 'off', false);
    CREATE TEMP TABLE nin_high_key_disabled_results AS
    SELECT document FROM bson_aggregation_find(database_name, indexed_find_spec);
    ALTER TABLE nin_high_key_disabled_results ADD COLUMN result_order bigserial;

    PERFORM set_config('documentdb.enable_high_key_optimization', 'on', false);
    CREATE TEMP TABLE nin_high_key_enabled_results AS
    SELECT document FROM bson_aggregation_find(database_name, indexed_find_spec);
    ALTER TABLE nin_high_key_enabled_results ADD COLUMN result_order bigserial;

    CREATE TEMP TABLE nin_high_key_runtime_results AS
    SELECT document FROM bson_aggregation_find(database_name, runtime_find_spec);
    ALTER TABLE nin_high_key_runtime_results ADD COLUMN result_order bigserial;

    SELECT count(*) INTO high_key_disabled_count
    FROM nin_high_key_disabled_results;
    SELECT count(*) INTO high_key_enabled_count
    FROM nin_high_key_enabled_results;
    SELECT count(*) INTO runtime_result_count
    FROM nin_high_key_runtime_results;

    IF EXISTS (
        SELECT result_order, document::text FROM nin_high_key_disabled_results
        EXCEPT ALL
        SELECT result_order, document::text FROM nin_high_key_runtime_results
    ) OR EXISTS (
        SELECT result_order, document::text FROM nin_high_key_runtime_results
        EXCEPT ALL
        SELECT result_order, document::text FROM nin_high_key_disabled_results
    ) OR EXISTS (
        SELECT result_order, document::text FROM nin_high_key_enabled_results
        EXCEPT ALL
        SELECT result_order, document::text FROM nin_high_key_runtime_results
    ) OR EXISTS (
        SELECT result_order, document::text FROM nin_high_key_runtime_results
        EXCEPT ALL
        SELECT result_order, document::text FROM nin_high_key_enabled_results
    ) THEN
        RAISE EXCEPTION '% returned different high-key and runtime results', label;
    END IF;

    IF runtime_result_count IS DISTINCT FROM expected_count THEN
        RAISE EXCEPTION
            '% returned unexpected count: expected=%, actual=%',
            label, expected_count, runtime_result_count;
    END IF;

    DROP TABLE nin_high_key_disabled_results;
    DROP TABLE nin_high_key_enabled_results;
    DROP TABLE nin_high_key_runtime_results;

    RETURN QUERY
    SELECT label, high_key_disabled_count, high_key_enabled_count,
           runtime_result_count;
END;
$$;
