SET documentdb.enable_single_boundary_for_dollar_not_in TO on;
SET documentdb.enable_high_key_optimization TO on;
SELECT BOOL_OR(explain_line LIKE '%scanType: ordered%') AND
       NOT BOOL_OR(explain_line ~ 'highKeyEligiblePages: [1-9][0-9]* pages')
       AS leading_nin_blocks_high_key
FROM documentdb_test_helpers.run_explain_and_trim($cmd$
    EXPLAIN (ANALYZE ON, COSTS OFF, BUFFERS OFF, SUMMARY OFF, TIMING OFF)
    SELECT document FROM bson_aggregation_find(
        'nin_guc_db',
        '{
            "find": "high_key_nin",
            "filter": { "b": { "$nin": [100, 200] } },
            "sort": { "b": 1, "a": 1 },
            "hint": "b_a_1"
        }')
$cmd$) explain_line;
 leading_nin_blocks_high_key 
-----------------------------
 t
(1 row)

SELECT BOOL_OR(explain_line ~ 'highKeyEligiblePages: [1-9][0-9]* pages')
