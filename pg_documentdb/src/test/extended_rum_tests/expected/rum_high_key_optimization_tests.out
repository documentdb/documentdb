         namespaceName: highkeydb.single_key
         indexName: a_1
         indexKey: {"a": 1}
         isMultiKey: false
         indexBounds: ["a": [4000, Infinity]]
         innerScanLoops: 1001 loops
         highKeyEligiblePages: 6 pages
         scanType: ordered
         scanKeyDetails: key 1: [(isInequality: true, estimatedEntryCount: 1001)]
         ->  Bitmap Heap Scan on documents_22001 collection (actual rows=1001 loops=1)
               Recheck Cond: (document @>= '{ "a" : { "$numberInt" : "4000" } }'::bson)
               Heap Blocks: exact=11
               ->  Bitmap Index Scan on a_1 (actual rows=1001 loops=1)
                     Index Cond: (document @>= '{ "a" : { "$numberInt" : "4000" } }'::bson)
(18 rows)

-- Forward scan that terminates partway through the index ("a <= 2500"): only the
-- pages whose high key still satisfies the bound are eligible.
SELECT documentdb_test_helpers.run_explain_and_trim( $cmd$
EXPLAIN (COSTS OFF, ANALYZE ON, VERBOSE OFF, BUFFERS OFF, SUMMARY OFF, TIMING OFF)
    SELECT document FROM bson_aggregation_find('highkeydb', '{ "find": "single_key", "filter": { "a": { "$lte": 2500 } }, "sort": { "a": 1 } }'::bson) $cmd$);
                                    run_explain_and_trim                                    
--------------------------------------------------------------------------------------------
 Sort (actual rows=2500 loops=1)
   Sort Key: (bson_orderby(document, '{ "a" : { "$numberInt" : "1" } }'::bson)) NULLS FIRST
   Sort Method: quicksort  Memory: xxxkB
   ->  Custom Scan (DocumentDBApiExplainQueryScan) (actual rows=2500 loops=1)
         namespaceName: highkeydb.single_key
         indexName: a_1
         indexKey: {"a": 1}
         isMultiKey: false
         indexBounds: ["a": [-Infinity, 2500]]
         innerScanLoops: 2501 loops
         highKeyEligiblePages: 16 pages
         scanType: ordered
         scanKeyDetails: key 1: [(isInequality: true, estimatedEntryCount: 2500)]
         ->  Bitmap Heap Scan on documents_22001 collection (actual rows=2500 loops=1)
               Recheck Cond: (document @<= '{ "a" : { "$numberInt" : "2500" } }'::bson)
               Heap Blocks: exact=26
               ->  Bitmap Index Scan on a_1 (actual rows=2500 loops=1)
                     Index Cond: (document @<= '{ "a" : { "$numberInt" : "2500" } }'::bson)
(18 rows)

-- Bounded range on both sides.
SELECT documentdb_test_helpers.run_explain_and_trim( $cmd$
EXPLAIN (COSTS OFF, ANALYZE ON, VERBOSE OFF, BUFFERS OFF, SUMMARY OFF, TIMING OFF)
    SELECT document FROM bson_aggregation_find('highkeydb', '{ "find": "single_key", "filter": { "a": { "$gt": 1000, "$lt": 2000 } }, "sort": { "a": 1 } }'::bson) $cmd$);
                                                             run_explain_and_trim                                                              
-----------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (DocumentDBApiExplainQueryScan) (actual rows=999 loops=1)
   namespaceName: highkeydb.single_key
   indexName: a_1
   indexKey: {"a": 1}
   isMultiKey: false
   indexBounds: ["a": (1000, 2000)]
   innerScanLoops: 1002 loops
   highKeyEligiblePages: 6 pages
   scanType: ordered
   scanKeyDetails: key 1: [(isInequality: true, estimatedEntryCount: 999)]
   ->  Index Scan using a_1 on documents_22001 collection (actual rows=999 loops=1)
         Index Cond: ((document @> '{ "a" : { "$numberInt" : "1000" } }'::bson) AND (document @< '{ "a" : { "$numberInt" : "2000" } }'::bson))
         Order By: (document |-<> '{ "a" : { "$numberInt" : "1" } }'::bson)
(13 rows)

-- Equality match resolves to a regular (non-ordered) scan, so the optimization
-- does not apply and no highKeyEligiblePages counter is emitted.
SELECT documentdb_test_helpers.run_explain_and_trim( $cmd$
EXPLAIN (COSTS OFF, ANALYZE ON, VERBOSE OFF, BUFFERS OFF, SUMMARY OFF, TIMING OFF)
    SELECT document FROM bson_aggregation_find('highkeydb', '{ "find": "single_key", "filter": { "a": { "$eq": 100 } }, "sort": { "a": 1 } }'::bson) $cmd$);
                                    run_explain_and_trim                                    
--------------------------------------------------------------------------------------------
 Sort (actual rows=1 loops=1)
   Sort Key: (bson_orderby(document, '{ "a" : { "$numberInt" : "1" } }'::bson)) NULLS FIRST
   Sort Method: quicksort  Memory: xxxkB
   ->  Custom Scan (DocumentDBApiExplainQueryScan) (actual rows=1 loops=1)
         namespaceName: highkeydb.single_key
         indexName: a_1
         indexKey: {"a": 1}
         isMultiKey: false
         indexBounds: ["a": [100, 100]]
         innerScanLoops: 1 loops
         scanType: regular
         scanKeyDetails: key 1: [(isInequality: false, estimatedEntryCount: 1)]
         ->  Bitmap Heap Scan on documents_22001 collection (actual rows=1 loops=1)
               Recheck Cond: (document @= '{ "a" : { "$numberInt" : "100" } }'::bson)
               Heap Blocks: exact=1
               ->  Bitmap Index Scan on a_1 (actual rows=1 loops=1)
                     Index Cond: (document @= '{ "a" : { "$numberInt" : "100" } }'::bson)
(17 rows)

