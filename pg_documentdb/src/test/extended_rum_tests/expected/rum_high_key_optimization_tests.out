   Sort Method: quicksort  Memory: xxxkB
   ->  Custom Scan (DocumentDBApiExplainQueryScan) (actual rows=5000 loops=1)
         namespaceName: highkeydb.single_key
         indexName: a_1
         indexKey: {"a": 1}
         isMultiKey: false
         indexBounds: ["a": [-Infinity, 5000]]
         innerScanLoops: 5000 loops
         highKeyEligiblePages: 33 pages
         scanType: ordered
         scanKeyDetails: key 1: [(isInequality: true, estimatedEntryCount: 5000)]
         ->  Bitmap Heap Scan on documents_22001 collection (actual rows=5000 loops=1)
               Recheck Cond: (document @<= '{ "a" : { "$numberInt" : "5000" } }'::bson)
               Heap Blocks: exact=52
               ->  Bitmap Index Scan on a_1 (actual rows=5000 loops=1)
                     Index Cond: (document @<= '{ "a" : { "$numberInt" : "5000" } }'::bson)
(18 rows)

-- Selective forward scan (only the tail of the index matches): fewer eligible
-- pages, matching the smaller number of leaf pages crossed.
SELECT documentdb_test_helpers.run_explain_and_trim( $cmd$
EXPLAIN (COSTS OFF, ANALYZE ON, VERBOSE OFF, BUFFERS OFF, SUMMARY OFF, TIMING OFF)
    SELECT document FROM bson_aggregation_find('highkeydb', '{ "find": "single_key", "filter": { "a": { "$gte": 4000 } }, "sort": { "a": 1 } }'::bson) $cmd$);
                                    run_explain_and_trim                                    
--------------------------------------------------------------------------------------------
