   ->  GroupAggregate (actual rows=16 loops=1)
         Output: bson_repath_and_build('_id'::text, bson_repath_and_build('assetCode'::text, (bson_expression_get(collection.document, '{ "" : "$assetCode" }'::bson, true, '{ "now" : NOW_SYS_VARIABLE }'::bson)), 'effectiveAt'::text, (bson_expression_get(collection.document, '{ "" : "$effectiveAt" }'::bson, true, '{ "now" : NOW_SYS_VARIABLE }'::bson))), 'selected'::text, bsonfirstwithexprinternal(collection.document, '{ "" : "$$ROOT" }'::bson, '{ "now" : NOW_SYS_VARIABLE }'::bson, NULL::text ORDER BY (bson_orderby(collection.document, '{ "recordedAt" : { "$numberInt" : "-1" } }'::bson)) USING >>> NULLS LAST)), (bson_expression_get(collection.document, '{ "" : "$assetCode" }'::bson, true, '{ "now" : NOW_SYS_VARIABLE }'::bson)), (bson_expression_get(collection.document, '{ "" : "$effectiveAt" }'::bson, true, '{ "now" : NOW_SYS_VARIABLE }'::bson))
         Group Key: bson_expression_get(collection.document, '{ "" : "$assetCode" }'::bson, true, '{ "now" : NOW_SYS_VARIABLE }'::bson), bson_expression_get(collection.document, '{ "" : "$effectiveAt" }'::bson, true, '{ "now" : NOW_SYS_VARIABLE }'::bson)
