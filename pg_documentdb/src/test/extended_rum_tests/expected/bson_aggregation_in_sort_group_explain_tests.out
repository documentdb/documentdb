               isMultiKey: false
               indexBounds: ["assetCode": ["asset-0", "asset-0"], "effectiveAt": DESC[{ "$date" : { "$numberLong" : "-9223372036854775808" } }, { "$date" : "2024-01-04T00:00:00Z" }], "recordedAt": DESC(MinKey, MaxKey)], ["assetCode": ["asset-1", "asset-1"], "effectiveAt": DESC[{ "$date" : { "$numberLong" : "-9223372036854775808" } }, { "$date" : "2024-01-04T00:00:00Z" }], "recordedAt": DESC(MinKey, MaxKey)], ["assetCode": ["asset-2", "asset-2"], "effectiveAt": DESC[{ "$date" : { "$numberLong" : "-9223372036854775808" } }, { "$date" : "2024-01-04T00:00:00Z" }], "recordedAt": DESC(MinKey, MaxKey)], ["assetCode": ["asset-3", "asset-3"], "effectiveAt": DESC[{ "$date" : { "$numberLong" : "-9223372036854775808" } }, { "$date" : "2024-01-04T00:00:00Z" }], "recordedAt": DESC(MinKey, MaxKey)], ["assetCode": ["asset-0", "asset-0"], "effectiveAt": DESC[{ "$date" : { "$numberLong" : "-9223372036854775808" } }, { "$date" : "2024-01-04T00:00:00Z" }], "recordedAt": DESC(MinKey, MaxKey)], ["assetCode": ["asset-1", "asset-1"], "effectiveAt": DESC[{ "$date" : { "$numberLong" : "-9223372036854775808" } }, { "$date" : "2024-01-04T00:00:00Z" }], "recordedAt": DESC(MinKey, MaxKey)], ["assetCode": ["asset-2", "asset-2"], "effectiveAt": DESC[{ "$date" : { "$numberLong" : "-9223372036854775808" } }, { "$date" : "2024-01-04T00:00:00Z" }], "recordedAt": DESC(MinKey, MaxKey)], ["assetCode": ["asset-3", "asset-3"], "effectiveAt": DESC[{ "$date" : { "$numberLong" : "-9223372036854775808" } }, { "$date" : "2024-01-04T00:00:00Z" }], "recordedAt": DESC(MinKey, MaxKey)]
