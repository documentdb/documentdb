SELECT documentdb_api_internal.documentdb_rum_get_meta_page_info(
    public.get_raw_page('documentdb_data.documents_rum_index_2903', 0));
                                            documentdb_rum_get_meta_page_info                                            
-------------------------------------------------------------------------------------------------------------------------
