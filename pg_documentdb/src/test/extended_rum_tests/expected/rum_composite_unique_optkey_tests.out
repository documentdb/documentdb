    '{ "_id": 201, "a": 20, "b": 201, "c": 201 }');
                                                                                                                       insert_one                                                                                                                       
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 { "n" : { "$numberInt" : "0" }, "ok" : { "$numberDouble" : "1.0" }, "writeErrors" : [ { "index" : { "$numberInt" : "0" }, "code" : { "$numberInt" : "319029277" }, "errmsg" : "Duplicate key violation on the requested collection: Index 'a_1'" } ] }
(1 row)

-- This should succeed: "a":23 is not in the array
SELECT documentdb_api.insert_one('optkeydb', 'optkeyColl',
    '{ "_id": 202, "a": 23, "b": 202, "c": 202 }');
