(1 row)

SELECT 'documentdb_data.documents_' || collection_id AS deep_table
FROM documentdb_api_catalog.collections
WHERE database_name = 'parallel_mkp_db'
    AND collection_name = 'deep_parent_child' \gset
\d :deep_table
          Table "documentdb_data.documents_29304"
     Column      |  Type  | Collation | Nullable | Default 
-----------------+--------+-----------+----------+---------
 shard_key_value | bigint |           | not null | 
 object_id       | bson   |           | not null | 
 document        | bson   |           | not null | 
Indexes:
    "collection_pk_29304" PRIMARY KEY, btree (shard_key_value, object_id)
    "documents_rum_index_29310" documentdb_extended_rum (document documentdb_extended_rum_catalog.bson_extended_rum_composite_path_ops (pathspec='[ "a.b.c.d.e", "a.b.c.d" ]', tl='2691', rct='true'))
Check constraints:
    "shard_key_value_check" CHECK (shard_key_value = '29304'::bigint)

