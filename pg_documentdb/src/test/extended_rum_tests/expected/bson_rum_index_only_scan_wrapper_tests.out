   ->  Custom Scan (DocumentDBApiRumIndexOnlyScan) (actual rows=50 loops=1)
         ->  Index Only Scan using idx_zone_band on documents_29501 collection (actual rows=50 loops=1)
               Index Cond: ((document @= '{ "zone" : "z2" }'::bson) AND (document @<> '{ "zone" : { "indexProjectionMetadata" : { "$numberLong" : "-1" } } }'::bson))
               Heap Fetches: xxx
(5 rows)

SELECT document FROM bson_aggregation_pipeline('rumidxonly_db',
    '{ "aggregate": "records", "pipeline": [ { "$match": { "zone": "z2" } }, { "$count": "count" } ], "cursor": {}, "hint": "idx_zone_band" }');
               document                
---------------------------------------
 { "count" : { "$numberInt" : "50" } }
(1 row)

