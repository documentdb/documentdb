-- Seed a 200-char string ending in lowercase "x".
SELECT documentdb_api.insert_one('optkeycolldb', 'coll_trunc',
    bson_build_document('_id'::text, 1, 't'::text, repeat('a', 200) || 'SUFFIX_x'));
DEBUG:  Using single insert with subtransaction
