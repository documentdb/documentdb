SET search_path TO documentdb_api,documentdb_core,documentdb_api_catalog;
SET documentdb.next_collection_id TO 2800;
SET documentdb.next_collection_index_id TO 2800;
SET documentdb.defaultUseCompositeOpClass TO on;
SET documentdb.enableCompositeUniqueHash TO on;
SET documentdb.enable_composite_unique_optional_key TO on;
SET documentdb_core.enableCollation TO on;
SET documentdb.enableCollationWithNonUniqueOrderedIndexes TO on;
-- Collation-focused sibling of rum_composite_unique_optkey_tests. It validates
-- how collation interacts with unique optional-key indexes, gated by the
-- enable_collated_unique_indexes feature flag.
-- ===== Section 1: With the flag OFF, unique + collation is rejected =====
-- CALLOUT: while enable_collated_unique_indexes is off, a unique index that
-- requests a collation spec is rejected with
-- "Collation is not yet supported for unique indexes".
SET documentdb.enable_collated_unique_indexes TO off;
SELECT documentdb_api_internal.create_indexes_non_concurrently('optkeycolldb',
  '{ "createIndexes": "optkeyCollColl", "indexes": [ { "key": { "a": 1 }, "name": "a_coll_off", "unique": true, "collation": { "locale": "en", "strength": 2 } }]}', TRUE);
ERROR:  Collation is not yet supported for unique indexes
-- ===== Section 2: With the flag ON, unique + collation is allowed =====
-- Enabling the flag lets create_indexes build a unique index with a collation
-- spec. This is the first successful create, so it creates the collection
-- (id 2801).
SET documentdb.enable_collated_unique_indexes TO on;
SELECT documentdb_api_internal.create_indexes_non_concurrently('optkeycolldb',
  '{ "createIndexes": "optkeyCollColl", "indexes": [ { "key": { "a": 1 }, "name": "a_coll_1", "unique": true, "collation": { "locale": "en", "strength": 2 } }]}', TRUE);
NOTICE:  creating collection
                                                                                                   create_indexes_non_concurrently                                                                                                   
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 { "raw" : { "defaultShard" : { "numIndexesBefore" : { "$numberInt" : "1" }, "numIndexesAfter" : { "$numberInt" : "2" }, "createdCollectionAutomatically" : true, "ok" : { "$numberInt" : "1" } } }, "ok" : { "$numberInt" : "1" } }
(1 row)

-- Collection ID layout:
--   2800: db metadata
--   2801: optkeyCollColl -> pk 2801, unique a_coll_1
\d documentdb_data.documents_2801
          Table "documentdb_data.documents_2801"
     Column      |  Type  | Collation | Nullable | Default 
-----------------+--------+-----------+----------+---------
 shard_key_value | bigint |           | not null | 
 object_id       | bson   |           | not null | 
 document        | bson   |           | not null | 
Indexes:
    "collection_pk_2801" PRIMARY KEY, btree (shard_key_value, object_id)
    "documents_rum_index_2802" EXCLUDE USING documentdb_extended_rum (document documentdb_extended_rum_catalog.bson_extended_rum_composite_path_ops (pathspec='[ "a" ]', tl='2691', cl='en-u-ks-level2') WITH =?=, documentdb_api_internal.generate_unique_shard_document(document, shard_key_value, '{ "a" : { "$numberInt" : "1" } }'::bson, false, true, 'en-u-ks-level2'::text) documentdb_extended_rum_catalog.bson_extended_rum_unique_shard_path_ops (cmp='true', optsk='2801') WITH OPERATOR(documentdb_api_internal.=#=))
Check constraints:
    "shard_key_value_check" CHECK (shard_key_value = '2801'::bigint)

-- ===== Section 3: Validate collated (case-insensitive) uniqueness =====
-- The unique index requested collation with strength 2 (case-insensitive), and
-- create_indexes allows it under the flag (the collation is threaded into the
-- path term cl='en-u-ks-level2' and generate_unique_shard_document()). The write
-- path folds each term through the collation, so uniqueness is enforced on the
-- collated value: "val1" and "VAL1" collide case-insensitively.
-- Seed the value "val1".
SELECT documentdb_api.insert_one('optkeycolldb', 'optkeyCollColl',
    '{ "_id": 1, "a": "val1" }');
                              insert_one                              
----------------------------------------------------------------------
 { "n" : { "$numberInt" : "1" }, "ok" : { "$numberDouble" : "1.0" } }
(1 row)

-- CALLOUT: "VAL1" is a collated (case-insensitive) duplicate of "val1", so this
-- insert is rejected with a duplicate key violation on index a_coll_1.
SELECT documentdb_api.insert_one('optkeycolldb', 'optkeyCollColl',
    '{ "_id": 2, "a": "VAL1" }');
                                                                                                                         insert_one                                                                                                                          
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 { "n" : { "$numberInt" : "0" }, "ok" : { "$numberDouble" : "1.0" }, "writeErrors" : [ { "index" : { "$numberInt" : "0" }, "code" : { "$numberInt" : "319029277" }, "errmsg" : "Duplicate key violation on the requested collection: Index 'a_coll_1'" } ] }
(1 row)

-- CALLOUT: "val2" is distinct under the collation, so this insert succeeds.
SELECT documentdb_api.insert_one('optkeycolldb', 'optkeyCollColl',
    '{ "_id": 3, "a": "val2" }');
                              insert_one                              
----------------------------------------------------------------------
 { "n" : { "$numberInt" : "1" }, "ok" : { "$numberDouble" : "1.0" } }
(1 row)

-- CALLOUT: 2 rows remain ("val1" and "val2"); the collated duplicate "VAL1" was
-- rejected.
SELECT count(*) as final_rows FROM documentdb_data.documents_2801;
 final_rows 
------------
          2
(1 row)

