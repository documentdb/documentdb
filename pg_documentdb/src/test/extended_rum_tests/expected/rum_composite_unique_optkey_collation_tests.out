RESET documentdb.indexTermLimitOverride;
-- ===== Section 8: Collated nested array-of-arrays, deep difference beyond limit =====
-- The unique field holds a single embedded-document term wrapping an
-- array-of-arrays. The only difference is deep (index 5 of the 3rd inner array),
-- padded to sit beyond the truncation limit, so the terms collide and the
-- runtime recheck folds the full values through the collation (strength 2).
-- A case-only deep difference is a collated duplicate; a genuinely different
-- letter is distinct.
SET documentdb.indexTermLimitOverride TO 50;
SELECT documentdb_api_internal.create_indexes_non_concurrently('optkeycolldb',
  '{ "createIndexes": "coll_nested_trunc", "indexes": [ { "key": { "t": 1 }, "name": "t_coll_nested", "unique": true, "collation": { "locale": "en", "strength": 2 } }]}', TRUE);
NOTICE:  creating collection
                                                                                                   create_indexes_non_concurrently                                                                                                   
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
