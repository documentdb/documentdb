-- ===== Section 9: Feature-flag matrix for collated unique index creation =====
-- Creating a collated unique index requires BOTH flags on:
--   documentdb.enable_collated_unique_indexes    (collation allowed on unique)
--   documentdb.enable_composite_unique_optional_key (optional-key shard term)
-- With either flag off, creating a unique index that carries a collation spec
-- must fail. enableCollation stays on (set at the top of the file). Each attempt
-- uses a distinct key so the attempts do not collide as duplicate definitions.
SELECT documentdb_api.create_collection('optkeycolldb', 'flag_matrix');
NOTICE:  creating collection
 create_collection 
-------------------
 t
(1 row)

-- 9a: both flags OFF -> fails.
SET documentdb.enable_collated_unique_indexes TO off;
SET documentdb.enable_composite_unique_optional_key TO off;
SELECT documentdb_api_internal.create_indexes_non_concurrently('optkeycolldb',
  '{ "createIndexes": "flag_matrix", "indexes": [ { "key": { "a": 1 }, "name": "fm_both_off", "unique": true, "collation": { "locale": "en", "strength": 2 } }]}', TRUE);
ERROR:  Collation is not yet supported for unique indexes
-- 9b: only enable_collated_unique_indexes ON (optional-key OFF) -> fails.
SET documentdb.enable_collated_unique_indexes TO on;
SET documentdb.enable_composite_unique_optional_key TO off;
SELECT documentdb_api_internal.create_indexes_non_concurrently('optkeycolldb',
  '{ "createIndexes": "flag_matrix", "indexes": [ { "key": { "b": 1 }, "name": "fm_collated_only", "unique": true, "collation": { "locale": "en", "strength": 2 } }]}', TRUE);
ERROR:  collated unique indexes require a collection ID
-- 9c: only enable_composite_unique_optional_key ON (collated flag OFF) -> fails.
SET documentdb.enable_collated_unique_indexes TO off;
SET documentdb.enable_composite_unique_optional_key TO on;
SELECT documentdb_api_internal.create_indexes_non_concurrently('optkeycolldb',
  '{ "createIndexes": "flag_matrix", "indexes": [ { "key": { "c": 1 }, "name": "fm_optkey_only", "unique": true, "collation": { "locale": "en", "strength": 2 } }]}', TRUE);
ERROR:  Collation is not yet supported for unique indexes
-- 9d: both flags ON -> succeeds and produces a collated unique index.
SET documentdb.enable_collated_unique_indexes TO on;
SET documentdb.enable_composite_unique_optional_key TO on;
SELECT documentdb_api_internal.create_indexes_non_concurrently('optkeycolldb',
  '{ "createIndexes": "flag_matrix", "indexes": [ { "key": { "d": 1 }, "name": "fm_both_on", "unique": true, "collation": { "locale": "en", "strength": 2 } }]}', TRUE);
                                                                                                   create_indexes_non_concurrently                                                                                                    
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 { "raw" : { "defaultShard" : { "numIndexesBefore" : { "$numberInt" : "1" }, "numIndexesAfter" : { "$numberInt" : "2" }, "createdCollectionAutomatically" : false, "ok" : { "$numberInt" : "1" } } }, "ok" : { "$numberInt" : "1" } }
(1 row)

-- Only fm_both_on should exist, and it should carry a collation (cl=...).
SELECT collection_id AS fm_col FROM documentdb_api_catalog.collections WHERE database_name = 'optkeycolldb' AND collection_name = 'flag_matrix' \gset
SELECT indexname, (indexdef LIKE '%cl=%') AS has_collation
FROM pg_indexes
WHERE schemaname = 'documentdb_data' AND tablename = 'documents_' || :'fm_col'
  AND indexname LIKE '%rum%'
ORDER BY indexname;
