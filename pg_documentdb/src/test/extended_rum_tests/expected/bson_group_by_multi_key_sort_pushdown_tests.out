    '{ "createIndexes": "recs2", "indexes": [ { "key": { "labels": 1, "cat": 1 }, "name": "idx_prefix_mk", "enableOrderedIndex": 1 } ] }',
    true);
                                                                                                   create_indexes_non_concurrently
