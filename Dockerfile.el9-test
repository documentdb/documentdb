FROM almalinux:9

ARG POSTGRES_VERSION=18

# 1. Add PGDG repo (EL9 has both x86_64 and aarch64)
RUN dnf install -y \
    https://download.postgresql.org/pub/repos/yum/reporpms/EL-9-$(uname -m)/pgdg-redhat-repo-latest.noarch.rpm && \
    dnf -qy module disable postgresql

# 2. Install EPEL + enable CRB (needed for PostGIS deps like qhull)
RUN dnf install -y epel-release && \
    dnf config-manager --set-enabled crb

# 3. Add PGDG common repo (needed for PostGIS geospatial deps: gdal, geos, proj)
RUN echo -e "[pgdg-common]\nname=PostgreSQL common RPMs for RHEL/EL 9 - \$basearch\nbaseurl=https://download.postgresql.org/pub/repos/yum/common/redhat/rhel-9-\$basearch/\ngpgcheck=0\nenabled=1" \
    > /etc/yum.repos.d/pgdg-common.repo

# 4. Enable the Copr repo and install documentdb-server meta-package
#    (pulls in postgresql-server, postgresql-documentdb, documentdb-gateway,
#     pgvector, pg_cron, PostGIS)
#    Use --nobest since PostGIS deps may be broken on some arches
RUN dnf install -y 'dnf-command(copr)' && \
    dnf copr enable -y xgerman/DocumentDB && \
    dnf install -y --nobest documentdb-server

# 5. Verify core packages are installed
RUN rpm -q postgresql${POSTGRES_VERSION}-documentdb documentdb-gateway

# 6. Install mongosh from the MongoDB repo
RUN echo -e "[mongodb-org-8.0]\nname=MongoDB Repository\nbaseurl=https://repo.mongodb.org/yum/redhat/9/mongodb-org/8.0/\$basearch/\ngpgcheck=1\nenabled=1\ngpgkey=https://pgp.mongodb.com/server-8.0.asc" \
    > /etc/yum.repos.d/mongodb-org-8.0.repo && \
    dnf install -y mongodb-mongosh

# 7. Locale (needed for regression tests)
RUN dnf install -y glibc-langpack-en && \
    localedef -i en_US -f UTF-8 en_US.UTF-8 || true
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# 8. Create gateway configuration (PostgresPort must match the PG instance)
RUN echo '{"NodeHostName":"localhost","BlockedRolePrefixes":["documentdb","citus","pg","internal_role"],"PostgresPort":5432,"GatewayListenPort":10260,"HostConfigurationWatchIntervalMs":1000,"CertificateOptions":{"CertType":"PemAutoGenerated"},"UseLocalHost":false}' \
    > /tmp/SetupConfiguration.json

# 9. Smoke test: start PostgreSQL, create extensions, test via mongosh through gateway
#    Run gateway from /tmp so PemAutoGenerated can write its key/cert files there.
ENV PATH=/usr/pgsql-${POSTGRES_VERSION}/bin:$PATH
USER postgres
RUN initdb -D /var/lib/pgsql/${POSTGRES_VERSION}/data && \
    echo "shared_preload_libraries = 'pg_documentdb_core,pg_cron,pg_documentdb'" >> /var/lib/pgsql/${POSTGRES_VERSION}/data/postgresql.conf && \
    echo "cron.database_name = 'postgres'" >> /var/lib/pgsql/${POSTGRES_VERSION}/data/postgresql.conf && \
    pg_ctl -D /var/lib/pgsql/${POSTGRES_VERSION}/data start && \
    psql -c "CREATE EXTENSION documentdb_core CASCADE;" && \
    psql -c "CREATE EXTENSION documentdb CASCADE;" && \
    psql -c "SELECT documentdb_api.create_user('{\"createUser\":\"testuser\", \"pwd\":\"testpass\", \"roles\":[{\"role\":\"readWriteAnyDatabase\",\"db\":\"admin\"},{\"role\":\"clusterAdmin\",\"db\":\"admin\"}]}');" && \
    cd /tmp && documentdb_gateway /tmp/SetupConfiguration.json & \
    sleep 5 && \
    mongosh --tls --tlsAllowInvalidCertificates --port 10260 \
      -u testuser -p testpass --authenticationMechanism SCRAM-SHA-256 --eval " \
      db.test.insertOne({hello: 'world'}); \
      const doc = db.test.findOne({hello: 'world'}); \
      assert(doc !== null, 'Document not found'); \
      print('SUCCESS: mongosh smoke test passed'); \
    " && \
    kill %1 2>/dev/null || true && \
    pg_ctl -D /var/lib/pgsql/${POSTGRES_VERSION}/data stop
