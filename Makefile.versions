INSIDE_GIT_REPO = $(shell git rev-parse --is-inside-work-tree 2>/dev/null || echo "false")  

ifeq ($(INSIDE_GIT_REPO), false)
    GIT_INDEX_DIR_VALUE :=
else
    GIT_INDEX_DIR_VALUE := $(shell git  rev-parse --git-dir)
endif

ifeq (, $(GIT_INDEX_DIR_VALUE))
    GIT_INDEX_FILE =
else
    GIT_INDEX_FILE = $(GIT_INDEX_DIR_VALUE)/index
endif

EXTENSION_VERSION_HEADER ?= $(EXTENSION_OBJECT_PREFIX)_extension_version.h

build/include/metadata/$(EXTENSION_VERSION_HEADER): $(version_file_inputs) $(GIT_INDEX_FILE)
	mkdir -p build/include/metadata
	$(BUILD_SCRIPT_DIR)scripts/generate_extension_version.sh $@ $(EXTENSION) $(MODULE_big) $(GIT_INDEX_FILE) || exit 1
