BEGIN
  EXECUTE $explain$
    EXPLAIN (COSTS OFF)
    SELECT document FROM bson_aggregation_update(
      'coll_q_idx_dist_explain_db',
      '{ "update": "coll_update_route_d", "updates": [ { "q": { "name": "CaT" }, "u": { "$set": { "selected": "one" } }, "multi": false, "collation": { "locale": "en", "strength": 1 } } ] }')
  $explain$;
EXCEPTION WHEN OTHERS THEN
  RAISE NOTICE 'SQLSTATE: %, MESSAGE: %', SQLSTATE, SQLERRM;
END;
$capture$;
NOTICE:  SQLSTATE: M000P, MESSAGE: A {multi:false} update on a sharded collection cannot be routed to a single shard when the shard key value is collation-sensitive (string type).
END;
