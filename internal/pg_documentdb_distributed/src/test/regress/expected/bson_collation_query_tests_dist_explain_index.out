   ->  Distributed Subplan 41_1
         ->  Custom Scan (Citus Adaptive)
               Task Count: 8
               Tasks Shown: One of 8
               ->  Task
                     Node: host=localhost port=58070 dbname=regression
                     ->  Custom Scan (DocumentDBApiExplainQueryScan)
                           ->  Seq Scan on documents_95651_95650004 collection
   ->  Distributed Subplan 41_2
         ->  Custom Scan (Citus Adaptive)
               Task Count: 8
               Tasks Shown: One of 8
               ->  Task
                     Node: host=localhost port=58070 dbname=regression
                     ->  Custom Scan (DocumentDBApiExplainQueryScan)
                           indexName: idx_ab_en_s1
                           indexKey: {"a.b": 1}
                           indexCollation: en-u-ks-level1
                           isMultiKey: false
                           indexBounds: ["a.b": ["cat", "cat"]], ["a.b": ["dog", "dog"]]
                           ->  Bitmap Heap Scan on documents_95651_95650004 collection_0_1
                                 Recheck Cond: (document OPERATOR(documentdb_api_catalog.@*=) '{ "a.b" : [ "cat", "dog" ], "collation" : "en-u-ks-level1" }'::documentdb_core.bson)
                                 ->  Bitmap Index Scan on idx_ab_en_s1
                                       Index Cond: (document OPERATOR(documentdb_api_catalog.@*=) '{ "a.b" : [ "cat", "dog" ], "collation" : "en-u-ks-level1" }'::documentdb_core.bson)
   Task Count: 1
   Tasks Shown: All
   ->  Task
         Node: host=localhost port=58070 dbname=regression
         ->  Nested Loop
               ->  Function Scan on read_intermediate_result intermediate_result
               ->  Aggregate
                     ->  Function Scan on read_intermediate_result intermediate_result_1
                           Filter: documentdb_api_internal.bson_dollar_lookup_join_filter(document_1, intermediate_result.lookup_filter, '_id'::text)
(34 rows)

END;
