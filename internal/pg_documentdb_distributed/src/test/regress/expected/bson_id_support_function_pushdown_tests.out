BEGIN;
SET LOCAL documentdb.enable_support_function_id_pushdown TO on;
SET LOCAL enable_seqscan TO off;
EXPLAIN (COSTS OFF) SELECT document FROM bson_aggregation_find('id_push_dist_db', '{ "find": "test_unsharded", "filter": { "_id": 3 } }');
                                                                               QUERY PLAN                                                                               
---------------------------------------------------------------------
 Custom Scan (Citus Adaptive)
   Task Count: 1
   Tasks Shown: All
   ->  Task
         Node: host=localhost port=58070 dbname=regression
         ->  Index Scan using _id_ on documents_25860001_258600002 collection
               Index Cond: ((shard_key_value = '25860001'::bigint) AND (object_id OPERATOR(documentdb_core.=) '{ "" : { "$numberInt" : "3" } }'::documentdb_core.bson))
(7 rows)

COMMIT;
