        { "$project": { "val": 1, "label": { "$cond": [ { "$gt": [ "$val", 5 ] }, "MATCH", "other" ] } } },
        { "$match": { "label": "match" } }
    ], "collation": { "locale": "en", "strength": 2 }, "cursor": { "batchSize": 4 } }',
