-- =============================================
-- $geoWithin $geometry through the find (local execution) path
-- Must use the 2dsphere index, not _id_ with a residual filter.
-- =============================================
EXPLAIN (COSTS OFF) SELECT document FROM bson_aggregation_find('geodb', '{ "find": "geopushdown", "filter": { "loc": { "$geoWithin": { "$geometry": { "type": "Polygon", "coordinates": [ [ [ -10, -10 ], [ 10, -10 ], [ 10, 10 ], [ -10, 10 ], [ -10, -10 ] ] ] } } } } }');
                                                                                                                                                                                                                     QUERY PLAN                                                                                                                                                                                                                     
---------------------------------------------------------------------
 Bitmap Heap Scan on documents_88201_882002 collection
   Recheck Cond: (bson_validate_geography(document, 'loc'::text) @|-| '{ "loc" : { "$geometry" : { "type" : "Polygon", "coordinates" : [ [ [ { "$numberInt" : "-10" }, { "$numberInt" : "-10" } ], [ { "$numberInt" : "10" }, { "$numberInt" : "-10" } ], [ { "$numberInt" : "10" }, { "$numberInt" : "10" } ], [ { "$numberInt" : "-10" }, { "$numberInt" : "10" } ], [ { "$numberInt" : "-10" }, { "$numberInt" : "-10" } ] ] ] } } }'::bson)
   ->  Bitmap Index Scan on loc_2dsphere_idx
         Index Cond: (bson_validate_geography(document, 'loc'::text) @|-| '{ "loc" : { "$geometry" : { "type" : "Polygon", "coordinates" : [ [ [ { "$numberInt" : "-10" }, { "$numberInt" : "-10" } ], [ { "$numberInt" : "10" }, { "$numberInt" : "-10" } ], [ { "$numberInt" : "10" }, { "$numberInt" : "10" } ], [ { "$numberInt" : "-10" }, { "$numberInt" : "10" } ], [ { "$numberInt" : "-10" }, { "$numberInt" : "-10" } ] ] ] } } }'::bson)
(4 rows)

-- $geoIntersects $geometry through the find path - must use the 2dsphere index.
EXPLAIN (COSTS OFF) SELECT document FROM bson_aggregation_find('geodb', '{ "find": "geopushdown", "filter": { "loc": { "$geoIntersects": { "$geometry": { "type": "Polygon", "coordinates": [ [ [ -10, -10 ], [ 10, -10 ], [ 10, 10 ], [ -10, 10 ], [ -10, -10 ] ] ] } } } } }');
                                                                                                                                                                                                                     QUERY PLAN                                                                                                                                                                                                                     
---------------------------------------------------------------------
 Bitmap Heap Scan on documents_88201_882002 collection
   Recheck Cond: (bson_validate_geography(document, 'loc'::text) @|#| '{ "loc" : { "$geometry" : { "type" : "Polygon", "coordinates" : [ [ [ { "$numberInt" : "-10" }, { "$numberInt" : "-10" } ], [ { "$numberInt" : "10" }, { "$numberInt" : "-10" } ], [ { "$numberInt" : "10" }, { "$numberInt" : "10" } ], [ { "$numberInt" : "-10" }, { "$numberInt" : "10" } ], [ { "$numberInt" : "-10" }, { "$numberInt" : "-10" } ] ] ] } } }'::bson)
   ->  Bitmap Index Scan on loc_2dsphere_idx
         Index Cond: (bson_validate_geography(document, 'loc'::text) @|#| '{ "loc" : { "$geometry" : { "type" : "Polygon", "coordinates" : [ [ [ { "$numberInt" : "-10" }, { "$numberInt" : "-10" } ], [ { "$numberInt" : "10" }, { "$numberInt" : "-10" } ], [ { "$numberInt" : "10" }, { "$numberInt" : "10" } ], [ { "$numberInt" : "-10" }, { "$numberInt" : "10" } ], [ { "$numberInt" : "-10" }, { "$numberInt" : "-10" } ] ] ] } } }'::bson)
