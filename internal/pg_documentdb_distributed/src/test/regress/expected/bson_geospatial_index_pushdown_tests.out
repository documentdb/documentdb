-- Query matches the PFE (region = west) - uses the partial 2dsphere index.
EXPLAIN (COSTS OFF) SELECT document FROM bson_aggregation_find('geodb', '{ "find": "geopushdown_pfe", "filter": { "region": "west", "loc": { "$geoWithin": { "$geometry": { "type": "Polygon", "coordinates": [ [ [ -10, -10 ], [ 10, -10 ], [ 10, 10 ], [ -10, 10 ], [ -10, -10 ] ] ] } } } } }');
                                                                                                                                                                                                                                            QUERY PLAN                                                                                                                                                                                                                                            
---------------------------------------------------------------------
 Bitmap Heap Scan on documents_88202_882004 collection
   Recheck Cond: ((bson_validate_geography(document, 'loc'::text) @|-| '{ "loc" : { "$geometry" : { "type" : "Polygon", "coordinates" : [ [ [ { "$numberInt" : "-10" }, { "$numberInt" : "-10" } ], [ { "$numberInt" : "10" }, { "$numberInt" : "-10" } ], [ { "$numberInt" : "10" }, { "$numberInt" : "10" } ], [ { "$numberInt" : "-10" }, { "$numberInt" : "10" } ], [ { "$numberInt" : "-10" }, { "$numberInt" : "-10" } ] ] ] } } }'::bson) AND (document @= '{ "region" : "west" }'::bson))
   ->  Bitmap Index Scan on loc_2dsphere_region_pfe
         Index Cond: (bson_validate_geography(document, 'loc'::text) @|-| '{ "loc" : { "$geometry" : { "type" : "Polygon", "coordinates" : [ [ [ { "$numberInt" : "-10" }, { "$numberInt" : "-10" } ], [ { "$numberInt" : "10" }, { "$numberInt" : "-10" } ], [ { "$numberInt" : "10" }, { "$numberInt" : "10" } ], [ { "$numberInt" : "-10" }, { "$numberInt" : "10" } ], [ { "$numberInt" : "-10" }, { "$numberInt" : "-10" } ] ] ] } } }'::bson)
