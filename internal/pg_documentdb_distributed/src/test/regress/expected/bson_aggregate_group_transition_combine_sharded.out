SELECT documentdb_api.shard_collection('db', 'group_txn_combine_dist', '{ "_id": "hashed" }', false);
 shard_collection 
---------------------------------------------------------------------
 
(1 row)

-- ===== $max transition + combine pushdown =====
SELECT documentdb_distributed_test_helpers.run_explain_and_trim($cmd$
  EXPLAIN (COSTS OFF, VERBOSE ON)
  SELECT document FROM bson_aggregation_pipeline('db', '{ "aggregate": "group_txn_combine_dist", "pipeline": [ { "$group": { "_id": "$category", "maxVal": { "$max": "$val" } } } ], "cursor": {} }')
$cmd$, p_ignore_distributed_subplan_ids => true);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     run_explain_and_trim                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
---------------------------------------------------------------------
 Custom Scan (Citus Adaptive)
   Output: remote_scan.document
   ->  Distributed Subplan XXX_1
         ->  HashAggregate
               Output: remote_scan.c1, remote_scan.c2, remote_scan.c3, coord_combine_agg('xxxx'::oid, remote_scan.c4, NULL::bson)
               Group Key: remote_scan.c2
               ->  Custom Scan (Citus Adaptive)
                     Output: remote_scan.c1, remote_scan.c2, remote_scan.c3, remote_scan.c4
                     Task Count: 8
                     Tasks Shown: One of 8
                     ->  Task
                           Query: SELECT '_id'::text AS c1, documentdb_api_internal.bson_expression_get(document, '{ "" : "$category" }'::documentdb_core.bson, true, '{ "now" : NOW_SYS_VARIABLE }'::documentdb_core.bson) AS c2, 'maxVal'::text AS c3, pg_catalog.worker_partial_agg('documentdb_api_internal.bsonmaxwithexpr(documentdb_core.bson,documentdb_core.bson,documentdb_core.bson,text)'::regprocedure, ROW(document, '{ "" : "$val" }'::documentdb_core.bson, '{ "now" : NOW_SYS_VARIABLE }'::documentdb_core.bson, NULL::text)) AS c4 FROM documentdb_data.documents_9100_910016 collection WHERE documentdb_api_internal.bson_dollar_fullscan(document, '{ "category" : { "$numberInt" : "1" } }'::documentdb_core.bson) GROUP BY (documentdb_api_internal.bson_expression_get(document, '{ "" : "$category" }'::documentdb_core.bson, true, '{ "now" : NOW_SYS_VARIABLE }'::documentdb_core.bson))
                           Node: host=localhost port=58070 dbname=regression
                           ->  HashAggregate
                                 Output: '_id'::text, (documentdb_api_internal.bson_expression_get(document, '{ "" : "$category" }'::documentdb_core.bson, true, '{ "now" : NOW_SYS_VARIABLE }'::documentdb_core.bson)), 'maxVal'::text, worker_partial_agg('xxxx'::oid, ROW(document, '{ "" : "$val" }'::documentdb_core.bson, '{ "now" : NOW_SYS_VARIABLE }'::documentdb_core.bson, NULL::text))
                                 Group Key: documentdb_api_internal.bson_expression_get(collection.document, '{ "" : "$category" }'::documentdb_core.bson, true, '{ "now" : NOW_SYS_VARIABLE }'::documentdb_core.bson)
                                 ->  Seq Scan on documentdb_data.documents_9100_910016 collection
                                       Output: documentdb_api_internal.bson_expression_get(document, '{ "" : "$category" }'::documentdb_core.bson, true, '{ "now" : NOW_SYS_VARIABLE }'::documentdb_core.bson), document
   Task Count: 1
   Tasks Shown: All
   ->  Task
         Query: SELECT documentdb_core.bson_repath_and_build(c1, c2, c3, c4) AS document FROM (SELECT intermediate_result.c1, intermediate_result.c2, intermediate_result.c3, intermediate_result.c4 FROM read_intermediate_result('XXX_1'::text, 'binary'::citus_copy_format) intermediate_result(c1 text, c2 documentdb_core.bson, c3 text, c4 documentdb_core.bson)) agg_stage_0
         Node: host=localhost port=58070 dbname=regression
         ->  Function Scan on pg_catalog.read_intermediate_result intermediate_result
               Output: documentdb_core.bson_repath_and_build(intermediate_result.c1, intermediate_result.c2, intermediate_result.c3, intermediate_result.c4)
               Function Call: read_intermediate_result('XXX_1'::text, 'binary'::citus_copy_format)
