-- ================================================================
-- 3. deleteMany with shard key eq filter
--    Should route to a single shard
-- ================================================================
BEGIN;
SET LOCAL citus.log_remote_commands TO ON;
SELECT documentdb_api.delete('dmwdb', '{"delete":"dmwcoll", "deletes":[{"q":{"a":{"$eq":5}},"limit":0}]}');
NOTICE:  executing the command locally: SELECT documentdb_api_internal.delete_worker('1984801'::bigint, '1786987034919379147'::bigint, (0)::regclass, '{ "deleteMany" : { "query" : { "a" : { "$eq" : { "$numberInt" : "5" } } }, "variableSpec" : { "now" : NOW_SYS_VARIABLE } } }'::documentdb_core.bson, (NULL::bytea)::documentdb_core.bsonsequence, NULL::text) AS delete_worker FROM documentdb_data.documents_1984801_198480010 documents_1984801 WHERE (shard_key_value OPERATOR(pg_catalog.=) '1786987034919379147'::bigint)
                                         delete                                         
---------------------------------------------------------------------
 ("{ ""n"" : { ""$numberInt"" : ""1"" }, ""ok"" : { ""$numberDouble"" : ""1.0"" } }",t)
(1 row)

RESET citus.log_remote_commands;
SELECT count(*) FROM documentdb_api.collection('dmwdb', 'dmwcoll') WHERE document @@ '{"a":5}';
 count 
---------------------------------------------------------------------
     0
(1 row)

ROLLBACK;
