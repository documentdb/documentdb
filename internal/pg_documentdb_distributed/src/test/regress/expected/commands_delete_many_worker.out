-- ================================================================
-- 1. Basic deleteMany all docs (GUC ON by default)
--    Expect: n=10
-- ================================================================
BEGIN;
SELECT documentdb_api.delete('dmwdb', '{"delete":"dmwcoll", "deletes":[{"q":{},"limit":0}]}');
                                         delete                                          
---------------------------------------------------------------------
