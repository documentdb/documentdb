NOTICE:  executing the command locally: SELECT documentdb_api_internal.delete_worker('1984801'::bigint, '0'::bigint, '-'::regclass, '{ "deleteMany" : { "query" : { "tag" : "z" }, "variableSpec" : { "now" : NOW_SYS_VARIABLE } } }'::documentdb_core.bson, NULL::documentdb_core.bsonsequence, NULL::text) AS delete_worker FROM documentdb_data.documents_1984801_198480011 documents_1984801 WHERE true
