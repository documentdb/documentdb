-- The per-node catalog updates must roll back with the command.
BEGIN;
SELECT documentdb_api.coll_mod('hide_mn', 'coll',
    '{"collMod":"coll","index":{"name":"a_1","hidden":true}}');
                                   coll_mod                                   
---------------------------------------------------------------------
