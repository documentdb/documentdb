-- A remote file cursor keeps the result set materialized with the inherited
-- default selected for its first page.
CREATE TEMP TABLE remote_file_first_page AS
SELECT cursorpage, continuation
FROM find_cursor_first_page(
    'collation_dynamic_cursor_db',
    '{
        "find": "remote_default",
        "sort": { "category": 1, "_id": 1 },
        "projection": { "_id": 1 },
        "skip": 1,
        "batchSize": 1
    }',
    123502);
SELECT bson_dollar_project(
           cursorpage,
           '{ "_id": 0,
              "ids": "$cursor.firstBatch._id",
              "cursorId": "$cursor.id" }') AS first_page,
       NOT (continuation::text::jsonb ? 'cl')
           AS coordinator_omits_collation,
       NOT ((continuation::text::jsonb -> 'wc') ? 'cl')
           AS worker_omits_collation,
       (bson_dollar_project(
            continuation,
            '{ "wc.qf": 1 }') ->> 'wc.qf') IS NOT NULL AS remote_file
FROM remote_file_first_page;
                                    first_page                                     | coordinator_omits_collation | worker_omits_collation | remote_file 
---------------------------------------------------------------------
 { "ids" : [ { "$numberInt" : "2" } ], "cursorId" : { "$numberLong" : "123502" } } | t                           | t                      | t
(1 row)

