SET search_path TO documentdb_api, documentdb_core, documentdb_api_catalog,
    documentdb_api_internal, public;
SET citus.next_shard_id TO 1235000;
SET documentdb.next_collection_id TO 12350;
SET documentdb.next_collection_index_id TO 12350;
SET documentdb.enableDynamicCursors TO on;
SET documentdb_core.enableCollation TO on;
SET documentdb.enableCollationWithNonUniqueOrderedIndexes TO on;
SET documentdb.defaultUseCompositeOpClass TO on;
SET documentdb.enableIndexOnlyScanForFindProject TO on;
SET documentdb.enableCursorsOnAggregationQueryRewrite TO on;
DO $$
DECLARE
    dynamic_cursor_nodes int;
    aggregate_cursor_nodes int;
    collation_nodes int;
    ordered_collation_nodes int;
    composite_opclass_nodes int;
    index_only_nodes int;
    reloaded_nodes int;
BEGIN
    SELECT count(*) INTO dynamic_cursor_nodes
    FROM run_command_on_all_nodes(
        $cmd$ALTER SYSTEM SET documentdb.enableDynamicCursors = 'on'$cmd$)
    WHERE success;

    SELECT count(*) INTO aggregate_cursor_nodes
    FROM run_command_on_all_nodes(
        $cmd$ALTER SYSTEM SET documentdb.enableCursorsOnAggregationQueryRewrite = 'on'$cmd$)
    WHERE success;

    SELECT count(*) INTO collation_nodes
    FROM run_command_on_all_nodes(
        $cmd$ALTER SYSTEM SET documentdb_core.enableCollation = 'on'$cmd$)
    WHERE success;

    SELECT count(*) INTO ordered_collation_nodes
    FROM run_command_on_all_nodes(
        $cmd$ALTER SYSTEM SET documentdb.enableCollationWithNonUniqueOrderedIndexes = 'on'$cmd$)
    WHERE success;

    SELECT count(*) INTO composite_opclass_nodes
    FROM run_command_on_all_nodes(
        $cmd$ALTER SYSTEM SET documentdb.defaultUseCompositeOpClass = 'on'$cmd$)
    WHERE success;

    SELECT count(*) INTO index_only_nodes
    FROM run_command_on_all_nodes(
        $cmd$ALTER SYSTEM SET documentdb.enableIndexOnlyScanForFindProject = 'on'$cmd$)
    WHERE success;

    SELECT count(*) INTO reloaded_nodes
    FROM run_command_on_all_nodes($cmd$SELECT pg_reload_conf()$cmd$)
    WHERE success;

    IF dynamic_cursor_nodes <> 2 OR aggregate_cursor_nodes <> 2 OR
       collation_nodes <> 2 OR
       ordered_collation_nodes <> 2 OR composite_opclass_nodes <> 2 OR
       index_only_nodes <> 2 OR
       reloaded_nodes <> 2 THEN
        RAISE EXCEPTION 'failed to configure all nodes';
    END IF;
END
$$;
SELECT create_collection('collation_dynamic_cursor_db', 'remote_default');
NOTICE:  creating collection
 create_collection 
---------------------------------------------------------------------
 t
(1 row)

