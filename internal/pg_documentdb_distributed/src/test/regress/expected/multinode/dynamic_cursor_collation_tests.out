ANALYZE;
CREATE FUNCTION drain_remote_collation_cursor(
    p_cursor_id bigint,
    p_continuation bson)
RETURNS TABLE(
    page_number int,
    batch bson,
    worker_has_collation bool,
    has_continuation bool)
LANGUAGE plpgsql
AS $$
DECLARE
    v_page bson;
    v_continuation bson := p_continuation;
    v_get_more_spec bson;
    v_page_number int := 1;
BEGIN
    v_get_more_spec := FORMAT(
        '{
            "getMore": { "$numberLong": "%s" },
            "collection": "remote_default",
            "batchSize": 1
        }',
        p_cursor_id)::bson;

    WHILE v_continuation IS NOT NULL AND v_page_number < 20 LOOP
        worker_has_collation :=
            (v_continuation::text::jsonb -> 'wc') ? 'cl';

        SELECT cursorpage, continuation
        INTO v_page, v_continuation
        FROM cursor_get_more(
            'collation_dynamic_cursor_db',
            v_get_more_spec,
            v_continuation);

        v_page_number := v_page_number + 1;
        page_number := v_page_number;
        batch := bson_dollar_project(
            v_page,
            '{ "_id": 0,
               "ids": "$cursor.nextBatch._id",
               "cursorId": "$cursor.id" }');
        has_continuation := v_continuation IS NOT NULL;
        RETURN NEXT;
    END LOOP;

    IF v_continuation IS NOT NULL THEN
        RAISE EXCEPTION 'remote cursor did not drain within 20 pages';
    END IF;
END;
$$;
CALL documentdb_distributed_test_helpers.place_collection_on_node(
    'collation_dynamic_cursor_db', 'remote_default', 1);
-- The streaming cursor retains the inherited default in every worker
-- continuation.
CREATE TEMP TABLE remote_streaming_first_page AS
SELECT cursorpage, continuation
FROM find_cursor_first_page(
    'collation_dynamic_cursor_db',
    '{
        "find": "remote_default",
        "filter": { "category": "CAFE" },
        "sort": { "_id": 1 },
        "projection": { "_id": 1 },
        "hint": "category_id_en_s1",
        "batchSize": 1
    }',
    123501);
SELECT bson_dollar_project(
           cursorpage,
           '{ "_id": 0,
              "ids": "$cursor.firstBatch._id",
              "cursorId": "$cursor.id" }') AS first_page,
       NOT (continuation::text::jsonb ? 'cl')
           AS coordinator_omits_collation,
       (continuation::text::jsonb -> 'wc') ? 'cl'
           AS worker_has_collation,
       (bson_dollar_project(
            continuation,
            '{ "wc.dc.type": 1 }') ->> 'wc.dc.type') IS NOT NULL AS remote_streaming
FROM remote_streaming_first_page;
                                    first_page                                     | coordinator_omits_collation | worker_has_collation | remote_streaming 
---------------------------------------------------------------------
 { "ids" : [ { "$numberInt" : "1" } ], "cursorId" : { "$numberLong" : "123501" } } | t                           | t                    | t
(1 row)

-- Aggregate cursors use the same worker-owned retained collation state.
CREATE TEMP TABLE remote_aggregate_first_page AS
SELECT cursorpage, continuation
FROM aggregate_cursor_first_page(
    'collation_dynamic_cursor_db',
    '{
        "aggregate": "remote_default",
        "pipeline": [
            { "$match": { "category": "cafe" } }
        ],
        "hint": "category_id_en_s1",
        "cursor": { "batchSize": 1 }
    }',
    123504);
SELECT bson_dollar_project(
           cursorpage,
           '{ "_id": 0,
              "ids": "$cursor.firstBatch._id",
              "cursorId": "$cursor.id" }') AS first_page,
       NOT (continuation::text::jsonb ? 'cl')
           AS coordinator_omits_collation,
       (continuation::text::jsonb -> 'wc') ? 'cl'
           AS worker_has_collation,
       (bson_dollar_project(
            continuation,
            '{ "wc.dc.type": 1 }') ->> 'wc.dc.type') IS NOT NULL AS remote_streaming
FROM remote_aggregate_first_page;
                                    first_page                                     | coordinator_omits_collation | worker_has_collation | remote_streaming 
---------------------------------------------------------------------
 { "ids" : [ { "$numberInt" : "1" } ], "cursorId" : { "$numberLong" : "123504" } } | t                           | t                    | t
(1 row)

-- A legacy worker continuation without retained state falls back to the
-- unchanged immutable collection default.
CREATE TEMP TABLE remote_legacy_first_page AS
SELECT cursorpage, continuation
FROM find_cursor_first_page(
    'collation_dynamic_cursor_db',
    '{
        "find": "remote_default",
        "filter": { "category": "CAFE" },
        "sort": { "_id": 1 },
        "projection": { "_id": 1 },
        "hint": "category_id_en_s1",
        "batchSize": 1
    }',
    123503);
-- Evict metadata without changing the immutable default. The legacy
-- compatibility case intentionally exercises fallback with valid metadata.
SELECT documentdb_api_internal.invalidate_collection_cache();
