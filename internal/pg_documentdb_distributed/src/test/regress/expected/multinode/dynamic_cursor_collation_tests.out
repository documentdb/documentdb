DROP FUNCTION drain_remote_collation_cursor(bigint, bson);
SELECT drop_collection('collation_dynamic_cursor_db', 'remote_default');
 drop_collection 
---------------------------------------------------------------------
 t
(1 row)

DO $$
DECLARE
    reset_dynamic_cursor_nodes int;
    reset_aggregate_cursor_nodes int;
    reset_collation_nodes int;
    reset_ordered_collation_nodes int;
    reset_composite_opclass_nodes int;
    reset_index_only_nodes int;
    reloaded_nodes int;
BEGIN
    SELECT count(*) INTO reset_dynamic_cursor_nodes
    FROM run_command_on_all_nodes(
        $cmd$ALTER SYSTEM RESET documentdb.enableDynamicCursors$cmd$)
    WHERE success;

    SELECT count(*) INTO reset_aggregate_cursor_nodes
    FROM run_command_on_all_nodes(
        $cmd$ALTER SYSTEM RESET documentdb.enableCursorsOnAggregationQueryRewrite$cmd$)
    WHERE success;

    SELECT count(*) INTO reset_collation_nodes
    FROM run_command_on_all_nodes(
        $cmd$ALTER SYSTEM RESET documentdb_core.enableCollation$cmd$)
    WHERE success;

    SELECT count(*) INTO reset_ordered_collation_nodes
    FROM run_command_on_all_nodes(
        $cmd$ALTER SYSTEM RESET documentdb.enableCollationWithNonUniqueOrderedIndexes$cmd$)
    WHERE success;

    SELECT count(*) INTO reset_composite_opclass_nodes
    FROM run_command_on_all_nodes(
        $cmd$ALTER SYSTEM RESET documentdb.defaultUseCompositeOpClass$cmd$)
    WHERE success;

    SELECT count(*) INTO reset_index_only_nodes
    FROM run_command_on_all_nodes(
        $cmd$ALTER SYSTEM RESET documentdb.enableIndexOnlyScanForFindProject$cmd$)
    WHERE success;

    SELECT count(*) INTO reloaded_nodes
    FROM run_command_on_all_nodes($cmd$SELECT pg_reload_conf()$cmd$)
    WHERE success;

    IF reset_dynamic_cursor_nodes <> 2 OR reset_aggregate_cursor_nodes <> 2 OR
       reset_collation_nodes <> 2 OR
       reset_ordered_collation_nodes <> 2 OR
       reset_composite_opclass_nodes <> 2 OR reset_index_only_nodes <> 2 OR
       reloaded_nodes <> 2 THEN
        RAISE EXCEPTION 'failed to reset all nodes';
    END IF;
END
$$;
RESET documentdb_core.enableCollation;
RESET documentdb.enableDynamicCursors;
RESET documentdb.enableCollationWithNonUniqueOrderedIndexes;
RESET documentdb.defaultUseCompositeOpClass;
RESET documentdb.enableIndexOnlyScanForFindProject;
RESET documentdb.enableCursorsOnAggregationQueryRewrite;
RESET search_path;
