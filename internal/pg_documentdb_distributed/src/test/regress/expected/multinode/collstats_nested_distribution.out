SET search_path TO documentdb_api,documentdb_core,documentdb_api_catalog,documentdb_api_internal;
SET documentdb.next_collection_id TO 43000;
SET citus.next_shard_id TO 4300000;
SET documentdb.next_collection_index_id TO 43000;
-- ===========================================================================
-- Regression: $collStats gathers worker statistics by fanning out through
-- run_command_on_all_nodes, and resolves its collection from the collections
-- reference table. When the enclosing aggregation is already running as a
-- distributed task on a worker (for example a $collStats sub-pipeline in
-- $lookup / $unionWith, or a $collStats run after a write in the same
-- transaction), those steps are nested distributed executions and must be
-- explicitly allowed. Placing the collection entirely on a worker node forces
-- the enclosing query onto a shard so the nested path is exercised.
--
-- The output deliberately avoids the collStats "count", whose value is derived
-- from per-node table statistics and therefore varies with the cluster
-- topology. These cases only assert that the nested $collStats runs without the
-- "query on a shard" error, so the projections emit topology-independent shapes.
-- ===========================================================================
SELECT documentdb_api.drop_collection('collstats_nd_db', 'nd_coll');
 drop_collection 
---------------------------------------------------------------------
 f
(1 row)

SELECT COUNT(documentdb_api.insert_one('collstats_nd_db', 'nd_coll',
    FORMAT('{ "_id": %s, "a": %s }', i, i)::documentdb_core.bson))
FROM generate_series(1, 10) AS i;
NOTICE:  creating collection
 count 
---------------------------------------------------------------------
    10
(1 row)

ANALYZE;
CALL documentdb_distributed_test_helpers.place_collection_on_node('collstats_nd_db', 'nd_coll', 1);
-- $collStats in a $lookup sub-pipeline: the outer query runs on the worker that
-- holds the collection, so the sub-pipeline's $collStats resolves its catalog
-- entry and gathers worker statistics from that on-shard context.
SELECT document FROM bson_aggregation_pipeline('collstats_nd_db', '{ "aggregate": "nd_coll", "pipeline": [
    { "$lookup": { "from": "nd_coll", "pipeline": [
        { "$collStats": { "count": {} } } ], "as": "stats" } },
    { "$match": { "_id": 1 } },
    { "$project": { "_id": 0, "collstats_ran": { "$gt": [ { "$size": "$stats" }, 0 ] } } } ] }');
          document          
---------------------------------------------------------------------
 { "collstats_ran" : true }
(1 row)

-- $collStats in a $unionWith sub-pipeline from an on-shard context. Both the
-- main and the sub-pipeline $collStats must run; the literal marks which is which.
SELECT document FROM bson_aggregation_pipeline('collstats_nd_db', '{ "aggregate": "nd_coll", "pipeline": [
    { "$collStats": { "count": {} } },
    { "$project": { "_id": 0, "src": { "$literal": "main" } } },
    { "$unionWith": { "coll": "nd_coll", "pipeline": [
        { "$collStats": { "count": {} } },
        { "$project": { "_id": 0, "src": { "$literal": "union" } } } ] } } ] }');
      document       
---------------------------------------------------------------------
 { "src" : "main" }
 { "src" : "union" }
(2 rows)

-- $collStats after a write in the same transaction: the write establishes a
-- distributed execution context before the $collStats fan-out.
BEGIN;
SELECT documentdb_api.insert_one('collstats_nd_db', 'nd_coll', '{ "_id": 11, "a": 11 }');
                              insert_one                              
---------------------------------------------------------------------
 { "n" : { "$numberInt" : "1" }, "ok" : { "$numberDouble" : "1.0" } }
(1 row)

SELECT document FROM bson_aggregation_pipeline('collstats_nd_db', '{ "aggregate": "nd_coll", "pipeline": [
    { "$collStats": { "count": {} } },
    { "$project": { "_id": 0, "ns": 1 } } ] }');
               document               
---------------------------------------------------------------------
 { "ns" : "collstats_nd_db.nd_coll" }
(1 row)

ROLLBACK;
-- ===========================================================================
-- When a node cannot accept a connection, collStats, count without a query,
-- dbStats, $indexStats and currentOp must fail their run_command_on_all_nodes
-- fan-out with a connection failure (SQLSTATE 08006), not with an internal
-- error.
--
-- A worker is made unreachable by moving it to port 0, which is never a
-- valid port, so every connection attempt to it fails. The move happens in a
-- transaction that is rolled back, which restores the node metadata without
-- triggering a metadata sync to the worker.
-- ===========================================================================
SELECT nodeid AS worker_node_id, nodeport AS worker_node_port
FROM pg_dist_node WHERE groupid > 0 AND noderole = 'primary'
ORDER BY nodeid LIMIT 1 \gset
\set VERBOSITY terse
BEGIN;
SELECT citus_update_node(:worker_node_id, 'localhost', 0);
 citus_update_node 
---------------------------------------------------------------------
 
(1 row)

SAVEPOINT worker_unreachable;
SELECT documentdb_api.coll_stats('collstats_nd_db', 'nd_coll');
ERROR:  CollStats on worker failed with connectivity errors
\echo :SQLSTATE
08006
ROLLBACK TO SAVEPOINT worker_unreachable;
-- A count without a query, skip, limit or hint is answered by $collStats.
SELECT documentdb_api.count_query('collstats_nd_db', '{ "count": "nd_coll" }');
ERROR:  CollStats on worker failed with connectivity errors
\echo :SQLSTATE
08006
ROLLBACK TO SAVEPOINT worker_unreachable;
SELECT documentdb_api.db_stats('collstats_nd_db');
ERROR:  DbStats on worker failed with connectivity errors
\echo :SQLSTATE
08006
ROLLBACK TO SAVEPOINT worker_unreachable;
-- The $indexStats stage is not permitted in a transaction, so call the
-- function that the stage runs.
SELECT documentdb_api_internal.index_stats_aggregation('collstats_nd_db', 'nd_coll');
ERROR:  IndexStats on worker failed with connectivity errors
\echo :SQLSTATE
08006
ROLLBACK TO SAVEPOINT worker_unreachable;
SELECT documentdb_api.current_op_command('{ "currentOp": 1 }');
ERROR:  CurrentOp on worker failed with connectivity errors
\echo :SQLSTATE
08006
ROLLBACK;
\set VERBOSITY default
-- The rollback restores the worker, and the commands reach it again.
SELECT nodeport = :worker_node_port AS worker_port_restored
FROM pg_dist_node WHERE nodeid = :worker_node_id;
 worker_port_restored 
---------------------------------------------------------------------
 t
(1 row)

SELECT bson_dollar_project(documentdb_api.coll_stats('collstats_nd_db', 'nd_coll'),
    '{ "ns": 1, "ok": 1 }');
                         bson_dollar_project                         
---------------------------------------------------------------------
 { "ns" : "collstats_nd_db.nd_coll", "ok" : { "$numberInt" : "1" } }
(1 row)

SELECT documentdb_api.drop_collection('collstats_nd_db', 'nd_coll');
 drop_collection 
---------------------------------------------------------------------
 t
(1 row)

