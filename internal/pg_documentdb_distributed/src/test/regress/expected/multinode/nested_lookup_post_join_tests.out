SET search_path TO documentdb_core,documentdb_api,documentdb_api_catalog,documentdb_api_internal,public;
SET citus.next_shard_id TO 257400000;
SET documentdb.next_collection_id TO 25740000;
SET documentdb.next_collection_index_id TO 25740000;
CREATE OR REPLACE PROCEDURE documentdb_distributed_test_helpers.place_routed_shard_on_node(
        p_database_name text,
        p_collection_name text,
        p_node_number integer)
AS $$
DECLARE
    v_collection_id bigint;
    collection_relid oid;
    physical_shard_count integer;
    selected_shard_id bigint;
    current_node_name text;
    current_node_port integer;
    current_group_id integer;
    target_node_name text;
    target_node_port integer;
BEGIN
    SELECT collection_id
    FROM documentdb_api_catalog.collections
    WHERE database_name = p_database_name AND
          collection_name = p_collection_name AND
          shard_key IS NULL
    INTO STRICT v_collection_id;

    collection_relid :=
        format('documentdb_data.documents_%s', v_collection_id)::regclass;

    SELECT COUNT(*)
    FROM pg_dist_shard
    WHERE logicalrelid = collection_relid
    INTO STRICT physical_shard_count;

    IF physical_shard_count = 1 THEN
        SELECT shardid
        FROM pg_dist_shard
        WHERE logicalrelid = collection_relid
        INTO STRICT selected_shard_id;
    ELSE
        selected_shard_id :=
            get_shard_id_for_distribution_column(collection_relid, v_collection_id);
    END IF;

    SELECT node.nodename, node.nodeport, node.groupid
    FROM pg_dist_shard_placement placement
    JOIN pg_dist_node node
      ON placement.nodename = node.nodename AND
         placement.nodeport = node.nodeport
    WHERE placement.shardid = selected_shard_id AND
          node.noderole = 'primary'
    INTO STRICT current_node_name, current_node_port, current_group_id;

    IF current_group_id = p_node_number THEN
        RETURN;
    END IF;

    IF physical_shard_count = 1 THEN
        COMMIT;

        PERFORM documentdb_api_distributed.move_collection(
            documentdb_core.bson_build_document(
                'moveCollection'::text,
                format('%s.%s', p_database_name, p_collection_name),
                'toShard'::text,
                format('shard_%s', p_node_number)
            )
        );
        RETURN;
    END IF;

    SELECT nodename, nodeport
    FROM pg_dist_node
    WHERE groupid = p_node_number AND
          noderole = 'primary' AND
          isactive
    INTO STRICT target_node_name, target_node_port;

    COMMIT;

    PERFORM citus_move_shard_placement(
        selected_shard_id,
        current_node_name,
        current_node_port,
        target_node_name,
        target_node_port,
        'block_writes'
    );
END;
$$ LANGUAGE plpgsql;
SELECT groupid AS coordinator_group
FROM pg_dist_node
WHERE nodeport = current_setting('port')::integer AND
      noderole = 'primary'
\gset
SELECT groupid AS worker_group
FROM pg_dist_node
WHERE groupid <> :coordinator_group AND
      noderole = 'primary' AND
      isactive
ORDER BY groupid
LIMIT 1
\gset
SELECT :coordinator_group AS coordinator_group,
       :worker_group AS worker_group;
 coordinator_group | worker_group 
---------------------------------------------------------------------
                 0 |            1
(1 row)

SELECT citus_set_node_property(nodename, nodeport, 'shouldhaveshards', true)
FROM pg_dist_node
WHERE groupid IN (:coordinator_group, :worker_group) AND
      noderole = 'primary';
 citus_set_node_property 
---------------------------------------------------------------------
 
 
(2 rows)

