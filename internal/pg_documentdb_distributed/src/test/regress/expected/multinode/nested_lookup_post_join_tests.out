-- Flag-off control: the inline policy supports the one-shard cross-node
-- placement.
SELECT document
FROM bson_aggregation_pipeline(
    'lookup_nodes_single',
    $pipeline$
    {
      "aggregate": "orders",
      "pipeline": [
        {
          "$lookup": {
            "from": "items",
            "localField": "itemCode",
            "foreignField": "code",
            "pipeline": [
              {
                "$lookup": {
                  "from": "suppliers",
                  "localField": "supplierCode",
                  "foreignField": "code",
                  "as": "supplier"
                }
              }
            ],
            "as": "items"
          }
        }
      ]
    }
    $pipeline$
);
