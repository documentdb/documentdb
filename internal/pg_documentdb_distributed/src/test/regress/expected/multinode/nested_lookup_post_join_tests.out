SET documentdb.force_nested_lookup_pipeline_after_join TO on;
-- The forced one-shard cross-node post-join shape produces the correlated CTE
-- error because there is no placement fallback.
SELECT document
FROM bson_aggregation_pipeline(
    'lookup_nodes_single',
    $pipeline$
    {
      "aggregate": "orders",
      "pipeline": [
        {
          "$lookup": {
            "from": "items",
            "localField": "itemCode",
            "foreignField": "code",
            "pipeline": [
              {
                "$lookup": {
                  "from": "suppliers",
                  "localField": "supplierCode",
                  "foreignField": "code",
                  "as": "supplier"
                }
              }
            ],
            "as": "items"
          }
        }
      ]
    }
    $pipeline$
);
ERROR:  CTEs that refer to other subqueries are not supported in multi-shard queries
RESET documentdb.force_nested_lookup_pipeline_after_join;
