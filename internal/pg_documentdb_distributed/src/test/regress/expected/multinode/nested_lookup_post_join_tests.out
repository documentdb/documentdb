    'lookup_nodes_legacy',
    'suppliers',
    :worker_group
);
SELECT 'legacy-multi-shard-cross-node' AS exercised_topology;
      exercised_topology       
---------------------------------------------------------------------
 legacy-multi-shard-cross-node
(1 row)

-- The collections remain logically unsharded. For the legacy multi-shard
-- layout, the routed supplier shard is placed on a different node from
-- orders/items.
SELECT collection.collection_name,
       collection.shard_key IS NULL AS logically_unsharded,
       (
           SELECT COUNT(*)
           FROM pg_dist_shard
           WHERE logicalrelid =
                 format(
                     'documentdb_data.documents_%s',
                     collection.collection_id
                 )::regclass
       ) AS physical_shard_count,
       node.groupid AS selected_shard_group
FROM documentdb_api_catalog.collections collection
JOIN pg_dist_shard_placement placement
  ON placement.shardid = get_shard_id_for_distribution_column(
      format(
          'documentdb_data.documents_%s',
          collection.collection_id
      )::regclass,
      collection.collection_id
  )
JOIN pg_dist_node node
  ON placement.nodename = node.nodename AND
     placement.nodeport = node.nodeport
WHERE collection.database_name = 'lookup_nodes_legacy' AND
      collection.collection_name IN ('orders', 'items', 'suppliers') AND
      node.noderole = 'primary'
ORDER BY collection.collection_name;
 collection_name | logically_unsharded | physical_shard_count | selected_shard_group 
---------------------------------------------------------------------
 items           | t                   |                    8 |                    0
 orders          | t                   |                    8 |                    0
 suppliers       | t                   |                    8 |                    1
(3 rows)

-- Flag-off establishes the inline result for the same cross-node routing.
SELECT document
FROM bson_aggregation_pipeline(
    'lookup_nodes_legacy',
    $pipeline$
    {
      "aggregate": "orders",
      "pipeline": [
        {
          "$lookup": {
            "from": "items",
            "localField": "itemCode",
            "foreignField": "code",
            "pipeline": [
              {
                "$lookup": {
                  "from": "suppliers",
                  "localField": "supplierCode",
                  "foreignField": "code",
                  "as": "supplier"
                }
              }
            ],
            "as": "items"
          }
        }
      ]
    }
    $pipeline$
);
                                                                                                                  document                                                                                                                   
---------------------------------------------------------------------
 { "_id" : { "$numberInt" : "1" }, "itemCode" : "item-1", "items" : [ { "_id" : { "$numberInt" : "11" }, "code" : "item-1", "supplierCode" : "supplier-1", "supplier" : [ { "_id" : { "$numberInt" : "21" }, "code" : "supplier-1" } ] } ] }
(1 row)

