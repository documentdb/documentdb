SET search_path TO documentdb_core, documentdb_api, documentdb_api_catalog;
SET citus.next_shard_id TO 280200000;
SET documentdb.next_collection_id TO 28020000;
SET documentdb.next_collection_index_id TO 28020000;
SET documentdb_core.enableCollation TO on;
SET documentdb.enable_collation_with_create_collection TO on;
SET documentdb.enableCollationWithNonUniqueOrderedIndexes TO on;
SET documentdb.enable_collated_unique_indexes TO on;
SET documentdb.enable_composite_unique_optional_key TO on;
SET documentdb.alternate_index_handler_name TO 'extended_rum';
-- Both collection placement modes must create one logical collated _id_ index.
SET documentdb.enableNativeColocation TO off;
SELECT documentdb_api.create_collection_view('collated_creation_dist',
    '{"create":"legacy","collation":{"locale":"en","strength":2}}');
NOTICE:  creating collection
         create_collection_view         
---------------------------------------------------------------------
 { "ok" : { "$numberDouble" : "1.0" } }
(1 row)

SET documentdb.enableNativeColocation TO on;
SELECT documentdb_api.create_collection_with_options('collated_creation_native_dist', 'native',
    '{"collation":{"locale":"fr","strength":1}}');
NOTICE:  creating collection
 create_collection_with_options 
---------------------------------------------------------------------
 t
(1 row)

SELECT collection_name, partmethod,
    (SELECT count(*) FROM documentdb_api_catalog.collection_indexes i
        WHERE i.collection_id = c.collection_id) AS logical_indexes
FROM documentdb_api_catalog.collections c
JOIN pg_dist_partition p ON p.logicalrelid =
    ('documentdb_data.documents_' || c.collection_id)::regclass
WHERE database_name IN ('collated_creation_dist','collated_creation_native_dist')
    AND collection_name IN ('legacy','native')
ORDER BY collection_name;
 collection_name | partmethod | logical_indexes 
---------------------------------------------------------------------
 legacy          | h          |               1
 native          | n          |               1
(2 rows)

-- Both placement modes enforce case and accent equivalence, including hinted matches.
