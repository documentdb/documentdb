    'collation_aggregate_dist_db',
    '{ "aggregate": "source", "pipeline": [
        { "$match": { "category": "cafe" } },
        { "$sort": { "rank": 1 } },
        { "$project": { "_id": 1, "category": 1, "rank": 1 } }
    ] }')
$cmd$, p_ignore_distributed_subplan_ids => true) AS plan(query_plan);
