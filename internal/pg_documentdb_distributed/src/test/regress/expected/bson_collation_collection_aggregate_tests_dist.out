        { "$match": { "category": "cafe" } },
        { "$sort": { "rank": 1 } },
        { "$project": { "_id": 1, "category": 1, "rank": 1 } }
    ] }');
                                document                                
---------------------------------------------------------------------
 { "_id" : { "$numberInt" : "1" }, "category" : "cafe", "rank" : "10" }
