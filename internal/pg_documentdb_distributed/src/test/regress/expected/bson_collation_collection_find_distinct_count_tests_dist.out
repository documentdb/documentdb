-- An explicit simple collation remains binary across shards.
SELECT document FROM documentdb_api.count_query(
    'collation_default_dist_db',
    '{ "count": "default_match", "query": { "value": "cafe" }, "collation": { "locale": "simple" } }');
                               document                               
