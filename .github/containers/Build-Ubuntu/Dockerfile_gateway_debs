# Gateway runtime image based on Debian bookworm using DocumentDB apt repository
ARG POSTGRES_VERSION=16
ARG BASE_ARCH=AMD64
ARG GATEWAY_DEB_URL=""

FROM debian:bookworm-slim AS builder

ARG POSTGRES_VERSION
ARG BASE_ARCH
ARG GATEWAY_DEB_URL
ARG DEBIAN_FRONTEND=noninteractive

# Base tooling and PostgreSQL stack shared by the emulator entrypoint
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        jq \
        locales \
        openssl \
        lsof \
        sudo \
        gnupg; \
    echo "en_US.UTF-8 UTF-8" > /etc/locale.gen; \
    locale-gen; \
    install -d -m 0755 /etc/apt/keyrings; \
    curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc -o /etc/apt/keyrings/pgdg.asc; \
    echo "deb [signed-by=/etc/apt/keyrings/pgdg.asc] http://apt.postgresql.org/pub/repos/apt bookworm-pgdg main ${POSTGRES_VERSION}" > /etc/apt/sources.list.d/pgdg.list; \
    ARCH_LOWER=$(echo "${BASE_ARCH}" | tr 'A-Z' 'a-z'); \
    curl -fsSL https://documentdb.io/documentdb-archive-keyring.gpg | gpg --dearmor -o /usr/share/keyrings/documentdb-archive-keyring.gpg; \
    echo "deb [arch=${ARCH_LOWER} signed-by=/usr/share/keyrings/documentdb-archive-keyring.gpg] https://documentdb.io/deb stable main" > /etc/apt/sources.list.d/documentdb.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        postgresql-${POSTGRES_VERSION} \
        postgresql-${POSTGRES_VERSION}-cron \
        postgresql-${POSTGRES_VERSION}-pgvector \
        postgresql-${POSTGRES_VERSION}-postgis-3 \
        postgresql-${POSTGRES_VERSION}-rum \
        postgresql-${POSTGRES_VERSION}-documentdb; \
    rm -rf /var/lib/apt/lists/*

# Install gateway package from a provided .deb URL (repo does not publish this package)
RUN set -eux; \
    if [ -z "${GATEWAY_DEB_URL}" ]; then \
        echo "GATEWAY_DEB_URL must be provided to install documentdb-gateway" >&2; \
        exit 1; \
    fi; \
    curl -fsSL "${GATEWAY_DEB_URL}" -o /tmp/documentdb-gateway.deb; \
    if ! dpkg -i /tmp/documentdb-gateway.deb; then \
        apt-get update; \
        apt-get -f install -y --no-install-recommends; \
    fi; \
    rm -f /tmp/documentdb-gateway.deb; \
    rm -rf /var/lib/apt/lists/*

# Create application user used by the entrypoint and allow passwordless sudo for script compatibility
RUN useradd -ms /bin/bash documentdb \
    && usermod -aG sudo documentdb \
    && mkdir -p /etc/sudoers.d \
    && echo "documentdb ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/documentdb \
    && chmod 440 /etc/sudoers.d/documentdb

# Layout expected by the existing scripts
RUN mkdir -p /home/documentdb/gateway/scripts \
    && mkdir -p /home/documentdb/gateway/pg_documentdb_gw/target/release-with-symbols

COPY scripts/emulator_entrypoint.sh /home/documentdb/gateway/scripts/
COPY scripts/build_and_start_gateway.sh /home/documentdb/gateway/scripts/
COPY scripts/start_oss_server.sh /home/documentdb/gateway/scripts/
COPY scripts/utils.sh /home/documentdb/gateway/scripts/
COPY scripts/setup_psqlrc.sh /home/documentdb/gateway/scripts/
COPY pg_documentdb_gw/SetupConfiguration.json /home/documentdb/gateway/pg_documentdb_gw/SetupConfiguration.json

# Symlink installed gateway binary into the location scripts already use and fix ownership
RUN ln -sf /usr/bin/documentdb_gateway /home/documentdb/gateway/pg_documentdb_gw/target/release-with-symbols/documentdb_gateway \
    && chown -R documentdb:documentdb /home/documentdb/gateway

FROM debian:bookworm-slim AS runtime

ARG POSTGRES_VERSION

COPY --from=builder / /

RUN set -eux; \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/*; \
    find /usr/share/doc -mindepth 1 -maxdepth 1 -type f -delete; \
    find /usr/share/doc -mindepth 1 -maxdepth 1 -type d -exec rm -rf {} +; \
    rm -rf /usr/share/man/*; \
    find /usr/share/locale -mindepth 1 -maxdepth 1 -type d ! -name 'en_US' -exec rm -rf {} +; \
    rm -rf /usr/lib/postgresql/${POSTGRES_VERSION}/lib/postgresql/bitcode*

USER documentdb
WORKDIR /home/documentdb/gateway/scripts

ENV LANGUAGE=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    TERM=xterm-256color \
    CERT_PATH="" \
    KEY_FILE="" \
    DATA_PATH="/data" \
    DOCUMENTDB_PORT="10260" \
    ENABLE_TELEMETRY="false" \
    LOG_LEVEL="info" \
    USERNAME="default_user" \
    CREATE_USER="true" \
    START_POSTGRESQL="true" \
    POSTGRESQL_PORT="9712" \
    OWNER="documentdb" \
    PG_VERSION_USED="${POSTGRES_VERSION}" \
    ALLOW_EXTERNAL_CONNECTIONS="false" \
    PATH=/usr/lib/postgresql/${POSTGRES_VERSION}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

ENTRYPOINT ["/bin/bash", "-c", "/home/documentdb/gateway/scripts/emulator_entrypoint.sh \"$@\"", "--"]