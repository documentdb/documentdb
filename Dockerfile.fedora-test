FROM fedora:42

# Native Fedora PostgreSQL — no external repos needed
# F42 = PG 16, F43/Rawhide = PG 18

# 1. Enable the Copr repo and install DocumentDB meta-package.
#    documentdb-server pulls in: postgresql-server, pgvector, postgis,
#    documentdb (with bundled pg_cron), and documentdb-gateway.
RUN dnf install -y 'dnf-command(copr)' && \
    dnf copr enable -y xgerman/DocumentDB && \
    dnf install -y documentdb-server postgresql-contrib

# 2. Add MongoDB repo and install mongosh (for gateway smoke test)
RUN echo -e "[mongodb-org-8.0]\nname=MongoDB Repository\nbaseurl=https://repo.mongodb.org/yum/redhat/9/mongodb-org/8.0/\$basearch/\ngpgcheck=1\nenabled=1\ngpgkey=https://pgp.mongodb.com/server-8.0.asc" \
    > /etc/yum.repos.d/mongodb-org-8.0.repo && \
    dnf install -y mongodb-mongosh

# 3. Locale + openssl CLI (needed for gateway self-signed cert generation)
RUN dnf install -y glibc-langpack-en openssl && \
    localedef -i en_US -f UTF-8 en_US.UTF-8 || true
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# 4. Ensure the PG unix socket directory exists
RUN mkdir -p /var/run/postgresql && chown postgres:postgres /var/run/postgresql

# 5. Smoke test: start PG, create extensions, then verify via mongosh through the gateway
#    Native Fedora PG uses /var/lib/pgsql/data (no version in path)
RUN adduser --system --home-dir /var/lib/pgsql postgres 2>/dev/null || true
USER postgres
RUN initdb -D /var/lib/pgsql/data && \
    { echo "shared_preload_libraries = 'pg_documentdb_core,pg_cron,pg_documentdb'"; \
      echo "cron.database_name = 'postgres'"; \
      echo "logging_collector = off"; \
      echo "# F42 = PG 16: default RUM load option expects standalone rum.so (not in Fedora)."; \
      echo "# Use bundled documentdb_extended_rum_core instead."; \
      echo "documentdb.rum_library_load_option = 'require_documentdb_extended_rum'"; \
    } >> /var/lib/pgsql/data/postgresql.conf && \
    pg_ctl -D /var/lib/pgsql/data start && \
    psql -c "CREATE EXTENSION documentdb_core CASCADE;" && \
    psql -c "CREATE EXTENSION documentdb CASCADE;" && \
    psql -c "CREATE ROLE testuser WITH LOGIN INHERIT PASSWORD 'testpass' IN ROLE documentdb_readonly_role;" && \
    psql -c "GRANT documentdb_admin_role TO testuser WITH ADMIN OPTION;" && \
    echo '{"NodeHostName":"localhost","BlockedRolePrefixes":["documentdb","citus","pg","internal_role"],"PostgresPort":5432,"GatewayListenPort":10260,"HostConfigurationWatchIntervalMs":1000,"CertificateOptions":{"CertType":"PemAutoGenerated"},"UseLocalHost":false}' > /tmp/gw_config.json && \
    cd /tmp && documentdb_gateway /tmp/gw_config.json & \
    sleep 5 && \
    mongosh --port 10260 --tls --tlsAllowInvalidCertificates \
      -u testuser -p testpass --authenticationDatabase admin --eval " \
      db.test.insertOne({hello: 'world'}); \
      const doc = db.test.findOne({hello: 'world'}); \
      assert(doc !== null, 'Document not found'); \
      print('SUCCESS: mongosh smoke test passed'); \
    " && \
    kill %1 2>/dev/null; \
    pg_ctl -D /var/lib/pgsql/data stop
