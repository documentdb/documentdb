{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "documentdb", "integrations"],
  "properties": {
    "schema_version": {"const": 1},
    "documentdb": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["image", "postgres_major", "extension_version"],
        "properties": {
          "image": {"type": "string", "pattern": "^ghcr\\.io/documentdb/documentdb/documentdb-local@sha256:[a-f0-9]{64}$"},
          "postgres_major": {"type": "integer", "minimum": 15, "maximum": 18},
          "extension_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+-[0-9]+$"}
        }
      }
    },
    "integrations": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,39}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "owner", "enabled", "package", "default_version", "version_pattern", "profile", "test_file", "demonstration_file", "timeout_seconds", "freshness_days", "expected_tests"],
        "properties": {
          "repository": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
          "owner": {"type": "string", "pattern": "^@[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
          "enabled": {"type": "boolean"},
          "package": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"},
          "default_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "version_pattern": {"type": "string", "minLength": 1, "maxLength": 100},
          "profile": {"type": "string", "pattern": "^[a-z0-9_-]{1,80}$"},
          "test_file": {"type": "string", "pattern": "^compatibility/integrations/[a-z0-9_]+/test_[a-z0-9_]+\\.py$"},
          "demonstration_file": {"type": "string", "pattern": "^compatibility/integrations/[a-z0-9_]+/test_[a-z0-9_]+\\.py$"},
          "timeout_seconds": {"type": "integer", "minimum": 30, "maximum": 1800},
          "freshness_days": {"type": "integer", "minimum": 1, "maximum": 90},
          "expected_tests": {
            "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^test_[a-z0-9_]+$"}
          }
        }
      }
    }
  }
}
